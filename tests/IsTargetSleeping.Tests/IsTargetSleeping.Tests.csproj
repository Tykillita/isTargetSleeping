<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sin frameworks de pruebas: compila la lógica pura junto a un pequeño banco. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\IsTargetSleeping\Core\Activity.cs" Link="Core\Activity.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\Processes.cs" Link="Core\Processes.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\Win32.cs" Link="Core\Win32.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\MemoryBreakdown.cs" Link="Core\MemoryBreakdown.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\Watchdog.cs" Link="Core\Watchdog.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\Games.cs" Link="Core\Games.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\Clients.cs" Link="Core\Clients.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\Stats.cs" Link="Core\Stats.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\Links.cs" Link="Core\Links.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\Updater.cs" Link="Core\Updater.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\UpdateInstaller.cs" Link="Core\UpdateInstaller.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\OllamaApi.cs" Link="Core\OllamaApi.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\L10n.cs" Link="Core\L10n.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\Paths.cs" Link="Core\Paths.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\CleanSpec.cs" Link="Core\CleanSpec.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\CleanRules.cs" Link="Core\CleanRules.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\MemoryContracts.cs" Link="Core\MemoryContracts.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\ProcessContracts.cs" Link="Core\ProcessContracts.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\ProcessMonitoring.cs" Link="Core\ProcessMonitoring.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\ProcessActions.cs" Link="Core\ProcessActions.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\TrayMotion.cs" Link="Core\TrayMotion.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\TrayPin.cs" Link="Core\TrayPin.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\PetBrain.cs" Link="Core\PetBrain.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\PetAnimationProfile.cs" Link="Core\PetAnimationProfile.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\PetProfiles\*.cs" Link="Core\PetProfiles\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\CursorPounce.cs" Link="Core\CursorPounce.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\UI\Pets\*.cs"
             Exclude="..\..\src\IsTargetSleeping\UI\Pets\WindowsLogo.cs;..\..\src\IsTargetSleeping\UI\Pets\PetPreview.cs"
             Link="Pets\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\PetMotion.cs" Link="Core\PetMotion.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\PetPose.cs" Link="Core\PetPose.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\PetKeyframes.cs" Link="Core\PetKeyframes.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\PetIdle.cs" Link="Core\PetIdle.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\PetParticles.cs" Link="Core\PetParticles.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\PetDirector.cs" Link="Core\PetDirector.cs" />
    <Compile Include="..\..\src\IsTargetSleeping\Core\TaskbarPetLayout.cs" Link="Core\TaskbarPetLayout.cs" />
  </ItemGroup>

  <Target Name="PublishUpdateProbe" AfterTargets="Build">
    <MSBuild Projects="..\UpdateProbe\UpdateProbe.csproj" Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(TargetDir)probe\" />
  </Target>
</Project>
