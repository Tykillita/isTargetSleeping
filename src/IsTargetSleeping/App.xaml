<Application x:Class="IsTargetSleeping.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:IsTargetSleeping.UI"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Tipografía: Segoe UI Variable y Cascadia Mono, las fuentes de Windows 11. -->
        <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <CornerRadius x:Key="Radius">12</CornerRadius>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- Los colores (Bg, Card, Line, Accent…) los publica Theme.Apply. -->

        <!-- Tarjeta de vidrio: brillo que baja de arriba abajo y borde de luz. -->
        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="WidgetFoldersCardBox" TargetType="Border" BasedOn="{StaticResource CardBox}">
            <Setter Property="Background" Value="{DynamicResource WidgetFoldersCardFill}" />
        </Style>

        <!-- Un widget del Home: sin tarjeta, sin relleno ni borde, directamente sobre el cristal del notch (como los de Droppy); su tamaño lo da la cuadrícula del Home. Lo que dentro
             tenga que verse como relieve (un botón, una fila de la agenda) lleva su propio cristal. -->
        <Style x:Key="WidgetBox" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Fill" Value="{DynamicResource Line}" />
            <Setter Property="Height" Value="1" />
        </Style>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
        </Style>
        <!-- Título e icono de la cabecera de un widget: en la vista al pasar el ratón con un solo widget no salen (la página ya dice cuál es) -->
        <Style x:Key="HeadTitle" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Style.Triggers><DataTrigger Binding="{Binding Bare}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="HeadGlyph" TargetType="TextBlock">
            <Style.Triggers><DataTrigger Binding="{Binding Bare}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MonoSmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <!-- Anillo de foco de teclado (Tab): visible en todos los botones e interruptores. -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="1.5" CornerRadius="7" Margin="-2" BorderBrush="{DynamicResource Accent}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón sin adornos. -->
        <Style x:Key="Plain" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />   <!-- sin esto, el icono de un botón sin color propio sale negro (el de Windows) -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ui:BrandSwitch" BasedOn="{StaticResource Plain}" />

        <!-- Botón gris pequeño. -->
        <Style x:Key="Bordered" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TeleprompterAction" TargetType="Button" BasedOn="{StaticResource Plain}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tile" Property="Background" Value="{DynamicResource ButtonHover}" />
                                <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource GlassRim}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="tile" Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="tile" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- «Cargar»: el mismo botón teñido con el acento. -->
        <Style x:Key="Tinted" TargetType="Button" BasedOn="{StaticResource Bordered}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <!-- «Sí»: relleno con el acento. -->
        <Style x:Key="Prominent" TargetType="Button" BasedOn="{StaticResource Bordered}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- «Borrar»: el mismo botón en coral, solo para lo que no se deshace. -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource Bordered}">
            <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>

        <!-- Campo de texto de vidrio. -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Track}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Muted}" />
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="box" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource Line}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Muted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menú desplegable de vidrio: evita que la plantilla del sistema pinte controles blancos sobre el notch. -->
        <Style x:Key="GlassComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Track}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GlassComboBoxText">
            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DataTemplate>

        <Style x:Key="GlassComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Track}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,3,24,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource GlassComboBoxItem}" />
            <Setter Property="ItemTemplate" Value="{StaticResource GlassComboBoxText}" />
            <Setter Property="MaxDropDownHeight" Value="160" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
                            <ToggleButton Focusable="False" ClickMode="Press" HorizontalAlignment="Right" Width="26" Margin="1" Background="Transparent"
                                          AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="arrow" Background="Transparent" CornerRadius="6">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="8.5"
                                                       Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="arrow" Property="Background" Value="{DynamicResource CardFill}" /></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="arrow" Property="Opacity" Value="0.7" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Grid x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource CardStroke}"
                                            BorderThickness="1" CornerRadius="8" Padding="3">
                                        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.4" /></Border.Effect>
                                    </Border>
                                    <ScrollViewer Margin="3" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Muted}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="box" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selector segmentado con la marca. -->
        <DataTemplate x:Key="SegmentTemplate" DataType="{x:Type ui:Segment}">
            <Button Command="{Binding Pick}" Style="{StaticResource Plain}" AutomationProperties.Name="{Binding Title}">
                <Border x:Name="pill" CornerRadius="6" Padding="4,6" Background="Transparent">
                    <TextBlock x:Name="text" Text="{Binding Title}" FontFamily="{StaticResource Sans}" FontSize="11.5"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Secondary}" />
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource Accent}" />
                    <Setter TargetName="text" Property="Foreground" Value="{DynamicResource OnAccent}" />
                    <Setter TargetName="text" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="Segmented" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource SegmentTemplate}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <Border Background="{DynamicResource Track}" CornerRadius="8" Padding="2">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Track}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,0,6,1" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Barra de desplazamiento fina para la lista de modelos. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4,2,4">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Muted}" CornerRadius="2" Width="4" Opacity="0.6" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PopupBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8,5">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menú del clic derecho en la bandeja, con los colores de la marca. -->
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                                CornerRadius="10" Padding="4" MinWidth="220" Margin="0,0,10,10">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Opacity="0.6" Direction="270" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,5,10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}" Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False" />
                                    <TextBlock x:Name="gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0"
                                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="arrow" Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10"
                                               Margin="24,0,0,0" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <!-- Submenú (p. ej., «Cargar al encender»), con el mismo vidrio que el menú. -->
                            <Popup x:Name="sub" Placement="Right" HorizontalOffset="2" VerticalOffset="-5" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="None"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                                        CornerRadius="10" Padding="4" MinWidth="180" Margin="0,0,10,10"
                                        TextElement.FontFamily="{StaticResource Sans}" TextElement.FontSize="12.5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Opacity="0.6" Direction="270" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="gesture" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Track}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Fill="{DynamicResource Line}" Height="1" Margin="6,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <!-- MARK: widgets. Cada tipo tiene su plantilla y la ranura (WidgetSlot) decide la variante: una o dos celdas
         (si hay compañero en la fila o se queda solo), y Home o vista al pasar el ratón (más denso). -->
    <ui:WidgetTemplateSelector x:Key="WidgetSelector" />
    <DataTemplate DataType="{x:Type ui:WidgetSlot}">
      <Grid AllowDrop="True" DragOver="OnWidgetRowDragOver" Drop="OnWidgetHomeDrop">
        <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource WidgetSelector}" IsTabStop="False" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <Thumb Width="18" Height="56" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center"
               Cursor="SizeWE" Visibility="{Binding ResizeHandleVisible, Converter={StaticResource Visible}}"
               AutomationProperties.Name="{Binding ResizeHelp}" ToolTip="{Binding ResizeHelp}"
               DragStarted="OnWidgetResizeDragStarted" DragDelta="OnWidgetResizeDragDelta" DragCompleted="OnWidgetResizeDragCompleted">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
              <Border Background="Transparent" CornerRadius="7">
                <Border Width="3" Height="24" CornerRadius="2" Background="{DynamicResource Secondary}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Thumb.Template>
        </Thumb>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="WidgetHeader">
      <DockPanel x:Name="head" Margin="0,0,0,8">
        <TextBlock DockPanel.Dock="Left" Text="{Binding Model.Glyph}" Style="{StaticResource HeadGlyph}" FontFamily="{StaticResource Icons}" FontSize="12"
                   Foreground="{DynamicResource Secondary}" Margin="0,1,7,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Model.Title}" Style="{StaticResource HeadTitle}" VerticalAlignment="Center" />
      </DockPanel>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Bare}" Value="True"><Setter TargetName="head" Property="Visibility" Value="Collapsed" /></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ Ollama, LM Studio y el lanzador de modelos ============ -->
    <!-- Un anillo de uso con el porcentaje dentro y, debajo, su nombre y lo que va usado -->
    <DataTemplate x:Key="EngineRing">
      <StackPanel Width="92">
        <Grid Width="52" Height="52" HorizontalAlignment="Center">
          <ui:ArcGauge Progress="{Binding Fraction}" Alert="{Binding Alert}" />
          <TextBlock Text="{Binding Percent}" Style="{StaticResource MonoSmall}" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Eyebrow}" FontSize="10.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
        <TextBlock Text="{Binding Value}" Style="{StaticResource MonoSmall}" FontSize="9.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>

    <!-- La píldora de estado de la cabecera: un punto del color del estado y su texto -->
    <DataTemplate x:Key="EngineStatePill">
      <Border Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="8,2,9,3" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="{Binding Dot}" Margin="0,1,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Title}" FontSize="10.5" Foreground="{DynamicResource Secondary}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Un modelo instalado como píldora: el cargado va resaltado y un toque lo carga -->
    <DataTemplate x:Key="OllamaModelChip">
      <Button Style="{StaticResource Plain}" Command="{Binding Load}" IsEnabled="{Binding ChipEnabled}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding LoadHelp}" Margin="0,0,6,6">
        <Border x:Name="chip" CornerRadius="11" Padding="9,4,11,5" Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource Muted}" Margin="0,1,6,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
          </StackPanel>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsLoaded}" Value="True">
          <Setter TargetName="chip" Property="Background" Value="{DynamicResource OnSoft}" />
          <Setter TargetName="dot" Property="Fill" Value="{DynamicResource On}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Ollama: 1×1 conserva encendido, estado, RAM y liberación; las vistas anchas añaden el panel completo. -->
    <DataTemplate x:Key="WidgetOllamaWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid DataContext="{Binding Model.Panel}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <!-- Cabecera: la marca, la versión y el estado -->
          <DockPanel x:Name="fullHeader" Margin="0,0,0,8">
            <ContentControl DockPanel.Dock="Right" Content="{Binding StatePill}" ContentTemplate="{StaticResource EngineStatePill}" Focusable="False" />
            <TextBlock DockPanel.Dock="Left" Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" Margin="0,1,7,0" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Left" Text="Ollama" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding OllamaSectionDetail}" Style="{StaticResource Hint}" FontSize="10" Margin="8,2,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <Grid x:Name="fullBody" Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Plain}" Command="{Binding TogglePower}" AutomationProperties.Name="{Binding HeroHelp}"
                    IsEnabled="{Binding CanToggle}" ToolTip="{Binding HeroHelp}" Width="64" Height="64" VerticalAlignment="Center" Margin="0,0,2,0">
              <Grid Width="64" Height="64">
                <Ellipse Width="58" Height="58" Fill="{Binding HeroFill}" Stroke="{Binding HeroTint}" StrokeThickness="2.2" />
                <Path Data="{Binding HeroIcon}" Stroke="{Binding HeroTint}" StrokeThickness="2.5" Width="22" Height="22" Stretch="Uniform"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <!-- El modelo en memoria, en grande, y cuánto lleva ahí -->
            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding NotchModel}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding HeroTitleBrush}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding IdleLine}" Style="{StaticResource Hint}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="0,3,0,0" Visibility="{Binding HasLoaded, Converter={StaticResource Visible}}" />
              <TextBlock Text="{Binding HeroDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" Margin="0,3,0,0" Visibility="{Binding NoLoaded, Converter={StaticResource Visible}}" />
            </StackPanel>
            <!-- Memoria y GPU como anillos -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
              <ContentControl Content="{Binding RamRing}" ContentTemplate="{StaticResource EngineRing}" Focusable="False" />
              <ContentControl Content="{Binding GpuRing}" ContentTemplate="{StaticResource EngineRing}" Focusable="False" Visibility="{Binding ShowGpu, Converter={StaticResource Visible}}" />
            </StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Width="150" Margin="6,0,0,0">
              <!-- Los botones no desaparecen mientras trabajan: si no, los de al lado saltan de sitio. -->
              <Button Style="{StaticResource Bordered}" Command="{Binding CleanNow}" AutomationProperties.Name="{Binding CleanLabel}" ToolTip="{Binding CleanHelp}" IsEnabled="{Binding CleanIdle}" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xEA99;" FontFamily="{StaticResource Icons}" FontSize="11.5" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CleanButtonText}" Margin="6,0,0,0" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Bordered}" Command="{Binding FreeModel}" AutomationProperties.Name="{Binding FreeModelLabel}" ToolTip="{Binding FreeHelp}" IsEnabled="{Binding FreeCanClick}" Margin="0,0,0,6">
                <TextBlock Text="{Binding FreeButtonText}" />
              </Button>
              <Button Style="{StaticResource Bordered}" Command="{Binding OpenProcesses}" AutomationProperties.Name="{Binding OpenProcessesLabel}">
                <TextBlock Text="{Binding OpenProcessesLabel}" />
              </Button>
            </StackPanel>
          </Grid>
          <!-- Dos filas: los modelos instalados, para cargar uno con un toque -->
          <StackPanel x:Name="fullDetails" Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding DataContext.Tall, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding InstalledTitle}" Style="{StaticResource Eyebrow}" FontSize="10.5" Margin="0,0,0,7" />
            <ItemsControl ItemsSource="{Binding ChipModels}" ItemTemplate="{StaticResource OllamaModelChip}" Focusable="False" Visibility="{Binding HasChipModels, Converter={StaticResource Visible}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="{Binding InstalledEmpty}" Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding NoChipModels, Converter={StaticResource Visible}}" />
            <!-- La siesta automática: cuánto falta para que se libere el modelo -->
            <Border Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="12,9,12,10" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="{Binding AutoFreeTitle}" Style="{StaticResource Eyebrow}" FontSize="10.5" />
                <ui:UsageBar Height="5" Margin="0,8,0,6" Used="{Binding IdleFraction}" Visibility="{Binding HasIdleBar, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding MemoryNote}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding NoLoaded, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding IdleLine}" Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding HasLoaded, Converter={StaticResource Visible}}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Grid x:Name="compactLayout" Grid.RowSpan="3" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <!-- Sin título en la vista corta con un solo widget (Bare) -->
            <DockPanel Margin="0,0,0,4" Visibility="{Binding DataContext.NotBare, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource Visible}}">
              <ContentControl DockPanel.Dock="Right" Content="{Binding StatePill}" ContentTemplate="{StaticResource EngineStatePill}" Focusable="False" />
              <TextBlock DockPanel.Dock="Left" Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" Margin="0,1,7,0" VerticalAlignment="Center" />
              <TextBlock Text="Ollama" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Button Style="{StaticResource Plain}" Command="{Binding TogglePower}" AutomationProperties.Name="{Binding HeroHelp}" IsEnabled="{Binding CanToggle}"
                      ToolTip="{Binding HeroHelp}" Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,5,0">
                <Grid Width="48" Height="48">
                  <Ellipse Width="43" Height="43" Fill="{Binding HeroFill}" Stroke="{Binding HeroTint}" StrokeThickness="2" />
                  <Path Data="{Binding HeroIcon}" Stroke="{Binding HeroTint}" StrokeThickness="2.5" Width="19" Height="19" Stretch="Uniform"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,5,0">
                <TextBlock Text="{Binding NotchModel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding HeroTitleBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding IdleLine}" Style="{StaticResource Hint}" FontSize="10" TextTrimming="CharacterEllipsis" MaxHeight="26" Margin="0,2,0,0" Visibility="{Binding HasLoaded, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding HeroDetail}" Style="{StaticResource Hint}" FontSize="10" TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="0,2,0,0" Visibility="{Binding NoLoaded, Converter={StaticResource Visible}}" />
              </StackPanel>
              <Grid Grid.Column="2" Width="44" Height="44" ToolTip="{Binding UsedLabel}" AutomationProperties.Name="{Binding RamRing.Title}">
                <ui:ArcGauge Progress="{Binding UsedFraction}" Alert="{Binding RamRing.Alert}" />
                <TextBlock Text="{Binding RamRing.Percent}" Style="{StaticResource MonoSmall}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Button Style="{StaticResource Bordered}" Command="{Binding CleanNow}" AutomationProperties.Name="{Binding CleanLabel}" ToolTip="{Binding CleanHelp}"
                      IsEnabled="{Binding CleanIdle}" Margin="0,0,4,0" FontSize="10.5" Padding="5,3">
                <TextBlock Text="{Binding CleanButtonText}" TextTrimming="CharacterEllipsis" />
              </Button>
              <Button Grid.Column="1" Style="{StaticResource Bordered}" Command="{Binding FreeModel}" AutomationProperties.Name="{Binding FreeModelLabel}" ToolTip="{Binding FreeHelp}"
                      IsEnabled="{Binding FreeCanClick}" Margin="4,0,0,0" FontSize="10.5" Padding="5,3">
                <TextBlock Text="{Binding FreeButtonText}" TextTrimming="CharacterEllipsis" />
              </Button>
            </Grid>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Compact}" Value="True">
          <Setter TargetName="fullHeader" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="fullBody" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="fullDetails" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="compactLayout" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Una fila del lanzador (y de LM Studio): reproducir/parar, el nombre y su detalle -->
    <DataTemplate x:Key="LaunchRowLine">
      <Button Style="{StaticResource Plain}" Command="{Binding Run}" IsEnabled="{Binding CanRun}" AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding Help}" Margin="0,0,0,4" HorizontalContentAlignment="Stretch">
        <Border x:Name="row" CornerRadius="10" Padding="8,5,10,5" Background="{DynamicResource Track}" Opacity="{Binding Opacity}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Secondary}" Width="18" VerticalAlignment="Center" />
            <TextBlock x:Name="name" Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Meta}" Style="{StaticResource MonoSmall}" FontSize="9.5" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="100" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Loaded}" Value="True">
          <Setter TargetName="row" Property="Background" Value="{DynamicResource OnSoft}" />
          <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource On}" />
          <Setter TargetName="name" Property="Foreground" Value="{DynamicResource Fg}" />
          <Setter TargetName="name" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- La misma fila sin detalle, para una celda estrecha -->
    <DataTemplate x:Key="LaunchRowTight">
      <Button Style="{StaticResource Plain}" Command="{Binding Run}" IsEnabled="{Binding CanRun}" AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding Help}" Margin="0,0,0,4" HorizontalContentAlignment="Stretch">
        <Border x:Name="row" CornerRadius="10" Padding="8,4,10,4" Background="{DynamicResource Track}" Opacity="{Binding Opacity}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Secondary}" Width="18" VerticalAlignment="Center" />
            <TextBlock x:Name="name" Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Loaded}" Value="True">
          <Setter TargetName="row" Property="Background" Value="{DynamicResource OnSoft}" />
          <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource On}" />
          <Setter TargetName="name" Property="Foreground" Value="{DynamicResource Fg}" />
          <Setter TargetName="name" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Un modelo de LM Studio como píldora (igual que las de Ollama): el cargado va resaltado y un toque lo carga o lo descarga -->
    <DataTemplate x:Key="LaunchModelChip">
      <Button Style="{StaticResource Plain}" Command="{Binding Run}" IsEnabled="{Binding CanRun}" AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding Help}" Margin="0,0,6,6">
        <Border x:Name="chip" CornerRadius="11" Padding="9,4,11,5" Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource Muted}" Margin="0,1,6,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
          </StackPanel>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Loaded}" Value="True">
          <Setter TargetName="chip" Property="Background" Value="{DynamicResource OnSoft}" />
          <Setter TargetName="dot" Property="Fill" Value="{DynamicResource On}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- LM Studio: el mismo diseño que Ollama (botón de encendido, modelo en memoria, anillos de memoria y GPU, acciones y, en dos filas, los modelos y la siesta) -->
    <DataTemplate x:Key="WidgetLmStudioWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <DockPanel x:Name="fullHeader" Margin="0,0,0,8">
            <Border DockPanel.Dock="Right" Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="8,2,9,3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{Binding Model.Dot}" Margin="0,1,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Model.StateTitle}" FontSize="10.5" Foreground="{DynamicResource Secondary}" />
              </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Model.Glyph}" Style="{StaticResource HeadGlyph}" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" Margin="0,1,7,0" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding Model.Title}" Style="{StaticResource HeadTitle}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Model.Port}" Style="{StaticResource Hint}" FontSize="10" Margin="8,2,0,0" VerticalAlignment="Center" Visibility="{Binding Model.Installed, Converter={StaticResource Visible}}" />
          </DockPanel>
          <!-- Sin LM Studio -->
          <StackPanel x:Name="fullMissing" Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding Model.NotInstalled, Converter={StaticResource Visible}}" VerticalAlignment="Center">
            <TextBlock Text="{Binding Model.StateTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
            <TextBlock Text="{Binding Model.Hint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
          <Grid x:Name="fullBody" Grid.Row="1" Visibility="{Binding Model.Installed, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Plain}" Command="{Binding Model.ToggleCommand}" AutomationProperties.Name="{Binding Model.HeroHelp}"
                    IsEnabled="{Binding Model.CanToggle}" ToolTip="{Binding Model.HeroHelp}" Width="64" Height="64" VerticalAlignment="Center" Margin="0,0,2,0">
              <Grid Width="64" Height="64">
                <Ellipse x:Name="halo" Width="58" Height="58" Fill="{DynamicResource Track}" Stroke="{DynamicResource Muted}" StrokeThickness="2.2" />
                <Path x:Name="bolt" Data="M 5.1,5.2 A 8,8 0 1 0 14.9,5.2 M 10,2 V 10.5" Stroke="{DynamicResource Muted}" StrokeThickness="2.5" Width="22" Height="22" Stretch="Uniform"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <!-- El modelo en memoria, en grande, y cuánto lleva ahí -->
            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Model.ModelText}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Model.DetailLine}" Style="{StaticResource Hint}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="0,3,0,0" />
              <TextBlock Text="{Binding Model.Error}" FontSize="10" Foreground="{DynamicResource Danger}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Visibility="{Binding Model.HasError, Converter={StaticResource Visible}}" />
            </StackPanel>
            <!-- Memoria y GPU como anillos (la memoria del PC: LM Studio corre en la misma máquina) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
              <ContentControl Content="{Binding Model.Panel.RamRing}" ContentTemplate="{StaticResource EngineRing}" Focusable="False" />
              <ContentControl Content="{Binding Model.Panel.GpuRing}" ContentTemplate="{StaticResource EngineRing}" Focusable="False" Visibility="{Binding Model.Panel.ShowGpu, Converter={StaticResource Visible}}" />
            </StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Width="150" Margin="6,0,0,0">
              <Button Style="{StaticResource Bordered}" Command="{Binding Model.Panel.CleanNow}" AutomationProperties.Name="{Binding Model.Panel.CleanLabel}" ToolTip="{Binding Model.Panel.CleanHelp}" IsEnabled="{Binding Model.Panel.CleanIdle}" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xEA99;" FontFamily="{StaticResource Icons}" FontSize="11.5" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Model.Panel.CleanButtonText}" Margin="6,0,0,0" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Bordered}" Command="{Binding Model.UnloadCommand}" IsEnabled="{Binding Model.CanUnload}" AutomationProperties.Name="{Binding Model.UnloadLabel}" ToolTip="{Binding Model.UnloadHelp}" Margin="0,0,0,6">
                <TextBlock Text="{Binding Model.UnloadLabel}" />
              </Button>
              <Button Style="{StaticResource Bordered}" Command="{Binding Model.Panel.OpenProcesses}" AutomationProperties.Name="{Binding Model.Panel.OpenProcessesLabel}">
                <TextBlock Text="{Binding Model.Panel.OpenProcessesLabel}" />
              </Button>
            </StackPanel>
          </Grid>
          <!-- Dos filas: los modelos descargados, para cargar uno con un toque, y la cuenta atrás de la siesta -->
          <StackPanel x:Name="fullDetails" Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding Tall, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Model.RowsTitle}" Style="{StaticResource Eyebrow}" FontSize="10.5" Margin="0,0,0,7" Visibility="{Binding Model.Installed, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding Model.Top6}" ItemTemplate="{StaticResource LaunchModelChip}" Focusable="False" Visibility="{Binding Model.HasRows, Converter={StaticResource Visible}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="{Binding Model.RowsEmpty}" Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding Model.NoRows, Converter={StaticResource Visible}}" />
            <Border Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="12,9,12,10" Margin="0,8,0,0" Visibility="{Binding Model.Installed, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="{Binding Model.AutoFreeTitle}" Style="{StaticResource Eyebrow}" FontSize="10.5" />
                <ui:UsageBar Height="5" Margin="0,8,0,6" Used="{Binding Model.IdleFraction}" Visibility="{Binding Model.HasIdle, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding Model.IdleNote}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Grid x:Name="compactLayout" Grid.RowSpan="3" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,4">
              <Border DockPanel.Dock="Right" Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="7,2,8,3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="{Binding Model.Dot}" Margin="0,1,5,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Model.StateTitle}" FontSize="10" Foreground="{DynamicResource Secondary}" />
                </StackPanel>
              </Border>
              <TextBlock DockPanel.Dock="Left" Text="{Binding Model.Glyph}" Style="{StaticResource HeadGlyph}" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" Margin="0,1,7,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Model.Title}" Style="{StaticResource HeadTitle}" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Grid Visibility="{Binding Model.Installed, Converter={StaticResource Visible}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Button Style="{StaticResource Plain}" Command="{Binding Model.ToggleCommand}" AutomationProperties.Name="{Binding Model.HeroHelp}" IsEnabled="{Binding Model.CanToggle}"
                      ToolTip="{Binding Model.HeroHelp}" Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,5,0">
                <Grid Width="48" Height="48">
                  <Ellipse Width="43" Height="43" Fill="{DynamicResource Track}" Stroke="{Binding Model.Dot}" StrokeThickness="2" />
                  <Path Data="M 5.1,5.2 A 8,8 0 1 0 14.9,5.2 M 10,2 V 10.5" Stroke="{Binding Model.Dot}" StrokeThickness="2.5" Width="18" Height="18" Stretch="Uniform"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,5,0">
                <TextBlock Text="{Binding Model.ModelText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Model.DetailLine}" Style="{StaticResource Hint}" FontSize="10" TextTrimming="CharacterEllipsis" MaxHeight="26" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Model.Error}" FontSize="9.5" Foreground="{DynamicResource Danger}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding Model.HasError, Converter={StaticResource Visible}}" />
              </StackPanel>
              <Grid Grid.Column="2" Width="44" Height="44" ToolTip="{Binding Model.Panel.UsedLabel}" AutomationProperties.Name="{Binding Model.Panel.RamRing.Title}">
                <ui:ArcGauge Progress="{Binding Model.Panel.UsedFraction}" Alert="{Binding Model.Panel.RamRing.Alert}" />
                <TextBlock Text="{Binding Model.Panel.RamRing.Percent}" Style="{StaticResource MonoSmall}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Grid>
            <StackPanel Visibility="{Binding Model.NotInstalled, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding Model.StateTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
              <TextBlock Text="{Binding Model.Hint}" Style="{StaticResource Hint}" TextWrapping="Wrap" FontSize="10" Margin="0,2,0,0" />
            </StackPanel>
            <Grid Margin="0,8,0,0" Visibility="{Binding Model.Installed, Converter={StaticResource Visible}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Button Style="{StaticResource Bordered}" Command="{Binding Model.Panel.CleanNow}" AutomationProperties.Name="{Binding Model.Panel.CleanLabel}" ToolTip="{Binding Model.Panel.CleanHelp}"
                      IsEnabled="{Binding Model.Panel.CleanIdle}" Margin="0,0,4,0" FontSize="10.5" Padding="5,3">
                <TextBlock Text="{Binding Model.Panel.CleanButtonText}" TextTrimming="CharacterEllipsis" />
              </Button>
              <Button Grid.Column="1" Style="{StaticResource Bordered}" Command="{Binding Model.UnloadCommand}" IsEnabled="{Binding Model.CanUnload}"
                      AutomationProperties.Name="{Binding Model.UnloadLabel}" ToolTip="{Binding Model.UnloadHelp}" Margin="4,0,0,0" FontSize="10.5" Padding="5,3">
                <TextBlock Text="{Binding Model.UnloadLabel}" TextTrimming="CharacterEllipsis" />
              </Button>
            </Grid>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Compact}" Value="True">
          <Setter TargetName="fullHeader" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="fullMissing" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="fullBody" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="fullDetails" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="compactLayout" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Model.IsOn}" Value="True">
          <Setter TargetName="halo" Property="Stroke" Value="{DynamicResource On}" />
          <Setter TargetName="bolt" Property="Stroke" Value="{DynamicResource On}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Un motor del lanzador: su nombre y estado con el interruptor, y sus modelos -->
    <DataTemplate x:Key="LaunchGroupCard">
      <Border Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="10,8,10,5" Margin="3,0">
        <StackPanel>
          <DockPanel Margin="0,0,0,7">
            <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding Toggle}" IsEnabled="{Binding CanToggle}" AutomationProperties.Name="{Binding ToggleHelp}" ToolTip="{Binding ToggleHelp}">
              <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" Margin="4,2" />
            </Button>
            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Dot}" Margin="0,1,7,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Text="{Binding State}" Style="{StaticResource Hint}" FontSize="10" Margin="7,1,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Top2}" ItemTemplate="{StaticResource LaunchRowTight}" Focusable="False" />
          <TextBlock Text="{Binding Empty}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding NoRows, Converter={StaticResource Visible}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="WidgetLauncherWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" />
          <TextBlock Text="{Binding Model.Summary}" Style="{StaticResource Hint}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" Visibility="{Binding Model.HasModels, Converter={StaticResource Visible}}" />
          <ScrollViewer Grid.Row="1" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" MaxHeight="{Binding BodyMax}" Focusable="False">
            <StackPanel>
              <StackPanel Visibility="{Binding Model.NoModels, Converter={StaticResource Visible}}" Margin="0,4,0,0">
                <TextBlock Text="{Binding Model.EmptyTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Model.EmptyText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0" />
                <ItemsControl ItemsSource="{Binding Model.Groups}" Focusable="False" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Style="{StaticResource Plain}" Command="{Binding Toggle}" IsEnabled="{Binding CanToggle}" AutomationProperties.Name="{Binding ToggleHelp}" HorizontalAlignment="Left" Margin="0,0,0,5">
                      <Border Background="{DynamicResource ButtonBg}" CornerRadius="10" Padding="12,5"><TextBlock FontSize="11.5" Foreground="{DynamicResource Fg}" Text="{Binding ToggleHelp}" /></Border>
                    </Button>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Visibility="{Binding Model.HasModels, Converter={StaticResource Visible}}">
                <!-- Una celda: los tres primeros modelos -->
                <ItemsControl ItemsSource="{Binding Model.Top3}" ItemTemplate="{StaticResource LaunchRowTight}" Focusable="False" Margin="0,2,0,0" Visibility="{Binding CompactFlat, Converter={StaticResource Visible}}" />
                <!-- Dos celdas en una fila: un motor por columna -->
                <ItemsControl ItemsSource="{Binding Model.Groups}" ItemTemplate="{StaticResource LaunchGroupCard}" Focusable="False" Margin="-3,2,-3,0" Visibility="{Binding WideFlat, Converter={StaticResource Visible}}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- Una celda y dos filas: la lista de todos -->
                <ItemsControl ItemsSource="{Binding Model.Top6}" ItemTemplate="{StaticResource LaunchRowLine}" Focusable="False" Margin="0,2,0,0" Visibility="{Binding CompactTall, Converter={StaticResource Visible}}" />
                <!-- Dos celdas y dos filas: un motor por columna con más modelos -->
                <ItemsControl ItemsSource="{Binding Model.Groups}" Focusable="False" Margin="-3,2,-3,0" Visibility="{Binding WideTall, Converter={StaticResource Visible}}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="10,8,10,5" Margin="3,0">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,7">
                          <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding Toggle}" IsEnabled="{Binding CanToggle}" AutomationProperties.Name="{Binding ToggleHelp}" ToolTip="{Binding ToggleHelp}">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" Margin="4,2" />
                          </Button>
                          <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Dot}" Margin="0,1,7,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding State}" Style="{StaticResource Hint}" FontSize="10" Margin="7,1,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Top5}" ItemTemplate="{StaticResource LaunchRowLine}" Focusable="False" />
                        <TextBlock Text="{Binding Empty}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding NoRows, Converter={StaticResource Visible}}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Sistema: una celda = una columna (en la vista corta, sin disco ni red); dos celdas = dos columnas. -->
    <!-- Una métrica del sistema (CPU, RAM, GPU, disco, batería, red): el nombre y el valor arriba, la curva del último minuto y una barra con cuánto va usado -->
    <DataTemplate x:Key="SystemMetricCard">
      <Border CornerRadius="10" Padding="10,8,10,9" Margin="0,3" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
          </DockPanel>
          <ui:Sparkline Values="{Binding Samples}" Height="30" Margin="0,6,0,6" />
          <ui:UsageBar Height="5" Used="{Binding Fraction}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Lo mismo en una línea, para la vista corta: «CPU ··· 17 %» con su barra fina debajo -->
    <DataTemplate x:Key="SystemMetricLine">
      <StackPanel Margin="0,0,0,5">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Fg}" VerticalAlignment="Bottom" />
          <TextBlock Text="{Binding Title}" Style="{StaticResource Eyebrow}" />
        </DockPanel>
        <ui:UsageBar Height="5" Margin="0,3,0,0" Used="{Binding Fraction}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="WidgetSystemWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" />
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Model.PeekCards}" ItemTemplate="{StaticResource SystemMetricLine}" Focusable="False" Margin="0,3,0,0" Visibility="{Binding PeekList, Converter={StaticResource Visible}}" />
          <!-- Un solo widget por página: las métricas en dos columnas, para que quepan en el alto de la isla -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Model.PeekCards}" ItemTemplate="{StaticResource SystemMetricLine}" Focusable="False" VerticalAlignment="Center" Margin="0,3,0,0" Visibility="{Binding Bare, Converter={StaticResource Visible}}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="8,3" /></Style></ItemsControl.ItemContainerStyle>
          </ItemsControl>
          <!-- El contenido se centra en la altura que le deja la fila: sin huecos en blanco debajo cuando el vecino es más alto -->
          <StackPanel Grid.Row="1" VerticalAlignment="Center">
          <StackPanel Visibility="Collapsed">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Model.CpuLabel}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
              <TextBlock Text="{Binding Model.CpuTitle}" Style="{StaticResource Eyebrow}" />
            </DockPanel>
            <ui:MemoryBar Margin="0,6,0,10" Height="6" Used="{Binding Model.CpuFraction}" />
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Model.Panel.UsedLabel}" Margin="8,0,0,0" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
              <TextBlock Text="RAM" Style="{StaticResource Eyebrow}" />
            </DockPanel>
            <ui:MemoryBar Margin="0,6,0,10" Height="6" Used="{Binding Model.Panel.UsedFraction}" Model="{Binding Model.Panel.ModelFraction}" />
            <StackPanel Visibility="{Binding Model.Panel.ShowGpu, Converter={StaticResource Visible}}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Model.Panel.GpuUsedLabel}" Margin="8,0,0,0" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                <TextBlock Text="VRAM" Style="{StaticResource Eyebrow}" />
              </DockPanel>
              <ui:MemoryBar Margin="0,6,0,10" Height="6" Used="{Binding Model.Panel.GpuUsedFraction}" Model="{Binding Model.Panel.GpuModelFraction}" />
            </StackPanel>
            <StackPanel Visibility="{Binding Full, Converter={StaticResource Visible}}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Model.DiskLabel}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                <TextBlock Text="{Binding Model.DiskTitle}" Style="{StaticResource Eyebrow}" />
              </DockPanel>
              <ui:MemoryBar Margin="0,6,0,10" Height="6" Used="{Binding Model.DiskFraction}" />
              <DockPanel>
                <TextBlock Text="{Binding Model.NetTitle}" Style="{StaticResource Eyebrow}" DockPanel.Dock="Left" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Model.NetLabel}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Right" TextAlignment="Right" />
              </DockPanel>
            </StackPanel>
          </StackPanel>
          <Grid Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,14,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Model.CpuLabel}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                <TextBlock Text="{Binding Model.CpuTitle}" Style="{StaticResource Eyebrow}" />
              </DockPanel>
              <ui:MemoryBar Margin="0,6,0,10" Height="6" Used="{Binding Model.CpuFraction}" />
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Model.Panel.UsedLabel}" Margin="8,0,0,0" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                <TextBlock Text="RAM" Style="{StaticResource Eyebrow}" />
              </DockPanel>
              <ui:MemoryBar Margin="0,6,0,2" Height="6" Used="{Binding Model.Panel.UsedFraction}" Model="{Binding Model.Panel.ModelFraction}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
              <StackPanel Visibility="{Binding Model.Panel.ShowGpu, Converter={StaticResource Visible}}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Model.Panel.GpuUsedLabel}" Margin="8,0,0,0" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                  <TextBlock Text="VRAM" Style="{StaticResource Eyebrow}" />
                </DockPanel>
                <ui:MemoryBar Margin="0,6,0,10" Height="6" Used="{Binding Model.Panel.GpuUsedFraction}" Model="{Binding Model.Panel.GpuModelFraction}" />
              </StackPanel>
              <StackPanel Visibility="{Binding Full, Converter={StaticResource Visible}}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Model.DiskLabel}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                  <TextBlock Text="{Binding Model.DiskTitle}" Style="{StaticResource Eyebrow}" />
                </DockPanel>
                <ui:MemoryBar Margin="0,6,0,10" Height="6" Used="{Binding Model.DiskFraction}" />
                <DockPanel>
                  <TextBlock Text="{Binding Model.NetTitle}" Style="{StaticResource Eyebrow}" DockPanel.Dock="Left" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding Model.NetLabel}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Right" TextAlignment="Right" />
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Model.Cards}" ItemTemplate="{StaticResource SystemMetricCard}" Visibility="{Binding CompactFull, Converter={StaticResource Visible}}" Margin="0,6,0,0" Focusable="False" />
          <StackPanel Visibility="{Binding WideFull, Converter={StaticResource Visible}}" Margin="0,7,0,0">
            <TextBlock Text="Superstats" Style="{StaticResource Eyebrow}" Margin="2,0,0,3" />
            <ItemsControl ItemsSource="{Binding Model.AllCards}" ItemTemplate="{StaticResource SystemMetricCard}" Focusable="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="WidgetAudioWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" />
          <StackPanel Grid.Row="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Model.ActiveText}" Style="{StaticResource Hint}" Visibility="{Binding Model.HasSessions, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding Model.EmptyText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding Model.NoSessions, Converter={StaticResource Visible}}" />
          <!-- Una celda: las dos apps que más suenan con su nivel; dos celdas: hasta tres, en columnas -->
          <ItemsControl ItemsSource="{Binding Model.TopTwo}" Focusable="False" Margin="0,4,0,0">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Peek}" Value="True" /><Condition Binding="{Binding Compact}" Value="True" />
                  </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate><DataTemplate>
              <StackPanel Margin="0,0,0,7">
                <DockPanel>
                  <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Label}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Fg}" />
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Eyebrow}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ui:MemoryBar Height="4" Margin="0,3,0,0" Used="{Binding Level}" />
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Model.TopThree}" Focusable="False" Margin="0,4,0,0">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Peek}" Value="True" /><Condition Binding="{Binding Wide}" Value="True" />
                  </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <StackPanel Margin="0,0,14,0">
                <DockPanel>
                  <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Label}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Fg}" />
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Eyebrow}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ui:MemoryBar Height="5" Margin="0,5,0,0" Used="{Binding Level}" />
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Model.Sessions.Active}" Visibility="{Binding Full, Converter={StaticResource Visible}}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Image Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Margin="7,0,8,0" VerticalAlignment="Center">
                    <DockPanel><TextBlock Text="{Binding Name}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Label}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" Margin="6,0,0,0" /></DockPanel>
                    <ui:SeekBar Value="{Binding Level}" Command="{Binding SetLevel}" AutomationProperties.Name="{Binding Name}" />
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource Plain}" Command="{Binding ToggleMute}" AutomationProperties.Name="{Binding MuteHelp}" ToolTip="{Binding MuteHelp}" VerticalAlignment="Center">
                    <TextBlock Text="&#xE74F;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Secondary}" Margin="4" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AgentStatus">
      <Border x:Name="StatusPill" Background="{DynamicResource Track}" CornerRadius="8" Padding="7,4" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Grid Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,5,0">
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ui:Spinner x:Name="StatusSpinner" Width="10" Height="10" Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="StatusLabel" Text="{Binding Model.CurrentState}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Model.CurrentWorking}" Value="True">
          <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="StatusSpinner" Property="Visibility" Value="Visible" />
          <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource AccentSoft}" />
          <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Model.CurrentNeedsAttention}" Value="True">
          <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Danger}" />
          <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource DangerSoft}" />
          <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Danger}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Model.CurrentFinished}" Value="True">
          <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Secondary}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Cada sesión es una fila de tarjeta: la insignia de su agente, qué es, qué hace ahora y cómo va. -->
    <Style x:Key="AgentListItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="row" Background="{DynamicResource Track}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="14" Padding="10,9"><ContentPresenter /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource Track}" /></Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="row" Property="Background" Value="{DynamicResource CardFill}" />
            <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource Accent}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Agentes de IA, rediseño: una insignia viva por sesión, su estado en una pastilla y lo último que hace o dijo en una línea. -->
    <DataTemplate x:Key="AgentBadgeFor">
      <!-- La marca del agente (los rayos de Claude Code, el prompt de Codex) en un disco de su color y, dentro de la misma caja, un punto con su estado: nada sobresale, así no se corta -->
      <Viewbox Stretch="Uniform">
        <Grid Width="24" Height="24">
          <Ellipse x:Name="disc" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BrandClaude}" />
          <Path x:Name="rays" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource OnBrand}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M10,7.4 L10,2.6 M11.84,8.16 L14.1,5.9 M12.6,10 L17.4,10 M11.84,11.84 L14.1,14.1 M10,12.6 L10,17.4 M8.16,11.84 L5.9,14.1 M7.4,10 L2.6,10 M8.16,8.16 L5.9,5.9" />
          <Path x:Name="prompt" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource OnBrand}" StrokeThickness="1.9"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M5.2,6.2 L9.6,10 L5.2,13.8 M11.2,14.2 L15,14.2" />
          <Ellipse x:Name="dot" Width="9" Height="9" Margin="14.5,14.5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource Muted}" Stroke="{DynamicResource Bg}" StrokeThickness="1.6" />
        </Grid>
      </Viewbox>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Provider}" Value="Codex">
          <Setter TargetName="disc" Property="Fill" Value="{DynamicResource BrandCodex}" />
          <Setter TargetName="rays" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="prompt" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Working"><Setter TargetName="dot" Property="Fill" Value="{DynamicResource Accent}" /></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="NeedsAttention"><Setter TargetName="dot" Property="Fill" Value="{DynamicResource Danger}" /></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Finished"><Setter TargetName="dot" Property="Fill" Value="{DynamicResource On}" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="AgentStateChip">
      <Border x:Name="chip" Padding="7,2" CornerRadius="9" Background="{DynamicResource Track}" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="dot" Width="6" Height="6" Fill="{DynamicResource Secondary}" VerticalAlignment="Center" Margin="0,0,5,0" />
          <TextBlock x:Name="label" Text="{Binding StateLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Working">
          <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentSoft}" />
          <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Accent}" />
          <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="NeedsAttention">
          <Setter TargetName="chip" Property="Background" Value="{DynamicResource DangerSoft}" />
          <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Danger}" />
          <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Danger}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Finished">
          <Setter TargetName="chip" Property="Background" Value="{DynamicResource OnSoft}" />
          <Setter TargetName="dot" Property="Fill" Value="{DynamicResource On}" />
          <Setter TargetName="label" Property="Foreground" Value="{DynamicResource On}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- La tarjeta de una sesión en la lista (1×2 y 2×2): insignia, nombre, pastilla de estado, su última línea y de dónde viene. -->
    <DataTemplate x:Key="AgentSessionRow">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentBadgeFor}" Width="38" Height="38" VerticalAlignment="Top" Focusable="False" />
        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
          <DockPanel Margin="0,4,0,0">
            <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource AgentStateChip}" Margin="0,0,7,0" VerticalAlignment="Center" Focusable="False" />
            <TextBlock FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
              <Run Text="{Binding Provider, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ProjectName, Mode=OneWay}" />
            </TextBlock>
          </DockPanel>
          <TextBlock x:Name="line" Text="{Binding Line}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis"
                     Visibility="{Binding Line, Converter={StaticResource Visible}}" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Working"><Setter TargetName="line" Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Una tarjeta pequeña para el vistazo ancho (2×1): hasta tres sesiones una junto a otra. -->
    <DataTemplate x:Key="AgentSessionTile">
      <Border Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="10,9,10,9" Margin="3,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentBadgeFor}" Width="30" Height="30" VerticalAlignment="Top" Margin="0,0,9,0" Focusable="False" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="line" Text="{Binding StateLabel}" Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ProjectName}" Margin="0,1,0,0" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Working"><Setter TargetName="line" Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="NeedsAttention"><Setter TargetName="line" Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Finished"><Setter TargetName="line" Property="Foreground" Value="{DynamicResource On}" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Una línea de sesión para el vistazo de una celda: la marca, el nombre y el estado -->
    <DataTemplate x:Key="AgentGlanceRow">
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentBadgeFor}" Width="20" Height="20" Margin="0,0,8,0" Focusable="False" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock x:Name="state" Grid.Column="2" Text="{Binding StateLabel}" FontSize="10" Foreground="{DynamicResource Secondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Working"><Setter TargetName="state" Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="NeedsAttention"><Setter TargetName="state" Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Finished"><Setter TargetName="state" Property="Foreground" Value="{DynamicResource On}" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- El número grande de un vistazo: cuántos trabajan y qué significa. DataContext: la ranura. -->
    <DataTemplate x:Key="AgentHeadline">
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="num" Text="{Binding Model.HeadNumber}" HorizontalAlignment="Left" FontSize="40" FontWeight="SemiBold" LineHeight="42" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Fg}" />
        <TextBlock Text="{Binding Model.HeadCaption}" HorizontalAlignment="Left" TextAlignment="Left" FontSize="11.5" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" MaxWidth="120" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Model.HeadWorking}" Value="True"><Setter TargetName="num" Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.HasAttention}" Value="True"><Setter TargetName="num" Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.HeadWorking}" Value="True"><Setter TargetName="num" Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="AgentSessionDetail">
      <StackPanel>
        <DockPanel>
          <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource AgentStatus}" VerticalAlignment="Top" />
          <ContentControl DockPanel.Dock="Left" Content="{Binding Model.Current}" ContentTemplate="{StaticResource AgentBadgeFor}" Width="44" Height="44" Margin="0,0,11,0" Focusable="False" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Model.CurrentName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Model.CurrentProvider}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
          </StackPanel>
        </DockPanel>
        <WrapPanel Margin="0,10,0,0">
          <Border Padding="8,4" CornerRadius="9" Background="{DynamicResource Track}" Margin="0,0,6,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="10.5" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="{Binding Model.CurrentActivityTime}" FontSize="10.5" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Padding="8,4" CornerRadius="9" Background="{DynamicResource Track}" Margin="0,0,6,6" Visibility="{Binding Model.HasChanges, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Model.CurrentChanges}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
          </Border>
        </WrapPanel>
        <Border Margin="0,2,0,0" CornerRadius="10" Background="{DynamicResource Track}" Visibility="{Binding Model.HasOverview, Converter={StaticResource Visible}}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border CornerRadius="10,0,0,10" Background="{DynamicResource Accent}" Opacity="0.8" />
            <TextBlock Grid.Column="1" Text="{Binding Model.CurrentOverview}" FontSize="11" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" Margin="11,8,10,8" />
          </Grid>
        </Border>
        <StackPanel Margin="0,10,0,0" Visibility="{Binding Model.CanResumeCurrent, Converter={StaticResource Visible}}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid>
              <TextBox Style="{StaticResource Field}" Text="{Binding Model.ResumeText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32" MaxHeight="72"
                       VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Sans}" FontSize="11.5" AutomationProperties.Name="{Binding Model.ResumeHint}" />
              <TextBlock Text="{Binding Model.ResumeHint}" Style="{StaticResource Hint}" IsHitTestVisible="False" Margin="11,8,11,0" VerticalAlignment="Top"
                         Visibility="{Binding Model.ShowResumeHint, Converter={StaticResource Visible}}" />
            </Grid>
            <Button Grid.Column="1" Command="{Binding Model.SendResume}" Style="{StaticResource Tinted}" Padding="12,0" Margin="8,0,0,0" VerticalAlignment="Top" MinHeight="32"
                    IsEnabled="{Binding Model.CanSendResume}" AutomationProperties.Name="{Binding Model.ResumeHelp}" ToolTip="{Binding Model.ResumeHelp}">
              <TextBlock Text="{Binding Model.ResumeLabel}" />
            </Button>
          </Grid>
          <TextBlock Text="{Binding Model.ResumeStatus}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,5,0,0" Visibility="{Binding Model.HasResumeStatus, Converter={StaticResource Visible}}" />
        </StackPanel>
        <Button Style="{StaticResource Tinted}" Command="{Binding Model.ToggleDetails}" Margin="0,9,0,0" Padding="9,4" HorizontalAlignment="Left"
                AutomationProperties.Name="{Binding Model.DetailsToggleHelp}" ToolTip="{Binding Model.DetailsToggleHelp}">
          <TextBlock Text="{Binding Model.DetailsToggleLabel}" FontSize="10.5" />
        </Button>
        <StackPanel Visibility="{Binding Model.DetailsExpanded, Converter={StaticResource Visible}}">
          <Border Background="{DynamicResource Track}" CornerRadius="10" Padding="10,8" Margin="0,9,0,0" Visibility="{Binding Model.HasTool, Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="{Binding Model.ToolLabel}" Style="{StaticResource Eyebrow}" />
              <DockPanel Margin="0,3,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Model.CurrentTool}" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{DynamicResource Secondary}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Model.CurrentToolAction}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Track}" CornerRadius="10" Padding="10,8" Margin="0,7,0,0" Visibility="{Binding Model.HasFile, Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="{Binding Model.FileLabel}" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="{Binding Model.CurrentFile}" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Track}" CornerRadius="10" Padding="10,8" Margin="0,7,0,0" Visibility="{Binding Model.HasMessage, Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="{Binding Model.MessageLabel}" Style="{StaticResource Eyebrow}" />
              <ui:MarkdownView Markdown="{Binding Model.CurrentMessage}" FontSize="11" MaxHeight="130" Margin="0,4,0,0" AutomationProperties.Name="{Binding Model.MessageLabel}" />
            </StackPanel>
          </Border>
          <StackPanel Margin="0,10,0,0" Visibility="{Binding Model.HasRecentActivity, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Model.RecentActivityLabel}" Style="{StaticResource Eyebrow}" Margin="2,0,0,6" />
            <ItemsControl ItemsSource="{Binding Model.Current.RecentActivity}" Focusable="False">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Grid MinHeight="22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Rectangle Width="1" Fill="{DynamicResource Line}" HorizontalAlignment="Center" Margin="0,11,0,-11" />
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="10.5" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Margin="2,3,0,3" />
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="AgentViewPicker">
      <Border Background="{DynamicResource Track}" CornerRadius="11" Padding="2" Margin="0,6,0,0"
              Visibility="{Binding Model.Enabled, Converter={StaticResource Visible}}">
        <UniformGrid Columns="2">
          <Button Command="{Binding Model.SelectActive}" AutomationProperties.Name="{Binding Model.ActiveTabHelp}" ToolTip="{Binding Model.ActiveTabHelp}" Padding="8,6" Margin="1">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Tinted}">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Model.ShowingRecent}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Fg}" />
                    <Setter Property="Foreground" Value="{DynamicResource Bg}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <TextBlock Text="{Binding Model.ActiveTabLabel}" FontSize="10.5" FontWeight="SemiBold" />
          </Button>
          <Button Command="{Binding Model.SelectRecent}" AutomationProperties.Name="{Binding Model.RecentTabHelp}" ToolTip="{Binding Model.RecentTabHelp}" Padding="8,6" Margin="1">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Tinted}">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Model.ShowingRecent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Fg}" />
                    <Setter Property="Foreground" Value="{DynamicResource Bg}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <TextBlock Text="{Binding Model.RecentTabLabel}" FontSize="10.5" FontWeight="SemiBold" />
          </Button>
        </UniformGrid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AgentRecentFilters">
      <StackPanel Margin="0,0,0,7" Visibility="{Binding Model.ShowRecentFilters, Converter={StaticResource Visible}}">
        <Grid>
          <TextBox Style="{StaticResource Field}" Text="{Binding Model.RecentSearch, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" Padding="26,4,6,4"
                   AutomationProperties.Name="{Binding Model.SearchName}" ToolTip="{Binding Model.SearchHint}" />
          <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="11.5" Foreground="{DynamicResource Muted}"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" />
          <TextBlock Text="{Binding Model.SearchHint}" FontSize="10.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" Margin="26,0,8,0" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding Model.RecentSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <UniformGrid Columns="3" Margin="0,4,0,0">
          <ComboBox Style="{StaticResource GlassComboBox}" ItemsSource="{Binding Model.ProviderOptions}" SelectedItem="{Binding Model.SelectedProviderFilter, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{Binding Model.ProviderFilterName}" ToolTip="{Binding Model.ProviderFilterName}" Margin="0,0,4,0" />
          <ComboBox Style="{StaticResource GlassComboBox}" ItemsSource="{Binding Model.ProjectOptions}" SelectedItem="{Binding Model.SelectedProjectFilter, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{Binding Model.ProjectFilterName}" ToolTip="{Binding Model.ProjectFilterName}" Margin="0,0,4,0" />
          <ComboBox Style="{StaticResource GlassComboBox}" ItemsSource="{Binding Model.StateOptions}" SelectedItem="{Binding Model.SelectedStateFilter, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{Binding Model.StateFilterName}" ToolTip="{Binding Model.StateFilterName}" />
        </UniformGrid>
      </StackPanel>
    </DataTemplate>

    <!-- Agentes de IA. Una celda: el número de agentes que trabajan y sus insignias; dos celdas en una fila: el número y hasta tres sesiones en tarjetas;
         una celda y dos filas: pestañas y la lista de sesiones; dos celdas y dos filas: la lista y, al lado, el detalle de la elegida (con la pregunta y sus herramientas).
         La vista corta (Peek) usa siempre el vistazo. -->
    <DataTemplate x:Key="WidgetAgentsWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" />
          <ScrollViewer Grid.Row="1" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" MaxHeight="{Binding BodyMax}" Focusable="False">
          <StackPanel>
          <!-- Sin sesiones: las dos marcas, el aviso y, si está apagado, el botón de activar -->
          <StackPanel Visibility="{Binding Model.NoSessions, Converter={StaticResource Visible}}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentViewPicker}" Visibility="{Binding ListLayout, Converter={StaticResource Visible}}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentRecentFilters}" />
            <Border Margin="0,6,0,0" Padding="12,10" MinHeight="{Binding FillMin}" Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16">
              <StackPanel VerticalAlignment="Center">
                <!-- Una celda de ancho: las marcas arriba y el texto debajo; con más ancho, lado a lado -->
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Orientation" Value="Horizontal" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Style.Triggers><DataTrigger Binding="{Binding Compact}" Value="True"><Setter Property="Orientation" Value="Vertical" /><Setter Property="HorizontalAlignment" Value="Left" /></DataTrigger></Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <Grid Width="50" Height="34" VerticalAlignment="Center" HorizontalAlignment="Left" Opacity="0.85">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="Margin" Value="0,0,12,0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Compact}" Value="True"><Setter Property="Margin" Value="0,0,0,6" /></DataTrigger>
                        <DataTrigger Binding="{Binding CompactFlat}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Viewbox Width="30" Height="30" HorizontalAlignment="Left"><Grid Width="20" Height="20">
                    <Ellipse Fill="{DynamicResource BrandClaude}" />
                    <Path Stroke="{DynamicResource OnBrand}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M10,7.4 L10,2.6 M11.84,8.16 L14.1,5.9 M12.6,10 L17.4,10 M11.84,11.84 L14.1,14.1 M10,12.6 L10,17.4 M8.16,11.84 L5.9,14.1 M7.4,10 L2.6,10 M8.16,8.16 L5.9,5.9" />
                  </Grid></Viewbox>
                  <Viewbox Width="30" Height="30" HorizontalAlignment="Right"><Grid Width="20" Height="20">
                    <Ellipse Fill="{DynamicResource BrandCodex}" Stroke="{DynamicResource Track}" StrokeThickness="0" />
                    <Path Stroke="{DynamicResource OnBrand}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M5.2,6.2 L9.6,10 L5.2,13.8 M11.2,14.2 L15,14.2" />
                  </Grid></Viewbox>
                </Grid>
                <StackPanel VerticalAlignment="Center" MaxWidth="320">
                  <TextBlock Text="{Binding Model.EmptyTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Model.EmptyText}" Style="{StaticResource Hint}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding Model.EmptyHint}" FontSize="10" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Tall, Converter={StaticResource Visible}}" />
                  <Button Style="{StaticResource Plain}" Command="{Binding Model.EnableCommand}" HorizontalAlignment="Left" Margin="0,7,0,0" AutomationProperties.Name="{Binding Model.EnableText}"
                          Visibility="{Binding Model.CanEnable, Converter={StaticResource Visible}}">
                    <Border Background="{DynamicResource ButtonBg}" CornerRadius="10" Padding="12,4"><TextBlock Text="{Binding Model.EnableText}" FontSize="11.5" Foreground="{DynamicResource Fg}" /></Border>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Visibility="{Binding Model.HasSessions, Converter={StaticResource Visible}}">
            <!-- Vistazo de una celda: el número y las dos primeras sesiones -->
            <StackPanel Margin="0,2,0,0" Visibility="{Binding GlanceCompact, Converter={StaticResource Visible}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="num" Text="{Binding Model.HeadNumber}" FontSize="30" FontWeight="SemiBold" LineHeight="32" FontFamily="{StaticResource Mono}" VerticalAlignment="Bottom">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Model.HeadWorking}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Model.HasAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Model.HeadCaption}" FontSize="11.5" Foreground="{DynamicResource Secondary}" Margin="9,0,0,3" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" MaxWidth="170" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Model.Top2}" ItemTemplate="{StaticResource AgentGlanceRow}" Focusable="False" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Vistazo de dos celdas en una fila: el número a la izquierda y las sesiones en tarjetas -->
            <Grid Margin="0,4,0,0" Visibility="{Binding GlanceWide, Converter={StaticResource Visible}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentHeadline}" Margin="2,0,18,0" Focusable="False" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Model.Top3}" ItemTemplate="{StaticResource AgentSessionTile}" Focusable="False" VerticalAlignment="Center" Margin="-3,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </Grid>

            <!-- Una celda y dos filas: pestañas y la lista -->
            <StackPanel Visibility="{Binding ListCompact, Converter={StaticResource Visible}}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentViewPicker}" Margin="0,-2,0,0" />
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentRecentFilters}" Margin="0,6,0,0" />
              <ListBox ItemContainerStyle="{StaticResource AgentListItem}" ItemsSource="{Binding Model.VisibleSessions}" SelectedItem="{Binding Model.Current, Mode=TwoWay}" ItemTemplate="{StaticResource AgentSessionRow}"
                       Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,0" MinHeight="{Binding FillMin}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Model.ActivityLabel}" />
            </StackPanel>

            <!-- Dos celdas y dos filas: la lista a la izquierda y el detalle de la sesión elegida a la derecha -->
            <Grid Margin="0,2,0,0" Visibility="{Binding DetailWide, Converter={StaticResource Visible}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="1.5*" /></Grid.ColumnDefinitions>
              <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentViewPicker}" Margin="0,-2,0,0" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentRecentFilters}" Margin="0,6,0,0" />
                <ListBox ItemContainerStyle="{StaticResource AgentListItem}" ItemsSource="{Binding Model.VisibleSessions}" SelectedItem="{Binding Model.Current, Mode=TwoWay}" ItemTemplate="{StaticResource AgentSessionRow}"
                         Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Model.ActivityLabel}" />
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource Track}" CornerRadius="16" Padding="12,11" Margin="10,8,0,0" VerticalAlignment="Top" MinHeight="{Binding DetailMin}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentSessionDetail}" Focusable="False" />
              </Border>
            </Grid>
          </StackPanel>
          </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ============ Uso de IA ============ -->
    <!-- El número cambia de color como la barra: normal, ámbar desde el 70 % y rojo desde el 90 % -->
    <Style x:Key="UsageTone" TargetType="TextBlock" BasedOn="{StaticResource MonoSmall}">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="danger"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="UsagePrimaryTone" TargetType="TextBlock" BasedOn="{StaticResource MonoSmall}">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding PrimaryTone}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger>
        <DataTrigger Binding="{Binding PrimaryTone}" Value="danger"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- La insignia del proveedor: un círculo de su color con su marca dibujada a mano (rayos de Claude, el prompt de Codex, la estrella de Gemini); crece con el tamaño que se le dé -->
    <DataTemplate x:Key="UsageBadge">
      <Viewbox Stretch="Uniform">
        <Grid Width="20" Height="20">
          <Ellipse Fill="{Binding Badge}" />
          <Path x:Name="claude" Visibility="Collapsed" Stroke="{Binding OnBadge}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M10,7.4 L10,2.6 M11.84,8.16 L14.1,5.9 M12.6,10 L17.4,10 M11.84,11.84 L14.1,14.1 M10,12.6 L10,17.4 M8.16,11.84 L5.9,14.1 M7.4,10 L2.6,10 M8.16,8.16 L5.9,5.9" />
          <Path x:Name="codex" Visibility="Collapsed" Stroke="{Binding OnBadge}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Data="M5.2,6.2 L9.6,10 L5.2,13.8 M11.2,14.2 L15,14.2" />
          <Path x:Name="gemini" Visibility="Collapsed" Fill="{Binding OnBadge}"
                Data="M10,2.2 C10.55,6.5 13.5,9.45 17.8,10 C13.5,10.55 10.55,13.5 10,17.8 C9.45,13.5 6.5,10.55 2.2,10 C6.5,9.45 9.45,6.5 10,2.2 Z" />
        </Grid>
      </Viewbox>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Id}" Value="claude"><Setter TargetName="claude" Property="Visibility" Value="Visible" /></DataTrigger>
        <DataTrigger Binding="{Binding Id}" Value="codex"><Setter TargetName="codex" Property="Visibility" Value="Visible" /></DataTrigger>
        <DataTrigger Binding="{Binding Id}" Value="gemini"><Setter TargetName="gemini" Property="Visibility" Value="Visible" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- El plan como una píldora pequeña -->
    <DataTemplate x:Key="UsagePlanChip">
      <Border Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="6,1,6,2" VerticalAlignment="Center"
              Visibility="{Binding HasPlan, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding Plan}" FontSize="10" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" MaxWidth="120" />
      </Border>
    </DataTemplate>

    <!-- Una celda: cuota con porcentaje/barra, o el resumen que realmente informe una fuente sin cupo -->
    <DataTemplate x:Key="UsageGlanceLine">
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsageBadge}" Width="18" Height="18" Margin="0,0,8,0" Focusable="False" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding PrimaryValue}" Style="{StaticResource UsagePrimaryTone}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="96"
                   Visibility="{Binding HasLimits, Converter={StaticResource Visible}}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding GlanceDetail}" Style="{StaticResource Hint}" FontSize="10.5" Margin="0,2,0,0"
                   TextWrapping="Wrap" TextTrimming="None" Visibility="{Binding HasGlanceDetail, Converter={StaticResource Visible}}" />
        <ui:UsageBar Grid.Row="1" Grid.ColumnSpan="3" Height="5" Margin="0,4,0,0" Used="{Binding PrimaryFraction}" Visibility="{Binding HasLimits, Converter={StaticResource Visible}}" />
      </Grid>
    </DataTemplate>

    <!-- Dos celdas en una fila: anillo para cuotas; las fuentes sin cupo muestran su resumen textual -->
    <DataTemplate x:Key="UsageGlanceTile">
      <Grid Margin="6,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Width="62" Height="62" VerticalAlignment="Center" Visibility="{Binding HasLimits, Converter={StaticResource Visible}}">
          <ui:ArcGauge Progress="{Binding PrimaryFraction}" Alert="{Binding PrimaryAlert}" Visibility="{Binding HasLimits, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding PrimaryValue}" Style="{StaticResource UsagePrimaryTone}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="58" MaxHeight="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsageBadge}" Width="16" Height="16" Margin="0,0,6,0" Focusable="False" />
            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding Plan}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding HasPlan, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding Aside}" Style="{StaticResource Hint}" FontSize="10" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- Una barra en el diseño estrecho: «5 h ··· 6 % reinicia 21:10» y la barra debajo -->
    <DataTemplate x:Key="UsageLimitNarrow">
      <StackPanel Margin="0,0,0,6">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding PercentText}" Style="{StaticResource UsageTone}" Margin="0,0,6,0" />
            <TextBlock Text="{Binding ResetText}" Style="{StaticResource MonoSmall}" FontSize="9.5" />
          </StackPanel>
          <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
        </DockPanel>
        <ui:UsageBar Height="5" Margin="0,3,0,0" Used="{Binding Fraction}" />
      </StackPanel>
    </DataTemplate>

    <!-- Una barra en el diseño ancho: etiqueta, barra, porcentaje y reinicio en una línea -->
    <DataTemplate x:Key="UsageLimitWide">
      <Grid Margin="0,0,0,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /><ColumnDefinition Width="122" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ui:UsageBar Grid.Column="1" Height="6" VerticalAlignment="Center" Used="{Binding Fraction}" />
        <TextBlock Grid.Column="2" Text="{Binding PercentText}" Style="{StaticResource UsageTone}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding ResetText}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="UsageCardNarrow">
      <Border Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="11,9,11,4" Margin="0,0,0,7">
        <StackPanel>
          <DockPanel Margin="0,0,0,7">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Updated}" Style="{StaticResource Hint}" FontSize="10" VerticalAlignment="Center" />
            <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource UsageBadge}" Width="19" Height="19" Margin="0,0,7,0" Focusable="False" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="0,0,7,0" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsagePlanChip}" HorizontalAlignment="Left" Focusable="False" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Limits}" ItemTemplate="{StaticResource UsageLimitNarrow}" Focusable="False" />
          <TextBlock Text="{Binding Problem}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding Extra}" Style="{StaticResource Hint}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" Visibility="{Binding HasExtra, Converter={StaticResource Visible}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="UsageCardWide">
      <Border Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="14,10,14,4" Margin="0,0,0,7">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="142" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsageBadge}" Width="24" Height="24" Margin="0,0,8,0" Focusable="False" />
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsagePlanChip}" HorizontalAlignment="Left" Margin="0,6,0,0" Focusable="False" />
            <TextBlock Text="{Binding Updated}" Style="{StaticResource Hint}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,2,0,0">
            <ItemsControl ItemsSource="{Binding Limits}" ItemTemplate="{StaticResource UsageLimitWide}" Focusable="False" />
            <TextBlock Text="{Binding Problem}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Extra}" Style="{StaticResource Hint}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" Visibility="{Binding HasExtra, Converter={StaticResource Visible}}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="WidgetUsageWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" />
          <!-- A la derecha de la cabecera: cuándo se actualizó y el botón de actualizar -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,0,0">
            <TextBlock Text="{Binding Model.UpdatedText}" Style="{StaticResource Hint}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding Wide, Converter={StaticResource Visible}}" />
            <Button Style="{StaticResource Plain}" Command="{Binding Model.RefreshCommand}" ToolTip="{Binding Model.RefreshHelp}" AutomationProperties.Name="{Binding Model.RefreshHelp}"
                    Visibility="{Binding Model.CanRefresh, Converter={StaticResource Visible}}">
              <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" Margin="6,3" />
            </Button>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" MaxHeight="{Binding BodyMax}" Focusable="False">
            <StackPanel>
              <!-- Sin proveedores: desactivado (con botón para activarlo), consultando o ninguna sesión iniciada -->
              <StackPanel Visibility="{Binding Model.NoRows, Converter={StaticResource Visible}}" Margin="0,4,0,0">
                <TextBlock Text="{Binding Model.EmptyTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Model.EmptyText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="64" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Model.EmptyHint}" FontSize="10" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Tall, Converter={StaticResource Visible}}" />
                <Button Style="{StaticResource Plain}" Command="{Binding Model.EnableCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="{Binding Model.EnableText}"
                        Visibility="{Binding Model.CanEnable, Converter={StaticResource Visible}}">
                  <Border Background="{DynamicResource ButtonBg}" CornerRadius="10" Padding="12,5"><TextBlock Text="{Binding Model.EnableText}" FontSize="11.5" Foreground="{DynamicResource Fg}" /></Border>
                </Button>
              </StackPanel>
              <StackPanel Visibility="{Binding Model.HasRows, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Model.Rows}" ItemTemplate="{StaticResource UsageGlanceLine}" Focusable="False" Margin="0,2,0,0" Visibility="{Binding CompactFlat, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding Model.Rows}" ItemTemplate="{StaticResource UsageGlanceTile}" Focusable="False" Margin="-6,8,-6,0" Visibility="{Binding WideFlat, Converter={StaticResource Visible}}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Model.Rows}" ItemTemplate="{StaticResource UsageCardNarrow}" Focusable="False" Visibility="{Binding CompactTall, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding Model.Rows}" ItemTemplate="{StaticResource UsageCardWide}" Focusable="False" Visibility="{Binding WideTall, Converter={StaticResource Visible}}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="WidgetWeatherWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}" MinHeight="38">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" />
          <TextBlock Text="{Binding Model.UpdatedText}" Style="{StaticResource Hint}" FontSize="10" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-3,0,0"
                     Visibility="{Binding Wide, Converter={StaticResource Visible}}" />
          <StackPanel Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Model.Status}" Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding Model.NoForecast, Converter={StaticResource Visible}}" />
          <StackPanel Visibility="{Binding Model.HasForecast, Converter={StaticResource Visible}}">
            <!-- Lo de ahora: el icono del tiempo, la temperatura grande y cómo está; la ciudad debajo y, en la vista completa, la máxima y la mínima -->
            <Grid Margin="0,3,0,0">
              <!-- La temperatura y el estado ceden el ancho que haga falta: las horas de la derecha van enteras, nunca cortadas por el borde -->
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <ui:WeatherIcon Code="{Binding Model.ConditionCode}" Night="{Binding Model.IsNight}" Width="38" Height="38" VerticalAlignment="Center" Animated="True" />
              <!-- Vista corta: las tres horas siguientes a la derecha, en el hueco que dejaba la temperatura -->

              <ItemsControl Grid.Column="2" ItemsSource="{Binding Model.NextHours}" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                            Visibility="{Binding CompactPeek, Converter={StaticResource Visible}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel Margin="4,0,0,0" MinWidth="36">
                    <TextBlock Text="{Binding TimeLabel}" FontSize="9.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                    <ui:WeatherIcon Code="{Binding Code}" Night="{Binding IsNight}" Width="19" Height="19" Margin="0,2" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding TemperatureLabel}" Style="{StaticResource MonoSmall}" HorizontalAlignment="Center" />
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- Dos celdas y una fila: caben todas las horas que da la previsión -->
              <ItemsControl Grid.Column="2" ItemsSource="{Binding Model.Hours}" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                            Visibility="{Binding WidePeek, Converter={StaticResource Visible}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel Margin="5,0,0,0" MinWidth="34">
                    <TextBlock Text="{Binding TimeLabel}" FontSize="9.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                    <ui:WeatherIcon Code="{Binding Code}" Night="{Binding IsNight}" Width="19" Height="19" Margin="0,2" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding TemperatureLabel}" Style="{StaticResource MonoSmall}" HorizontalAlignment="Center" />
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Model.HighLow}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" VerticalAlignment="Bottom" Margin="8,0,0,3"
                             Visibility="{Binding Full, Converter={StaticResource Visible}}" />
                  <TextBlock Text="{Binding Model.TemperatureText}" FontSize="27" FontWeight="SemiBold" LineHeight="30" Foreground="{DynamicResource Fg}" />
                </DockPanel>
                <TextBlock Text="{Binding Model.ConditionText}" FontSize="12" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" />
              </StackPanel>
            </Grid>
            <DockPanel Margin="0,5,0,0">
              <TextBlock DockPanel.Dock="Right" Text="{Binding Model.HighLow}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" Margin="8,0,0,0"
                         Visibility="{Binding Peek, Converter={StaticResource Visible}}" />
              <TextBlock Text="{Binding Model.Forecast.City}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Model.Hours}" Margin="0,9,0,0" Focusable="False" Visibility="{Binding Full, Converter={StaticResource Visible}}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <StackPanel HorizontalAlignment="Center" Margin="2,0">
                <TextBlock Text="{Binding TimeLabel}" FontSize="9.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                <ui:WeatherIcon Code="{Binding Code}" Night="{Binding IsNight}" Width="20" Height="20" Margin="0,3" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding TemperatureLabel}" Style="{StaticResource MonoSmall}" HorizontalAlignment="Center" />
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ui:Sparkline Values="{Binding Model.HourCurve}" Height="26" Margin="6,6,6,0" Visibility="{Binding Full, Converter={StaticResource Visible}}" />
          </StackPanel>
        </Grid>
      </Border>
        </DataTemplate>

    <!-- ============ Luces LED ============ -->
    <!-- Un color rápido: un círculo del color, con un aro si es el elegido. -->
    <DataTemplate x:Key="LedSwatchDot">
      <Button Style="{StaticResource Plain}" Command="{Binding Pick}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Center" Margin="1">
        <Grid Width="25" Height="25">
          <Ellipse Fill="{Binding Fill}" Margin="2" />
          <!-- El aro del elegido tiene exactamente el tamaño del círculo y cae sobre su borde: no sobra ni falta nada -->
          <Ellipse x:Name="ring" Stroke="{DynamicResource Fg}" StrokeThickness="2.2" Margin="2" Visibility="Collapsed" />
        </Grid>
      </Button>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <!-- Una pastilla de efecto o de escena: la elegida va maciza. -->
    <DataTemplate x:Key="LedChipPill">
      <Button Style="{StaticResource Plain}" Command="{Binding Pick}" AutomationProperties.Name="{Binding Name}" Margin="0,0,6,6">
        <Border x:Name="chip" CornerRadius="12" Padding="9,5,12,5" Background="{DynamicResource Track}">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="dot" Width="10" Height="10" Fill="{Binding Dot}" Margin="0,0,7,0" VerticalAlignment="Center" />
            <TextBlock x:Name="label" Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource Secondary}" />
          </StackPanel>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Dot}" Value="{x:Null}"><Setter TargetName="dot" Property="Visibility" Value="Collapsed" /></DataTrigger>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="chip" Property="Background" Value="{DynamicResource Fg}" />
          <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Bg}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- Una alarma: enciende o apaga, la hora con sus botones de ±15 min, los días y el interruptor. -->
    <DataTemplate x:Key="LedTimerLine">
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" Width="62" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Plain}" Command="{Binding Earlier}" AutomationProperties.Name="-15">
            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="4" />
          </Button>
          <TextBlock Text="{Binding Time}" Style="{StaticResource MonoSmall}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" MinWidth="50" TextAlignment="Center" />
          <Button Style="{StaticResource Plain}" Command="{Binding Later}" AutomationProperties.Name="+15">
            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="4" />
          </Button>
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource Plain}" Command="{Binding CycleDays}" AutomationProperties.Name="{Binding Days}" Margin="4,0,8,0">
          <Border CornerRadius="9" Padding="8,3" Background="{DynamicResource Track}"><TextBlock Text="{Binding Days}" FontSize="10.5" Foreground="{DynamicResource Secondary}" /></Border>
        </Button>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:BrandSwitch IsOn="{Binding Enabled, Mode=OneWay}" Command="{Binding Toggle}" AutomationProperties.Name="{Binding Title}" />
          <Button Style="{StaticResource Plain}" Command="{Binding Remove}" AutomationProperties.Name="X" Margin="4,0,0,0">
            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{DynamicResource Muted}" Margin="4" />
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <!-- El botón de encendido: macizo si las luces están encendidas. DataContext: la ranura. -->
    <DataTemplate x:Key="LedPowerButton">
      <Button Style="{StaticResource Plain}" Command="{Binding Model.Toggle}" ToolTip="{Binding Model.PowerHelp}" AutomationProperties.Name="{Binding Model.PowerHelp}" VerticalAlignment="Center">
        <Grid Width="56" Height="56" Margin="2">
          <Ellipse Fill="{DynamicResource GlassFill}" Stroke="{DynamicResource GlassRim}" StrokeThickness="1" />
          <Ellipse Fill="{Binding Model.PowerFill}" Margin="4">
            <Ellipse.Effect><DropShadowEffect Color="{Binding Model.AccentColor}" BlurRadius="22" ShadowDepth="0" Opacity="{Binding Model.GlowOpacity}" /></Ellipse.Effect>
          </Ellipse>
          <TextBlock x:Name="glyph" Text="{Binding Model.PowerGlyph}" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Model.IsOn}" Value="True"><Setter TargetName="glyph" Property="Foreground" Value="{Binding Model.PowerForeground}" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- Brillo: un sol, la barra y el porcentaje. DataContext: la ranura. -->
    <DataTemplate x:Key="LedBrightnessBar">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Model.BrightnessText}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
        <TextBlock DockPanel.Dock="Left" Text="&#xE706;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
        <ui:SeekBar Accent="{Binding Model.ColorBrush}" Value="{Binding Model.Brightness, Mode=OneWay}" Command="{Binding Model.SetBrightness}" AutomationProperties.Name="{Binding Model.BrightnessText}" VerticalAlignment="Center" />
      </DockPanel>
    </DataTemplate>
    <!-- Lo que se ve sin ninguna tira: para qué sirve y el botón de buscar. -->
    <DataTemplate x:Key="LedEmpty">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Model.EmptyText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
        <Button Style="{StaticResource Bordered}" Command="{Binding Model.Scan}" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="{Binding Model.ScanLabel}">
          <TextBlock Text="{Binding Model.ScanLabel}" Margin="2,0" />
        </Button>
        <TextBlock Text="{Binding Model.ScanText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </DataTemplate>
    <!-- Las pestañas de una tira (vistas altas): Color, Efectos, Escenas, Música y Alarmas. DataContext: la ranura. -->
    <DataTemplate x:Key="LedTabs">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding Model.Tabs}" Margin="0,0,0,10" />
        <!-- Color -->
        <Grid Grid.Row="1" Visibility="{Binding Model.IsColorTab, Converter={StaticResource Visible}}">
        <Grid Visibility="{Binding Compact, Converter={StaticResource Visible}}">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Viewbox Stretch="Uniform" MaxHeight="190" Margin="2,0,2,8">
            <ui:ColorWheel Width="150" Height="150" Hue="{Binding Model.Hue, Mode=OneWay}" Fill="{Binding Model.ColorBrush}" FillOpacity="{Binding Model.Brightness}" Command="{Binding Model.PickHue}" AutomationProperties.Name="{Binding Model.ModeText}" />
          </Viewbox>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Model.Swatches}" ItemTemplate="{StaticResource LedSwatchDot}" Focusable="False" HorizontalAlignment="Stretch" Margin="0,0,0,6">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource LedBrightnessBar}" Margin="0,0,0,2" />
        </Grid>
        <Grid Visibility="{Binding Wide, Converter={StaticResource Visible}}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
          <Viewbox Stretch="Uniform" MaxHeight="190" Margin="4,0,12,0">
            <ui:ColorWheel Width="150" Height="150" Hue="{Binding Model.Hue, Mode=OneWay}" Fill="{Binding Model.ColorBrush}" FillOpacity="{Binding Model.Brightness}" Command="{Binding Model.PickHue}" AutomationProperties.Name="{Binding Model.ModeText}" />
          </Viewbox>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Model.Swatches}" ItemTemplate="{StaticResource LedSwatchDot}" Focusable="False" HorizontalAlignment="Stretch" Margin="0,0,0,10">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LedBrightnessBar}" />
          </StackPanel>
        </Grid>
        </Grid>
        <!-- Efectos -->
        <Grid Grid.Row="1" Visibility="{Binding Model.IsEffectsTab, Converter={StaticResource Visible}}">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Model.EffectGroups}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Eyebrow}" Margin="2,2,0,6" />
                    <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource LedChipPill}" Focusable="False">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <DockPanel Grid.Row="1" Margin="0,6,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Model.SpeedText}" Style="{StaticResource Hint}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <ui:SeekBar Value="{Binding Model.Speed, Mode=OneWay}" Command="{Binding Model.SetSpeed}" AutomationProperties.Name="{Binding Model.SpeedText}" VerticalAlignment="Center" />
          </DockPanel>
        </Grid>
        <!-- Escenas -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding Model.IsScenesTab, Converter={StaticResource Visible}}">
          <ItemsControl ItemsSource="{Binding Model.SceneChips}" ItemTemplate="{StaticResource LedChipPill}" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
        <!-- Música -->
        <StackPanel Grid.Row="1" Visibility="{Binding Model.IsMusicTab, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding Model.MusicHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
          <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding Model.MusicModes}" Margin="0,10,0,0" />
          <DockPanel Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Model.SensitivityText}" Style="{StaticResource Hint}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <ui:SeekBar Value="{Binding Model.Sensitivity, Mode=OneWay}" Command="{Binding Model.SetSensitivity}" AutomationProperties.Name="{Binding Model.SensitivityText}" VerticalAlignment="Center" />
          </DockPanel>
          <ui:MemoryBar Height="8" Margin="0,14,0,0" Used="{Binding Model.MusicLevel}" />
          <Button Style="{StaticResource Bordered}" Command="{Binding Model.ToggleMusic}" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="{Binding Model.MusicLabel}">
            <TextBlock Text="{Binding Model.MusicLabel}" Margin="2,0" />
          </Button>
        </StackPanel>
        <!-- Alarmas -->
        <Grid Grid.Row="1" Visibility="{Binding Model.IsTimersTab, Converter={StaticResource Visible}}">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
              <TextBlock Text="{Binding Model.TimersHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Model.Timers}" ItemTemplate="{StaticResource LedTimerLine}" Focusable="False" />
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
            <Button Style="{StaticResource Bordered}" Command="{Binding Model.AddOnTimer}" Margin="0,0,8,0" AutomationProperties.Name="{Binding Model.AddOnLabel}"><TextBlock Text="{Binding Model.AddOnLabel}" Margin="2,0" FontSize="11" /></Button>
            <Button Style="{StaticResource Bordered}" Command="{Binding Model.AddOffTimer}" AutomationProperties.Name="{Binding Model.AddOffLabel}"><TextBlock Text="{Binding Model.AddOffLabel}" Margin="2,0" FontSize="11" /></Button>
          </StackPanel>
        </Grid>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WidgetLedWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <!-- Un resplandor suave del color de las luces por detrás: se nota a lo lejos si están encendidas y de qué color -->
          <Border Grid.RowSpan="2" Margin="-12,-8" CornerRadius="18" IsHitTestVisible="False" Background="{Binding Model.GlowBrush}" />
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" />
          <!-- A la derecha de la cabecera: la tira elegida y cómo va su conexión (con un toque, la siguiente) -->
          <Button Style="{StaticResource Plain}" Command="{Binding Model.Next}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0"
                  Visibility="{Binding Model.HasDevices, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Model.Name}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Model.Name}" FontSize="11" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center" />
              <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{DynamicResource Muted}" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="{Binding Model.MoreThanOne, Converter={StaticResource Visible}}" />
              <Ellipse Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource Muted}" />
                    <Style.Triggers><DataTrigger Binding="{Binding Model.IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource On}" /></DataTrigger></Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
            </StackPanel>
          </Button>
          <!-- Sin ninguna tira -->
          <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource LedEmpty}" Visibility="{Binding Model.NoDevices, Converter={StaticResource Visible}}" />
          <!-- Una celda: el encendido, los diez colores rápidos y el brillo -->
          <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding CompactFlat}" Value="True" /><Condition Binding="{Binding Model.HasDevices}" Value="True" />
                  </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LedPowerButton}" Margin="0,0,12,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Model.ModeText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Model.Status}" Style="{StaticResource Hint}" />
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,2,0,0">
              <ItemsControl ItemsSource="{Binding Model.Swatches}" ItemTemplate="{StaticResource LedSwatchDot}" Focusable="False" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LedBrightnessBar}" Margin="0,6,0,0" />
            </StackPanel>
          </Grid>
          <!-- Dos celdas en una fila: el encendido, la rueda, los colores con el brillo y el efecto de ahora -->
          <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding WideFlat}" Value="True" /><Condition Binding="{Binding Model.HasDevices}" Value="True" />
                  </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LedPowerButton}" Margin="0,0,14,0" />
            <ui:ColorWheel Grid.Column="1" Width="100" Height="100" Hue="{Binding Model.Hue, Mode=OneWay}" Fill="{Binding Model.ColorBrush}" FillOpacity="{Binding Model.Brightness}" Command="{Binding Model.PickHue}" AutomationProperties.Name="{Binding Model.ModeText}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
              <TextBlock Text="{Binding Model.ModeText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
              <ui:LightStrip Margin="0,5,0,7" Color="{Binding Model.AccentColor}" Brightness="{Binding Model.Brightness}" Effect="{Binding Model.EffectCode}" IsOn="{Binding Model.IsOn}" Level="{Binding Model.LiveLevel}" />
              <ItemsControl ItemsSource="{Binding Model.Swatches}" ItemTemplate="{StaticResource LedSwatchDot}" Focusable="False" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LedBrightnessBar}" Margin="0,8,0,0" />
            </StackPanel>
          </Grid>
          <!-- Vistas altas: el encendido y la tira, y debajo las pestañas -->
          <Grid Grid.Row="1" MaxHeight="{Binding BodyMax}" VerticalAlignment="Top">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tall}" Value="True" /><Condition Binding="{Binding Model.HasDevices}" Value="True" />
                  </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
              <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource LedPowerButton}" Margin="0,0,12,0" />
              <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding Model.Scan}" VerticalAlignment="Center" ToolTip="{Binding Model.ScanLabel}" AutomationProperties.Name="{Binding Model.ScanLabel}">
                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
                  <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Model.ModeText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Model.Status}" Style="{StaticResource Hint}" />
              </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <ui:LightStrip Margin="0,0,0,10" Visibility="{Binding Wide, Converter={StaticResource Visible}}" Color="{Binding Model.AccentColor}" Brightness="{Binding Model.Brightness}" Effect="{Binding Model.EffectCode}" IsOn="{Binding Model.IsOn}" Level="{Binding Model.LiveLevel}" />
              <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource LedTabs}" />
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="WidgetTeleprompterWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="statePill" Background="{DynamicResource Track}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="9" Padding="6,3" Margin="0,0,5,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse x:Name="stateDot" Width="5" Height="5" Fill="{DynamicResource Secondary}" VerticalAlignment="Center" />
                  <TextBlock x:Name="stateLabel" Text="{Binding Model.StateLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Ellipse x:Name="compactStateDot" Width="6" Height="6" Fill="{DynamicResource Secondary}" ToolTip="{Binding Model.StateLabel}" AutomationProperties.Name="{Binding Model.StateLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <Border x:Name="progressBadge" Background="{DynamicResource Track}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="8" Padding="5,2" Margin="0,0,5,0">
                <TextBlock x:Name="progressLabel" Text="{Binding Progress, ElementName=reader, StringFormat={}{0:P0}}" FontFamily="{StaticResource Mono}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource On}" VerticalAlignment="Center" />
              </Border>
              <Border Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="11" Padding="2">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="restart" Style="{StaticResource TeleprompterAction}" Command="{Binding Model.Restart}" AutomationProperties.Name="{Binding Model.RestartHelp}" ToolTip="{Binding Model.RestartHelp}" Margin="0,0,1,0">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Button>
                  <Button x:Name="edit" Style="{StaticResource TeleprompterAction}" Command="{Binding Model.ToggleEdit}" AutomationProperties.Name="{Binding Model.EditHelp}" ToolTip="{Binding Model.EditHelp}" Margin="0,0,1,0">
                    <TextBlock x:Name="editIcon" Text="{Binding Model.EditGlyph}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Button>
                  <Button x:Name="run" Style="{StaticResource TeleprompterAction}" Command="{Binding Model.Toggle}" AutomationProperties.Name="{Binding Model.RunHelp}" ToolTip="{Binding Model.RunHelp}">
                    <TextBlock x:Name="runIcon" Text="{Binding Model.RunGlyph}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" />
          </DockPanel>
          <TextBox Grid.Row="1" Style="{StaticResource Field}" Text="{Binding Model.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="64"
                   AutomationProperties.Name="{Binding Model.Title}" Visibility="{Binding WideFull, Converter={StaticResource Visible}}" />
          <Border Grid.Row="2" Margin="0,6,0,0" CornerRadius="12" Background="{DynamicResource PromptWell}" BorderBrush="{DynamicResource PromptRim}" BorderThickness="1" ClipToBounds="True">
            <Grid Margin="6,0">
              <ui:TeleprompterView x:Name="reader" Script="{Binding Model.Text}" ScrollSpeed="{Binding Model.Speed}" Running="{Binding Model.Running}"
                                   ResetRequest="{Binding Model.ResetRequest}" ReducedMotion="{Binding Model.ReducedMotion}" FontSize="{Binding Model.TextSize}" FontFamily="{StaticResource Sans}" Foreground="{DynamicResource Fg}" Height="{Binding TeleHeight}" Margin="10,0" />
              <TextBox x:Name="compactEditor" Style="{StaticResource Field}" Text="{Binding Model.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="{StaticResource Sans}" FontSize="12" Padding="8,6"
                       AutomationProperties.Name="{Binding Model.Title}" Visibility="Collapsed" />
              <TextBlock x:Name="emptyHint" Text="{Binding Model.EmptyHint}" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
              <Border x:Name="readingGuideLeft" Width="2" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="1" Background="{DynamicResource On}" Margin="1,0,0,0" IsHitTestVisible="False" />
              <Border x:Name="readingGuideRight" Width="2" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="1" Background="{DynamicResource On}" Margin="0,0,1,0" IsHitTestVisible="False" />
              <Border x:Name="progressTrack" Height="3" VerticalAlignment="Bottom" CornerRadius="2" Background="{DynamicResource Track}"
                      Visibility="{Binding Model.HasText, Converter={StaticResource Visible}}">
                <Border Background="{DynamicResource On}" HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=progressTrack}" CornerRadius="2"
                        RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform><ScaleTransform ScaleX="{Binding Progress, ElementName=reader}" /></Border.RenderTransform>
                </Border>
              </Border>
            </Grid>
          </Border>
          <StackPanel x:Name="sliders" Grid.Row="3" Visibility="{Binding WideFull, Converter={StaticResource Visible}}" Margin="0,4,0,0">
            <DockPanel><TextBlock Text="{Binding Model.SpeedLabel}" Style="{StaticResource Hint}" /><ui:SeekBar Value="{Binding Model.SpeedFraction}" Command="{Binding Model.SetSpeed}" Width="110" AutomationProperties.Name="{Binding Model.SpeedLabel}" /></DockPanel>
            <DockPanel><TextBlock Text="{Binding Model.SizeLabel}" Style="{StaticResource Hint}" /><ui:SeekBar Value="{Binding Model.SizeFraction}" Command="{Binding Model.SetSize}" Width="110" AutomationProperties.Name="{Binding Model.SizeLabel}" /></DockPanel>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Full}" Value="True"><Setter TargetName="edit" Property="Visibility" Value="Collapsed" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.HasText}" Value="False"><Setter TargetName="emptyHint" Property="Visibility" Value="Visible" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.HasText}" Value="False"><Setter TargetName="progressBadge" Property="Visibility" Value="Collapsed" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.HasText}" Value="False"><Setter TargetName="readingGuideLeft" Property="Visibility" Value="Collapsed" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.HasText}" Value="False"><Setter TargetName="readingGuideRight" Property="Visibility" Value="Collapsed" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.Editing}" Value="True"><Setter TargetName="progressTrack" Property="Visibility" Value="Collapsed" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.Editing}" Value="True"><Setter TargetName="progressBadge" Property="Visibility" Value="Collapsed" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.Editing}" Value="True"><Setter TargetName="editIcon" Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.Editing}" Value="True"><Setter TargetName="edit" Property="Background" Value="{DynamicResource WarmSoft}" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.Editing}" Value="True"><Setter TargetName="stateDot" Property="Fill" Value="{DynamicResource Warm}" /><Setter TargetName="compactStateDot" Property="Fill" Value="{DynamicResource Warm}" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.Editing}" Value="True"><Setter TargetName="stateLabel" Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger>
        <DataTrigger Binding="{Binding Model.Editing}" Value="True"><Setter TargetName="statePill" Property="Background" Value="{DynamicResource WarmSoft}" /></DataTrigger>
        <DataTrigger Binding="{Binding Wide}" Value="True"><Setter TargetName="compactStateDot" Property="Visibility" Value="Collapsed" /><Setter TargetName="statePill" Property="Visibility" Value="Visible" /></DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Model.HasText}" Value="True" />
            <Condition Binding="{Binding Model.Editing}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="runIcon" Property="Foreground" Value="{DynamicResource Fg}" />
          <Setter TargetName="run" Property="Background" Value="{DynamicResource OnSoft}" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Model.Running}" Value="True" />
            <Condition Binding="{Binding Model.HasText}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="stateDot" Property="Fill" Value="{DynamicResource On}" />
          <Setter TargetName="compactStateDot" Property="Fill" Value="{DynamicResource On}" />
          <Setter TargetName="stateLabel" Property="Foreground" Value="{DynamicResource Fg}" />
          <Setter TargetName="statePill" Property="Background" Value="{DynamicResource OnSoft}" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Compact}" Value="True" />
            <Condition Binding="{Binding Model.Editing}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="reader" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="emptyHint" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="compactEditor" Property="Visibility" Value="Visible" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Compact}" Value="True" />
            <Condition Binding="{Binding Model.Editing}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="sliders" Property="Visibility" Value="Collapsed" />
        </MultiDataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Un día del mes: el de hoy en rojo (como el calendario de Droppy), un punto si tiene algo y un aro si es el elegido. -->
    <DataTemplate DataType="{x:Type ui:CalendarDay}">
      <Button Style="{StaticResource Plain}" Command="{Binding Pick}" Opacity="{Binding Alpha}" AutomationProperties.Name="{Binding Spoken}" ToolTip="{Binding Spoken}">
        <Border x:Name="day" Width="26" Height="26" Margin="1,0.5" HorizontalAlignment="Center" CornerRadius="13" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
          <Grid>
            <!-- Caja de línea fija y texto centrado: el número queda en el centro del círculo con cualquier cifra o escala. -->
            <TextBlock x:Name="num" Text="{Binding Text}" FontSize="12.5" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center"
                       LineHeight="14" LineStackingStrategy="BlockLineHeight" />
            <Ellipse x:Name="dot" Width="3" Height="3" Fill="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0.5" Visibility="Collapsed" />
          </Grid>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasItems}" Value="True">
          <Setter TargetName="dot" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Weekend}" Value="True">
          <Setter TargetName="num" Property="Foreground" Value="{DynamicResource Secondary}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="day" Property="BorderBrush" Value="{DynamicResource Fg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Today}" Value="True">
          <Setter TargetName="day" Property="Background" Value="#E5383B" />   <!-- el rojo de Droppy: más hondo que el coral del tema, para que el blanco se lea -->
          <Setter TargetName="num" Property="Foreground" Value="White" />
          <Setter TargetName="num" Property="FontWeight" Value="SemiBold" />
          <Setter TargetName="dot" Property="Fill" Value="White" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- La agenda: los días con algo, cada uno con su cabecera; los recordatorios con un aro naranja (se marcan hechos) y los eventos con una barra verde. -->
    <DataTemplate DataType="{x:Type ui:AgendaGroupRow}">
      <StackPanel Margin="0,0,0,8">
        <TextBlock Text="{Binding Header}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="2,0,0,4" TextTrimming="CharacterEllipsis" />
        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:AgendaRow}">
      <Border x:Name="card" CornerRadius="10" Padding="9,6" Margin="0,0,0,4" Background="{DynamicResource Track}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding Remove}" AutomationProperties.Name="{Binding RemoveHelp}" ToolTip="{Binding RemoveHelp}"
                  VerticalAlignment="Center" Visibility="{Binding Editable, Converter={StaticResource Visible}}">
            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{DynamicResource Muted}" Margin="6,0,0,0" />
          </Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource Bordered}" Command="{Binding Join}" AutomationProperties.Name="{Binding JoinHelp}" ToolTip="{Binding JoinHelp}"
                  Content="{Binding JoinLabel}" FontSize="10" Padding="7,3" VerticalAlignment="Center" Margin="4,0,0,0"
                  Visibility="{Binding HasMeeting, Converter={StaticResource Visible}}" />
          <Button DockPanel.Dock="Left" Style="{StaticResource Plain}" Command="{Binding Toggle}" AutomationProperties.Name="{Binding ToggleHelp}" ToolTip="{Binding ToggleHelp}" IsEnabled="{Binding Editable}"
                  VerticalAlignment="Center" Margin="0,0,9,0" Visibility="{Binding IsReminder, Converter={StaticResource Visible}}">
            <Grid Width="16" Height="16">
              <Ellipse Stroke="#F2994A" StrokeThickness="2" />
              <Ellipse x:Name="filled" Fill="#F2994A" Margin="4" Visibility="Collapsed" />
            </Grid>
          </Button>
          <Rectangle DockPanel.Dock="Left" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="#5CD66F" Margin="0,1,9,1" Visibility="{Binding IsEvent, Converter={StaticResource Visible}}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="title" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Opacity="{Binding TitleAlpha}" />
            <TextBlock Text="{Binding TimeText}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Muted}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Done}" Value="True">
          <Setter TargetName="filled" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsEvent}" Value="True">
          <Setter TargetName="card" Property="Background" Value="#26308A3C" />
          <Setter TargetName="title" Property="Foreground" Value="#A8EDB2" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Piezas del calendario, compartidas por sus vistas. DataContext: el reloj. -->
    <DataTemplate x:Key="CalendarHeader">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Plain}" Command="{Binding PrevMonth}" AutomationProperties.Name="{Binding PrevHelp}" ToolTip="{Binding PrevHelp}">
            <Border Width="28" Height="26" Background="Transparent"><TextBlock Text="&#xE76B;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          </Button>
          <Button Style="{StaticResource Plain}" Command="{Binding NextMonth}" AutomationProperties.Name="{Binding NextHelp}" ToolTip="{Binding NextHelp}">
            <Border Width="28" Height="26" Background="Transparent"><TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          </Button>
        </StackPanel>
        <Button Style="{StaticResource Plain}" Command="{Binding ThisMonth}" AutomationProperties.Name="{Binding TodayHelp}" ToolTip="{Binding TodayHelp}" HorizontalAlignment="Left" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding MonthTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Danger}" />
            <TextBlock Text="{Binding YearText}" FontSize="15" FontWeight="Light" Foreground="{DynamicResource Muted}" Margin="7,0,0,0" />
          </StackPanel>
        </Button>
      </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="CalendarMonth">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Weekdays}" Focusable="False" Foreground="{DynamicResource Muted}" FontSize="11.5">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Center" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Days}" Focusable="False" Margin="0,4,0,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <!-- Lo próximo, como una fila de la agenda -->
    <DataTemplate x:Key="CalendarNext">
      <Border CornerRadius="10" Padding="9,7" Background="{DynamicResource Track}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding HasCurrentEvent}" Value="False" />
                  <Condition Binding="{Binding HasNext}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <DockPanel Visibility="{Binding HasCurrentEvent, Converter={StaticResource Visible}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource Bordered}" Command="{Binding JoinCurrentMeeting}" Content="{Binding JoinLabel}"
                    AutomationProperties.Name="{Binding JoinLabel}" Visibility="{Binding HasCurrentMeeting, Converter={StaticResource Visible}}" Margin="8,0,0,0" />
            <ui:ActivityRing Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center" Progress="{Binding CurrentEventProgress}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding CurrentEventTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding CurrentEventRemaining}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </DockPanel>
          <DockPanel Visibility="{Binding HasNext, Converter={StaticResource Visible}}">
            <Grid Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center"><Ellipse Stroke="#F2994A" StrokeThickness="2" /></Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding NextTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding NextWhen}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Reloj y calendario. Una celda: la hora y la fecha, el mes con sus flechas y lo próximo; dos celdas con compañeros: la hora y lo próximo a un lado
         y el mes al otro; solo en su lista: el mes (con el «+» para añadir) a la izquierda y la agenda a la derecha, como en Droppy. En la vista
         corta, solo la hora, la fecha y lo próximo. -->
    <DataTemplate x:Key="WidgetClockWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" />
          <StackPanel Grid.Row="1" VerticalAlignment="Top">
          <StackPanel Visibility="{Binding CompactOrPeek, Converter={StaticResource Visible}}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <!-- La hora grande y, debajo, una barra fina con lo que lleva gastado el día -->
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Model.Time}" FontSize="31" FontWeight="SemiBold" LineHeight="34" />
                <ui:DayBar Margin="0,3,4,0" Progress="{Binding Model.DayProgress}" Moon="{Binding Model.MoonFraction}" ToolTip="{Binding Model.DayTooltip}" AutomationProperties.Name="{Binding Model.DayTooltip}" />
              </StackPanel>
              <!-- La fecha como una hoja de calendario: día de la semana en rojo, el número y el mes -->
              <Border Grid.Column="1" Margin="12,0,0,0" MinWidth="48" CornerRadius="11" Padding="9,5,9,6" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1"
                      ToolTip="{Binding Model.DateText}" AutomationProperties.Name="{Binding Model.DateText}">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="{Binding Model.WeekdayText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Model.DayNumberText}" FontSize="21" FontWeight="SemiBold" LineHeight="23" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Model.MonthText}" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
            <StackPanel Visibility="{Binding Peek, Converter={StaticResource Visible}}">
            <DockPanel Margin="0,7,0,0" Visibility="{Binding Model.HasNextText, Converter={StaticResource Visible}}">
              <TextBlock DockPanel.Dock="Left" Text="&#xE787;" FontFamily="{StaticResource Icons}" FontSize="10.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="1,1,7,0" />
              <TextBlock Text="{Binding Model.NextText}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding Full, Converter={StaticResource Visible}}" Margin="0,6,0,0">
              <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource CalendarHeader}" Margin="0,0,0,2" />
              <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource CalendarMonth}" />
              <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource CalendarNext}" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
          <Grid Visibility="{Binding WideFullCompanion, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding Model.Time}" FontSize="42" FontWeight="SemiBold" LineHeight="44" />
                <!-- El día entero en una barra (cielo, sol, luna real de hoy y «ahora») -->
                <ui:DayBar Margin="0,6,10,0" Progress="{Binding Model.DayProgress}" Moon="{Binding Model.MoonFraction}" ToolTip="{Binding Model.DayTooltip}" AutomationProperties.Name="{Binding Model.DayTooltip}" />
                <TextBlock Text="{Binding Model.WeekdayLong}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
                <TextBlock Text="{Binding Model.LongDateText}" Style="{StaticResource Hint}" />
                <!-- Tres fichas de cristal, sobrias: lo que va del año (anillo que se aclara a lo largo del recorrido), la semana (con sus siete días) y la luna de hoy -->
                <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding Full, Converter={StaticResource Visible}}">
                  <Border CornerRadius="13" Margin="0,0,4,0" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" ToolTip="{Binding Model.DayOfYearLabel}" AutomationProperties.Name="{Binding Model.DayOfYearLabel}">
                    <Grid>
                      <StackPanel HorizontalAlignment="Center" Margin="6,10,6,9">
                        <Grid Width="46" Height="46" HorizontalAlignment="Center">
                          <ui:ArcGauge Width="46" Height="46" Progress="{Binding Model.YearProgress}" />
                          <TextBlock Text="{Binding Model.YearDayText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Model.YearPercentText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Model.YearCaption}" FontSize="9.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border CornerRadius="13" Margin="2,0,2,0" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" ToolTip="{Binding Model.WeekLabel}" AutomationProperties.Name="{Binding Model.WeekLabel}">
                    <Grid>
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,10,6,9">
                        <TextBlock Text="{Binding Model.WeekNumberText}" FontSize="34" FontWeight="SemiBold" LineHeight="38" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Model.WeekCaption}" FontSize="9.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding Model.WeekDots}" HorizontalAlignment="Center" Margin="0,8,0,0" Focusable="False">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="1.5,0" Width="8">
                                <Ellipse x:Name="dot" Width="6" Height="6" Fill="{DynamicResource Track}" Stroke="{DynamicResource Muted}" StrokeThickness="0.8" />
                                <TextBlock Text="{Binding Letter}" FontSize="7" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                              </StackPanel>
                              <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Past}" Value="True"><Setter TargetName="dot" Property="Fill" Value="{DynamicResource Secondary}" /><Setter TargetName="dot" Property="Stroke" Value="Transparent" /></DataTrigger>
                                <DataTrigger Binding="{Binding Today}" Value="True"><Setter TargetName="dot" Property="Fill" Value="#E5383B" /><Setter TargetName="dot" Property="Stroke" Value="Transparent" /></DataTrigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border CornerRadius="13" Margin="4,0,0,0" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" ToolTip="{Binding Model.MoonLabel}" AutomationProperties.Name="{Binding Model.MoonLabel}">
                    <Grid>
                      <StackPanel HorizontalAlignment="Center" Margin="4,10,4,9">
                        <ui:MoonDisc Phase="{Binding Model.MoonFraction}" Width="46" Height="46" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Model.MoonPercentText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Model.MoonName}" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="80" />
                        <TextBlock Text="{Binding Model.MoonNextText}" FontSize="8.5" Foreground="{DynamicResource Muted}" Opacity="0.75" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="80" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </UniformGrid>
                <TextBlock Text="{Binding Model.NextText}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding Peek, Converter={StaticResource Visible}}" />
              </StackPanel>
              <ContentControl Grid.Row="2" Content="{Binding Model}" ContentTemplate="{StaticResource CalendarNext}" Margin="0,12,0,0" VerticalAlignment="Bottom" Visibility="{Binding Full, Converter={StaticResource Visible}}" />
            </Grid>
            <StackPanel Grid.Column="1" Width="272" Margin="22,0,0,0" Visibility="{Binding Full, Converter={StaticResource Visible}}">
              <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource CalendarHeader}" Margin="0,0,0,6" />
              <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource CalendarMonth}" />
            </StackPanel>
          </Grid>
          <!-- Solo en su lista -->
          <Grid Visibility="{Binding WideAlone, Converter={StaticResource Visible}}" MinHeight="250">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource CalendarHeader}" />
              </DockPanel>
              <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource CalendarMonth}" />
            </StackPanel>
            <Grid Grid.Column="2">
              <TextBlock Text="{Binding Model.EmptyText}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="{Binding Model.NoAgenda, Converter={StaticResource Visible}}" />
              <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding Model.HasAgenda, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Model.AgendaGroups}" Focusable="False" />
              </ScrollViewer>
              <!-- Añadir un recordatorio: texto, la regla para el día y la hora, como en Droppy -->
              <Border VerticalAlignment="Top" CornerRadius="14" Padding="10" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1"
                      Visibility="{Binding Model.AdderOpen, Converter={StaticResource Visible}}">
                <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" /></Border.Effect>
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding Model.Add}" AutomationProperties.Name="{Binding Model.AddSend}" ToolTip="{Binding Model.AddSend}" Margin="8,0,0,0" VerticalAlignment="Center">
                      <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Fg}"><TextBlock Text="&#xE74A;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    </Button>
                    <Grid>
                      <TextBox Style="{StaticResource Field}" Text="{Binding Model.NewTitle, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" Padding="8,4" AutomationProperties.Name="{Binding Model.TitleHint}" />
                      <TextBlock Text="{Binding Model.TitleHint}" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Model.NewTitle}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </DockPanel>
                  <ui:RulerPicker Margin="0,10,0,0" Offset="{Binding Model.NewOffset, Mode=TwoWay}" AutomationProperties.Name="{Binding Model.RulerHelp}" ToolTip="{Binding Model.RulerHelp}" />
                  <TextBlock Text="{Binding Model.NewDayText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                  <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Bordered}" Content="{Binding Model.DoneLabel}" Command="{Binding Model.Add}" AutomationProperties.Name="{Binding Model.DoneLabel}" />
                    <TextBox Style="{StaticResource Field}" Text="{Binding Model.NewTime, UpdateSourceTrigger=PropertyChanged}" Width="76" MinHeight="28" Padding="8,4" HorizontalAlignment="Left"
                             FontFamily="{StaticResource Mono}" AutomationProperties.Name="{Binding Model.TimeHelp}" ToolTip="{Binding Model.TimeHelp}" />
                  </DockPanel>
                  <TextBlock Text="{Binding Model.Hint}" FontSize="11" Foreground="{DynamicResource Warm}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding Model.HasHint, Converter={StaticResource Visible}}" />
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Pomodoro: con dos celdas, el tiempo, la barra y los botones en una sola fila. -->
    <!-- Los controles del Pomodoro: reiniciar, el botón grande de iniciar o pausar (macizo, del color del texto) y saltar de fase. DataContext: el widget. -->
    <!-- Píldora de modo del Pomodoro (Nusa): gris oscuro y, el modo activo, gris medio. Content: el icono y el texto. -->
    <Style x:Key="PomoPill" TargetType="Button" BasedOn="{StaticResource Plain}">
      <Setter Property="Background" Value="#181818" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="pill" Height="28" CornerRadius="14" Padding="8,0" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pill" Property="Opacity" Value="0.85" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="PomodoroTransport">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Plain}" Command="{Binding Restart}" AutomationProperties.Name="{Binding ResetHelp}" ToolTip="{Binding ResetHelp}" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="15" Background="#191919">
            <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M18,6 A8.5,8.5 0 1 1 7.7,4.6 M4,4.2 L7.7,4.6 L6.2,8" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
          </Border>
        </Button>
        <Button Style="{StaticResource PomoPill}" Command="{Binding BreakMode}" Background="{Binding BreakFill}" Margin="8,0,0,0" Height="30" AutomationProperties.Name="{Binding BreakModeText}" ToolTip="{Binding BreakModeText}">
          <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M3.5,8.5 H14.5 V16.5 A3,3 0 0 1 11.5,19.5 H6.5 A3,3 0 0 1 3.5,16.5 Z M14.5,10.5 H18.2 V15 H14.5 M7,2.2 L7.8,5 M10.6,2.2 L11.4,5" Stroke="White" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
        </Button>
        <Button Style="{StaticResource PomoPill}" Command="{Binding Toggle}" Background="#FE4D4E" MinWidth="58" Margin="8,0" Height="30" AutomationProperties.Name="{Binding ToggleHelp}" ToolTip="{Binding ToggleHelp}">
          <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="{Binding ToggleIcon}" Fill="White" Stroke="White" StrokeThickness="1" StrokeLineJoin="Round" /></Canvas></Viewbox>
        </Button>
        <Button Style="{StaticResource PomoPill}" Command="{Binding FocusMode}" Background="{Binding FocusFill}" Height="30" AutomationProperties.Name="{Binding FocusModeText}" ToolTip="{Binding FocusModeText}">
          <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M21.4,12 A9.4,9.4 0 1 1 2.6,12 A9.4,9.4 0 1 1 21.4,12 Z M17,12 A5,5 0 1 1 7,12 A5,5 0 1 1 17,12 Z M12,12 L20.5,3.5" Stroke="White" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
        </Button>
      </StackPanel>
    </DataTemplate>
    <!-- Los cuatro puntos del ciclo: hechos macizos, el de ahora con aro y los demás vacíos. DataContext: el widget. -->
    <DataTemplate x:Key="PomodoroDots">
      <ItemsControl ItemsSource="{Binding Dots}" Focusable="False" HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Width="14" Height="14" Margin="0,0,4,0">
              <Ellipse x:Name="body" Width="9" Height="9" Fill="{DynamicResource Track}" />
              <Ellipse x:Name="ring" Width="14" Height="14" Stroke="{DynamicResource Fg}" StrokeThickness="1.4" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Done}" Value="True"><Setter TargetName="body" Property="Fill" Value="{DynamicResource Fg}" /></DataTrigger>
              <!-- La etapa actual es el mismo punto, más grande y con un agujero: una dona -->
              <DataTrigger Binding="{Binding Current}" Value="True"><Setter TargetName="body" Property="Width" Value="12" /><Setter TargetName="body" Property="Height" Value="12" /><Setter TargetName="body" Property="Fill" Value="Transparent" /><Setter TargetName="body" Property="Stroke" Value="{DynamicResource Fg}" /><Setter TargetName="body" Property="StrokeThickness" Value="3.2" /></DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
    <!-- La fase como una pastilla: «Enfoque» o «Descanso». -->
    <DataTemplate x:Key="PomodoroChip">
      <Border CornerRadius="9" Padding="9,2" Background="{DynamicResource Track}" HorizontalAlignment="Left">
        <TextBlock Text="{Binding PhaseLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" />
      </Border>
    </DataTemplate>


    <DataTemplate x:Key="WidgetPomodoroWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <!-- Vista corta con el widget solo (como en Nusa, medido de sus fotogramas): lienzo de 420 px con el origen en el borde del notch; los colores son fijos, no del tema. Alto 90 y no 96: los botones acaban en 82 y así los puntos de página quedan a unos 10 px, como en los demás widgets -->
          <Canvas Visibility="{Binding NusaPeek, Converter={StaticResource Visible}}" Width="420" Height="90" HorizontalAlignment="Center" Margin="{Binding NusaInset}">
            <TextBlock Text="{Binding Model.Title}" Canvas.Left="15" Canvas.Top="-29.2" FontSize="15" FontWeight="SemiBold" Foreground="White" />
            <!-- El disco: aro de 6,5 px con degradado de coral a rojo y resplandor, fondo negro -->
            <Ellipse Canvas.Left="45.75" Canvas.Top="1" Width="70" Height="70" Fill="Black" StrokeThickness="6.5">
              <Ellipse.Stroke><LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1"><GradientStop Color="#FA6358" Offset="0" /><GradientStop Color="#F23A55" Offset="1" /></LinearGradientBrush></Ellipse.Stroke>
              <Ellipse.Effect><DropShadowEffect Color="#FF6A66" BlurRadius="11" ShadowDepth="0" Opacity="0.9" /></Ellipse.Effect>
            </Ellipse>
            <Viewbox Canvas.Left="55.15" Canvas.Top="10" Width="49.5" Height="49.5" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Data="M9.7,3.2 H14.3 M12,3.2 V6 M12,14 V8.4 M17.9,8.1 L19.9,6.1 M20,14 A8,8 0 1 1 4,14 A8,8 0 1 1 20,14 Z" Stroke="White" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
            <TextBlock Canvas.Left="145" Canvas.Top="-7.7" Width="240" Text="{Binding Model.Remaining}" FontSize="30" FontWeight="Bold" Foreground="White" TextAlignment="Center" />
            <Button Style="{StaticResource Plain}" Canvas.Left="318" Canvas.Top="0.2" Command="{Binding Model.Restart}" AutomationProperties.Name="{Binding Model.ResetHelp}" ToolTip="{Binding Model.ResetHelp}">
              <Border Width="23" Height="23" CornerRadius="11.5" Background="#191919">
                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M18,6 A8.5,8.5 0 1 1 7.7,4.6 M4,4.2 L7.7,4.6 L6.2,8" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
              </Border>
            </Button>
            <TextBlock Canvas.Left="145" Canvas.Top="30.3" Width="240" Text="{Binding Model.PhaseLabel}" FontSize="12" Foreground="#A1A1A1" TextAlignment="Center" />
            <Grid Canvas.Left="94" Canvas.Top="54" Width="340" Height="28">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource PomoPill}" Command="{Binding Model.BreakMode}" Background="{Binding Model.BreakFill}" AutomationProperties.Name="{Binding Model.BreakModeText}" ToolTip="{Binding Model.BreakModeText}">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M3.5,8.5 H14.5 V16.5 A3,3 0 0 1 11.5,19.5 H6.5 A3,3 0 0 1 3.5,16.5 Z M14.5,10.5 H18.2 V15 H14.5 M7,2.2 L7.8,5 M10.6,2.2 L11.4,5" Stroke="White" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                    <TextBlock Text="{Binding Model.BreakModeText}" FontSize="10" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource PomoPill}" Command="{Binding Model.Toggle}" AutomationProperties.Name="{Binding Model.ToggleHelp}" ToolTip="{Binding Model.ToggleHelp}" Margin="8,0" MinWidth="53" Background="#FE4D4E">
                  <Viewbox Width="13.5" Height="13.5"><Canvas Width="24" Height="24"><Path Data="{Binding Model.ToggleIcon}" Fill="White" Stroke="White" StrokeThickness="1" StrokeLineJoin="Round" /></Canvas></Viewbox>
                </Button>
                <Button Style="{StaticResource PomoPill}" Command="{Binding Model.FocusMode}" Background="{Binding Model.FocusFill}" AutomationProperties.Name="{Binding Model.FocusModeText}" ToolTip="{Binding Model.FocusModeText}">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M21.4,12 A9.4,9.4 0 1 1 2.6,12 A9.4,9.4 0 1 1 21.4,12 Z M17,12 A5,5 0 1 1 7,12 A5,5 0 1 1 17,12 Z M12,12 L20.5,3.5" Stroke="White" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                    <TextBlock Text="{Binding Model.FocusModeText}" FontSize="10" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Canvas>
        <Grid Visibility="{Binding NotNusaPeek, Converter={StaticResource Visible}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" />
          <!-- Una celda: la hora y el botón de iniciar, la fase con los puntos del ciclo y la barra -->
          <Grid Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding CompactFlat, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.RowSpan="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="{Binding Model.Remaining}" FontSize="34" FontWeight="SemiBold" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
              <ContentControl Grid.Row="1" Content="{Binding Model}" ContentTemplate="{StaticResource PomodoroChip}" VerticalAlignment="Bottom" Margin="0,6,0,0" />
              <!-- El botón de iniciar va centrado justo encima de los cuatro puntos del ciclo -->
              <StackPanel Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Style="{StaticResource Plain}" Command="{Binding Model.Toggle}" AutomationProperties.Name="{Binding Model.ToggleHelp}" ToolTip="{Binding Model.ToggleHelp}" HorizontalAlignment="Center">
                  <Border Width="40" Height="40" CornerRadius="20" Background="#FE4D4E">
                    <Path Data="{Binding Model.ToggleShape}" Fill="White" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Button>
                <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource PomodoroDots}" HorizontalAlignment="Center" Margin="0,8,0,0" />
              </StackPanel>
            </Grid>
            <ui:MemoryBar Grid.Row="2" Margin="0,9,0,0" Height="6" Used="{Binding Model.Progress}" />
          </Grid>
          <!-- Dos celdas en una fila: la hora y la fase a la izquierda, la barra con los puntos en medio y los controles a la derecha -->
          <Grid Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding WideFlat, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Model.Remaining}" FontSize="40" FontWeight="SemiBold" FontFamily="{StaticResource Mono}" />
              <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource PomodoroChip}" Margin="2,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0">
              <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Model.SessionText}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource PomodoroDots}" VerticalAlignment="Center" />
              </DockPanel>
              <ui:MemoryBar Height="6" Used="{Binding Model.Progress}" />
            </StackPanel>
            <ContentControl Grid.Column="2" Content="{Binding Model}" ContentTemplate="{StaticResource PomodoroTransport}" VerticalAlignment="Center" />
          </Grid>
          <!-- Una celda y dos filas: el anillo con la hora dentro, los puntos y los controles -->
          <Grid Grid.Row="1" Margin="0,0,0,4" Visibility="{Binding CompactTall, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Viewbox Stretch="Uniform" MaxHeight="170" Margin="6,0,6,6">
              <Grid Width="120" Height="120">
                <ui:ArcGauge Width="120" Height="120" Progress="{Binding Model.Progress}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding Model.Remaining}" FontSize="25" FontWeight="SemiBold" FontFamily="{StaticResource Mono}" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Model.PhaseLabel}" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Viewbox>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,8">
              <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource PomodoroDots}" HorizontalAlignment="Center" />
            </StackPanel>
            <ContentControl Grid.Row="2" Content="{Binding Model}" ContentTemplate="{StaticResource PomodoroTransport}" HorizontalAlignment="Center" />
          </Grid>
          <!-- Dos celdas y dos filas: el anillo a un lado; al otro, la sesión, los puntos, la frase de la fase y los controles -->
          <Grid Grid.Row="1" Margin="0,0,0,4" Visibility="{Binding WideTall, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Viewbox Stretch="Uniform" MaxHeight="220" Margin="8,0,16,6">
              <Grid Width="120" Height="120">
                <ui:ArcGauge Width="120" Height="120" Progress="{Binding Model.Progress}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding Model.Remaining}" FontSize="25" FontWeight="SemiBold" FontFamily="{StaticResource Mono}" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Model.PhaseLabel}" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Viewbox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,30,0" MinWidth="190">
              <TextBlock Text="{Binding Model.SessionText}" FontSize="22" FontWeight="SemiBold" />
              <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource PomodoroDots}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding Model.PhaseHint}" Style="{StaticResource Hint}" Margin="0,8,0,16" TextWrapping="Wrap" MaxWidth="200" />
              <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource PomodoroTransport}" HorizontalAlignment="Left" />
            </StackPanel>
          </Grid>
        </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="WidgetStayAwakeWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" />
          <Grid Grid.Row="0" Grid.RowSpan="2" MinHeight="82" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="62" Height="62" VerticalAlignment="Center">
              <Ellipse x:Name="awakeHalo" Width="58" Height="58" Fill="{DynamicResource Track}" Stroke="{DynamicResource Line}" StrokeThickness="1.3" />
              <Path x:Name="awakeGlyph" Data="M 5.1,5.2 A 8,8 0 1 0 14.9,5.2 M 10,2 V 10.5" Stroke="{DynamicResource Muted}" StrokeThickness="2.3"
                    Width="25" Height="25" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Ellipse x:Name="awakeIndicator" Width="9" Height="9" Fill="{DynamicResource Muted}" Stroke="{DynamicResource Bg}" StrokeThickness="1.5"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
              <TextBlock Text="{Binding Model.StateTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
              <TextBlock Text="{Binding Model.State}" Style="{StaticResource Hint}" Foreground="{DynamicResource Secondary}" Margin="0,3,0,0" />
              <TextBlock Text="{Binding Model.ToggleHelp}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource On}" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
            <Rectangle Grid.Column="2" Width="1" Fill="{DynamicResource Line}" Margin="0,12,12,12" VerticalAlignment="Stretch" />
            <ui:BrandSwitch Grid.Column="3" IsOn="{Binding Model.On, Mode=OneWay}" Command="{Binding Model.Toggle}"
                            AutomationProperties.Name="{Binding Model.ToggleHelp}" ToolTip="{Binding Model.ToggleHelp}" Margin="0,0,2,0">
              <ui:BrandSwitch.LayoutTransform><ScaleTransform ScaleX="1.25" ScaleY="1.25" /></ui:BrandSwitch.LayoutTransform>
            </ui:BrandSwitch>
          </Grid>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Model.On}" Value="True">
          <Setter TargetName="awakeHalo" Property="Fill" Value="{DynamicResource OnSoft}" />
          <Setter TargetName="awakeHalo" Property="Stroke" Value="{DynamicResource On}" />
          <Setter TargetName="awakeGlyph" Property="Stroke" Value="{DynamicResource On}" />
          <Setter TargetName="awakeIndicator" Property="Fill" Value="{DynamicResource On}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Model.Failed}" Value="True">
          <Setter TargetName="awakeHalo" Property="Fill" Value="{DynamicResource DangerSoft}" />
          <Setter TargetName="awakeHalo" Property="Stroke" Value="{DynamicResource Danger}" />
          <Setter TargetName="awakeGlyph" Property="Stroke" Value="{DynamicResource Danger}" />
          <Setter TargetName="awakeIndicator" Property="Fill" Value="{DynamicResource Danger}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Equipo: la tubería de pasos (quién, qué, cómo va) en tres vistas elegibles en Ajustes — Tubería (nodos), Línea de tiempo (barras) y Mesa de
         equipo (retratos) — cada una con su versión de una celda (anillo, barras finas, fila de retratos). Alrededor, tarjetas con jerarquía:
         la Tarea (lo que se pide), el Plan (quién hace qué y cómo va) y el Resultado (con lo que se hace después), y las pestañas de Historial
         y Programadas. Botones en cuatro niveles: principal (relleno), secundario (cristal), discreto (sin fondo) y de peligro (coral). -->

    <!-- BOTONES: base con icono opcional (Tag = glifo de Segoe Fluent Icons) y texto opcional (Content). -->
    <Style x:Key="TeamBtn" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Track}" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="{StaticResource Sans}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}" MinWidth="{TemplateBinding MinWidth}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ico" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="11.5" Margin="0,0,7,0" MinWidth="14" TextAlignment="Center" VerticalAlignment="Center" />
                <ContentPresenter x:Name="txt" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="ico" Property="Visibility" Value="Collapsed" /></Trigger>
              <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="ico" Property="Margin" Value="0" />
                <Setter TargetName="txt" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.8" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonHover}" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- Principal: la acción que importa de cada bloque (una por bloque). -->
    <Style x:Key="TeamBtnPrimary" TargetType="Button" BasedOn="{StaticResource TeamBtn}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- Discreto: acciones de apoyo, sin fondo hasta que se señalan. -->
    <Style x:Key="TeamBtnGhost" TargetType="Button" BasedOn="{StaticResource TeamBtn}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Track}" />
          <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Peligro: lo que no se deshace, en coral y sin llamar la atención antes de tiempo. -->
    <Style x:Key="TeamBtnDanger" TargetType="Button" BasedOn="{StaticResource TeamBtn}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DangerSoft}" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- Solo icono (cuadrado). -->
    <Style x:Key="TeamBtnIcon" TargetType="Button" BasedOn="{StaticResource TeamBtn}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Track}" />
          <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TeamBtnIconDanger" TargetType="Button" BasedOn="{StaticResource TeamBtnIcon}">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
          <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- TARJETAS: tres niveles. Tarjeta (bloque), hueco (lo que va dentro de una tarjeta) y pastilla (dato corto). -->
    <Style x:Key="TeamCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource CardFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="TeamInset" TargetType="Border">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource Track}" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style x:Key="TeamChipBox" TargetType="Border">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,5,5" />
      <Setter Property="Background" Value="{DynamicResource Track}" />
    </Style>
    <Style x:Key="TeamEyebrow" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TeamMeta" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TeamStateGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Icons}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Running}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger>
        <DataTrigger Binding="{Binding Done}" Value="True"><Setter Property="Foreground" Value="{DynamicResource On}" /></DataTrigger>
        <DataTrigger Binding="{Binding Concern}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger>
        <DataTrigger Binding="{Binding Failed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- El hilo de la tubería: apagado, encendido (azul) o a medias. -->
    <Style x:Key="TeamWire" TargetType="Border">
      <Setter Property="Height" Value="2" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource MutedHalf}" />
    </Style>

    <!-- Día de la semana elegible (formulario de una programada). -->
    <Style x:Key="TeamDayToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bg" CornerRadius="8" Background="{DynamicResource Track}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
              <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="bg" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource OnAccent}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.92" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TeamAgentButton" TargetType="Button" BasedOn="{StaticResource Plain}">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    </Style>

    <!-- ICONOS EN TRAZO: más gruesos que los de la fuente de iconos, con extremos redondeados; toman el color del botón que los lleva. -->
    <Style x:Key="TeamStroke" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="TeamIconPlus" TargetType="Path" BasedOn="{StaticResource TeamStroke}">
      <Setter Property="Data" Value="M 0,5.5 L 11,5.5 M 5.5,0 L 5.5,11" />
      <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style x:Key="TeamIconClose" TargetType="Path" BasedOn="{StaticResource TeamStroke}">
      <Setter Property="Data" Value="M 0,0 L 7,7 M 7,0 L 0,7" />
      <Setter Property="StrokeThickness" Value="1.8" />
    </Style>
    <Style x:Key="TeamIconChevron" TargetType="Path" BasedOn="{StaticResource TeamStroke}">
      <Setter Property="Data" Value="M 0,0 L 2.9,2.9 L 5.8,0" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>
    <Style x:Key="TeamIconArrowUp" TargetType="Path" BasedOn="{StaticResource TeamStroke}">
      <Setter Property="Data" Value="M 5,11 L 5,1 M 0.8,5.2 L 5,1 L 9.2,5.2" />
      <Setter Property="StrokeThickness" Value="2.2" />
    </Style>

    <!-- CAJA DE LA TAREA (estilo «barra de prompt»): campo redondeado con el texto arriba y, debajo, + (adjuntar), reparto, esfuerzo
         (tacómetro) y enviar. Todo con los recursos del tema. -->
    <Style x:Key="TeamPromptField" TargetType="Border">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{DynamicResource PromptWell}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PromptRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TeamPromptText" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="FontFamily" Value="{StaticResource Sans}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="MaxHeight" Value="150" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="Transparent"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" /></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Reparto como pastilla con flecha; su lista se abre hacia arriba. -->
    <Style x:Key="TeamPillCombo" TargetType="ComboBox" BasedOn="{StaticResource GlassComboBox}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
              <ToggleButton x:Name="pill" Focusable="True" ClickMode="Press" MinHeight="28" Background="Transparent"
                            AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                            FocusVisualStyle="{StaticResource FocusRing}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="8" Padding="8,0,6,0" MinHeight="28" TextElement.Foreground="{DynamicResource Secondary}" TextElement.FontSize="12" TextElement.FontWeight="Medium">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentPresenter IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                        <Path Style="{StaticResource TeamIconChevron}" Stroke="{DynamicResource Secondary}" Margin="6,1.5,0,0" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource CardFill}" /></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource CardFill}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Top" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                     PlacementTarget="{Binding ElementName=pill}" IsOpen="{TemplateBinding IsDropDownOpen}">
                <Grid MinWidth="176" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" Margin="0,0,0,6">
                  <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" CornerRadius="10" Padding="3">
                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.4" /></Border.Effect>
                  </Border>
                  <ScrollViewer Margin="3" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" SnapsToDevicePixels="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Grid>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Enviar: listo = tinta del tema con la flecha del fondo (como la pestaña elegida); sin poder enviar = cuadro tenue. -->
    <Style x:Key="TeamSendTile" TargetType="Button" BasedOn="{StaticResource TeamBtn}">
      <Setter Property="Background" Value="{DynamicResource Fg}" />
      <Setter Property="Foreground" Value="{DynamicResource Bg}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="28" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88" /></Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="Background" Value="{DynamicResource Track}" />
          <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Botón del esfuerzo: el tacómetro y, si cabe, el nivel. -->
    <Style x:Key="TeamEffortToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
      <Setter Property="FontFamily" Value="{StaticResource Sans}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bg" Background="Transparent" CornerRadius="8" Padding="6,0,8,0" MinHeight="28">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource CardFill}" /></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource CardFill}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Deslizador del esfuerzo: pastilla con una barra que se llena y un tirador. Es un Slider de verdad (teclado y lectores). -->
    <Style x:Key="TeamSliderFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"><Border x:Name="fill" Height="22" CornerRadius="11,0,0,11" Opacity="0.9"
                                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" /></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TeamSliderRest" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" Height="28" /></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TeamSliderThumb" TargetType="Thumb">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border CornerRadius="7" Background="{DynamicResource Fg}" BorderBrush="{DynamicResource Bg}" BorderThickness="1">
              <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.35" /></Border.Effect>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TeamEffortSlider" TargetType="Slider">
      <Setter Property="Foreground" Value="{DynamicResource On}" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="SmallChange" Value="1" />
      <Setter Property="LargeChange" Value="1" />
      <Setter Property="TickFrequency" Value="1" />
      <Setter Property="IsSnapToTickEnabled" Value="True" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="30">
              <Border Height="22" CornerRadius="11" Background="{DynamicResource Track}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" VerticalAlignment="Center" />
              <Ellipse Width="4" Height="4" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="9,0,0,0" />
              <Ellipse Width="4" Height="4" Fill="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,0,9,0" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TeamSliderFill}" /></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource TeamSliderThumb}" /></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TeamSliderRest}" /></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Value" Value="0"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Trigger>
        <Trigger Property="Value" Value="4"><Setter Property="Foreground" Value="{DynamicResource Warm}" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- Una imagen adjunta: miniatura, nombre y quitar. -->
    <DataTemplate x:Key="TeamAttachmentChip">
      <Grid Width="40" Height="40" Margin="0,0,7,0" ToolTip="{Binding Name}">
        <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Track}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" ClipToBounds="True"
                HorizontalAlignment="Left" VerticalAlignment="Bottom">
          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Name}"><Image.Clip><RectangleGeometry Rect="0,0,34,34" RadiusX="8" RadiusY="8" /></Image.Clip></Image>
        </Border>
        <Button Command="{Binding Remove}" Style="{StaticResource Plain}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="18" Height="18" Cursor="Hand"
                ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}">
          <Grid>
            <Ellipse Fill="{DynamicResource Bg}" Stroke="{DynamicResource Muted}" StrokeThickness="1" />
            <Path Style="{StaticResource TeamIconClose}" Stroke="{DynamicResource Fg}" />
          </Grid>
        </Button>
      </Grid>
    </DataTemplate>

    <!-- Insignia pequeña para la vista corta. -->
    <DataTemplate x:Key="TeamPeekBadge">
      <ui:TeamAgentBadge Width="24" Height="24" Margin="0,0,5,0" Agent="{Binding Agent}" State="{Binding State}" Concern="{Binding Concern}" Animated="{Binding Running}"
                         Motion="{Binding DataContext.Model.Motion, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         ToolTip="{Binding Help}" AutomationProperties.Name="{Binding NodeName}" />
    </DataTemplate>

    <!-- Tubería, vista ancha: un nodo por paso, unidos por el hilo que se enciende al avanzar. -->
    <DataTemplate x:Key="TeamPipelineNode">
      <Border x:Name="cell" CornerRadius="14" Padding="0,6,0,5" Margin="2,0" Background="Transparent">
        <StackPanel ToolTip="{Binding Help}" AutomationProperties.Name="{Binding NodeName}" Focusable="False">
          <Grid Height="46">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:TeamWire Grid.Column="0" Lit="{Binding LeftLit}" Motion="{Binding DataContext.Model.Motion, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
              <ui:TeamWire.Style>
                <Style TargetType="ui:TeamWire"><Style.Triggers><DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger></Style.Triggers></Style>
              </ui:TeamWire.Style>
            </ui:TeamWire>
            <ui:TeamWire Grid.Column="2" Lit="{Binding RightLit}" Flow="{Binding Running}" Motion="{Binding DataContext.Model.Motion, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
              <ui:TeamWire.Style>
                <Style TargetType="ui:TeamWire"><Style.Triggers><DataTrigger Binding="{Binding IsLast}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger></Style.Triggers></Style>
              </ui:TeamWire.Style>
            </ui:TeamWire>
            <Grid Grid.Column="1" Width="46" Height="46">
              <ui:TeamHalo Spin="{Binding Running}" Motion="{Binding DataContext.Model.Motion, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
              <Button Command="{Binding Cycle}" Style="{StaticResource TeamAgentButton}" IsEnabled="{Binding CanChange}" ToolTip="{Binding ChangeHelp}"
                      AutomationProperties.Name="{Binding ChangeHelp}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:TeamAgentBadge Width="38" Height="38" Agent="{Binding Agent}" State="{Binding State}" Concern="{Binding Concern}" Animated="{Binding Running}"
                                   Motion="{Binding DataContext.Model.Motion, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
              </Button>
            </Grid>
          </Grid>
          <TextBlock Text="{Binding RoleName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
          <Button Command="{Binding CycleModel}" Style="{StaticResource Plain}" HorizontalAlignment="Center" IsEnabled="{Binding CanChange}" ToolTip="{Binding ModelHelp}"
                  AutomationProperties.Name="{Binding ModelHelp}" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}">
            <TextBlock FontSize="9.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="110" HorizontalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding AgentName}" />
                  <Style.Triggers><DataTrigger Binding="{Binding HasModel}" Value="True"><Setter Property="Text" Value="{Binding ModelName}" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Button>
          <TextBlock Text="{Binding TimeText}" Style="{StaticResource MonoSmall}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Running}" Value="True"><Setter TargetName="cell" Property="Background" Value="{DynamicResource AccentSoft}" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TeamPipelineWide">
      <ItemsControl ItemsSource="{Binding Model.Steps}" ItemTemplate="{StaticResource TeamPipelineNode}" Focusable="False" Margin="0,10,0,2">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>

    <!-- Tubería, una celda: un anillo con un arco por paso alrededor del agente que trabaja. -->
    <DataTemplate x:Key="TeamPipelineCompact">
      <Grid Width="84" Height="84" HorizontalAlignment="Center" Margin="0,8,0,2">
        <ui:TeamRing Width="84" Height="84" Segments="{Binding Model.Segments}" Animated="{Binding Model.Working}" Motion="{Binding Model.Motion}" />
        <ui:TeamAgentBadge Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding Model.Focus}"
                           Agent="{Binding Agent}" State="{Binding State}" Concern="{Binding Concern}" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding NodeName}" />
      </Grid>
    </DataTemplate>

    <!-- Línea de tiempo, vista ancha: una fila por paso con su barra, su tiempo y sus tokens. -->
    <DataTemplate x:Key="TeamTimelineRow">
      <Grid Margin="0,3" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding NodeName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38" /><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /><ColumnDefinition Width="96" /><ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <Button Command="{Binding Cycle}" Style="{StaticResource TeamAgentButton}" IsEnabled="{Binding CanChange}" ToolTip="{Binding ChangeHelp}" AutomationProperties.Name="{Binding ChangeHelp}" HorizontalAlignment="Left">
          <ui:TeamAgentBadge Width="24" Height="24" Agent="{Binding Agent}" State="{Binding State}" Concern="{Binding Concern}" Animated="{Binding Running}"
                             Motion="{Binding DataContext.Model.Motion, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding RoleName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
          <Button Command="{Binding CycleModel}" Style="{StaticResource Plain}" HorizontalAlignment="Left" IsEnabled="{Binding CanChange}" ToolTip="{Binding ModelHelp}"
                  AutomationProperties.Name="{Binding ModelHelp}" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}">
            <TextBlock FontSize="9.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="92">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding AgentName}" />
                  <Style.Triggers><DataTrigger Binding="{Binding HasModel}" Value="True"><Setter Property="Text" Value="{Binding ModelName}" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Button>
        </StackPanel>
        <ui:TeamTrack Grid.Column="2" Height="8" VerticalAlignment="Center" Margin="4,0,10,0" Fraction="{Binding Fraction}" Animated="{Binding Running}"
                      Motion="{Binding DataContext.Model.Motion, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        <TextBlock Grid.Column="3" Text="{Binding TimeText}" Style="{StaticResource MonoSmall}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="4" Text="{Binding TokensText}" Style="{StaticResource MonoSmall}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="5" Text="{Binding Glyph}" Style="{StaticResource TeamStateGlyph}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding StateText}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TeamTimelineWide">
      <ItemsControl ItemsSource="{Binding Model.Steps}" ItemTemplate="{StaticResource TeamTimelineRow}" Focusable="False" Margin="0,8,0,0" />
    </DataTemplate>

    <DataTemplate x:Key="TeamTimelineMini">
      <Grid Margin="0,2" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding NodeName}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <ui:TeamAgentBadge Width="20" Height="20" HorizontalAlignment="Left" Agent="{Binding Agent}" State="{Binding State}" Concern="{Binding Concern}" Animated="{Binding Running}"
                           Motion="{Binding DataContext.Model.Motion, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        <TextBlock Grid.Column="1" Text="{Binding RoleName}" FontSize="10.5" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,6,0" />
        <ui:TeamTrack Grid.Column="2" Height="6" VerticalAlignment="Center" Fraction="{Binding Fraction}" Animated="{Binding Running}"
                      Motion="{Binding DataContext.Model.Motion, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TeamTimelineCompact">
      <ItemsControl ItemsSource="{Binding Model.Steps}" ItemTemplate="{StaticResource TeamTimelineMini}" Focusable="False" Margin="0,10,0,2" />
    </DataTemplate>

    <!-- Mesa de equipo, vista ancha: un retrato por paso con lo último que dijo. -->
    <DataTemplate x:Key="TeamCrewCard">
      <Border Width="182" Margin="0,0,6,6" Padding="8" CornerRadius="10" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
              ToolTip="{Binding Help}" AutomationProperties.Name="{Binding NodeName}">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Left" Command="{Binding Cycle}" Style="{StaticResource TeamAgentButton}" IsEnabled="{Binding CanChange}" ToolTip="{Binding ChangeHelp}" AutomationProperties.Name="{Binding ChangeHelp}">
              <ui:TeamAgentBadge Width="40" Height="40" Agent="{Binding Agent}" State="{Binding State}" Concern="{Binding Concern}" Animated="{Binding Running}"
                                 Motion="{Binding DataContext.Model.Motion, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
            </Button>
            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding RoleName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{Binding AgentName}" />
                    <Style.Triggers><DataTrigger Binding="{Binding HasModel}" Value="True"><Setter Property="Text" Value="{Binding ModelLabel}" /></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding TimeText}" Style="{StaticResource MonoSmall}" />
            </StackPanel>
          </DockPanel>
          <Border Margin="0,7,0,0" Padding="7,5" CornerRadius="8" Background="{DynamicResource Track}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding HasMessage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding ReportText}" FontSize="10.5" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis" />
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="TeamCrewWide">
      <ItemsControl ItemsSource="{Binding Model.Steps}" ItemTemplate="{StaticResource TeamCrewCard}" Focusable="False" Margin="0,10,0,0">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="TeamCrewBadge">
      <ui:TeamAgentBadge Width="34" Height="34" Margin="0,0,6,6" Agent="{Binding Agent}" State="{Binding State}" Concern="{Binding Concern}" Animated="{Binding Running}"
                         Motion="{Binding DataContext.Model.Motion, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         ToolTip="{Binding Help}" AutomationProperties.Name="{Binding NodeName}" />
    </DataTemplate>

    <DataTemplate x:Key="TeamCrewCompact">
      <ItemsControl ItemsSource="{Binding Model.Steps}" ItemTemplate="{StaticResource TeamCrewBadge}" Focusable="False" Margin="0,10,0,0">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>

    <!-- El anfitrión elige la vista según el ajuste y el ancho del widget. -->
    <Style x:Key="TeamFlowHost" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="ContentTemplate" Value="{StaticResource TeamPipelineWide}" />
      <Style.Triggers>
        <MultiDataTrigger><MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Wide}" Value="False" /><Condition Binding="{Binding Model.IsPipeline}" Value="True" />
        </MultiDataTrigger.Conditions><Setter Property="ContentTemplate" Value="{StaticResource TeamPipelineCompact}" /></MultiDataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Wide}" Value="True" /><Condition Binding="{Binding Model.IsTimeline}" Value="True" />
        </MultiDataTrigger.Conditions><Setter Property="ContentTemplate" Value="{StaticResource TeamTimelineWide}" /></MultiDataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Wide}" Value="False" /><Condition Binding="{Binding Model.IsTimeline}" Value="True" />
        </MultiDataTrigger.Conditions><Setter Property="ContentTemplate" Value="{StaticResource TeamTimelineCompact}" /></MultiDataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Wide}" Value="True" /><Condition Binding="{Binding Model.IsCrew}" Value="True" />
        </MultiDataTrigger.Conditions><Setter Property="ContentTemplate" Value="{StaticResource TeamCrewWide}" /></MultiDataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Wide}" Value="False" /><Condition Binding="{Binding Model.IsCrew}" Value="True" />
        </MultiDataTrigger.Conditions><Setter Property="ContentTemplate" Value="{StaticResource TeamCrewCompact}" /></MultiDataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="TeamChip">
      <Border Style="{StaticResource TeamChipBox}"><TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource Secondary}" /></Border>
    </DataTemplate>

    <DataTemplate x:Key="TeamSuggestionButton">
      <Button Command="{Binding Use}" Style="{StaticResource TeamBtn}" Tag="&#xE945;" MinHeight="28" Padding="10,0" Margin="0,0,6,6" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}">
        <TextBlock Text="{Binding Title}" FontSize="10.5" />
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="TeamFileRowTemplate">
      <Button Command="{Binding Pick}" Style="{StaticResource Plain}" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}" HorizontalContentAlignment="Stretch">
        <Border Padding="8,4" CornerRadius="7" x:Name="row" Background="Transparent">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Stat}" Style="{StaticResource MonoSmall}" Margin="10,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoft}" /></DataTrigger>
        <Trigger SourceName="row" Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource Track}" /></Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TeamMiniBadge">
      <ui:TeamAgentBadge Width="18" Height="18" Margin="0,0,3,0" Agent="{Binding Agent}" State="Pending" Opacity="0.95" />
    </DataTemplate>

    <!-- Historial: una tarjeta por tarea, con su franja de estado, sus cifras y su tubería en miniatura. -->
    <DataTemplate x:Key="TeamHistoryRowTemplate">
      <Button Command="{Binding Select}" Style="{StaticResource Plain}" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}" HorizontalContentAlignment="Stretch" Margin="0,0,0,7">
        <Border x:Name="card" CornerRadius="11" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="strip" CornerRadius="11,0,0,11" Background="{DynamicResource Warm}" />
            <Grid Grid.Column="1" Margin="12,10,12,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Track}" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock x:Name="g" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="11.5" Foreground="{DynamicResource Warm}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                  <TextBlock Text="{Binding Files}" Style="{StaticResource TeamMeta}" />
                  <TextBlock FontSize="10.5" FontFamily="{StaticResource Mono}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasChanges, Converter={StaticResource Visible}}">
                    <Run Text="{Binding Added, Mode=OneWay}" Foreground="{DynamicResource On}" /><Run Text=" " /><Run Text="{Binding Removed, Mode=OneWay}" Foreground="{DynamicResource Danger}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Tokens}" Style="{StaticResource TeamMeta}" Margin="8,0,0,0" Visibility="{Binding HasTokens, Converter={StaticResource Visible}}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Minis}" ItemTemplate="{StaticResource TeamMiniBadge}" Focusable="False" Margin="0,7,0,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
              <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                <TextBlock Text="{Binding When}" Style="{StaticResource MonoSmall}" HorizontalAlignment="Right" />
                <Border x:Name="pill" CornerRadius="9" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Right" Background="{DynamicResource Track}">
                  <TextBlock x:Name="pillText" Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                </Border>
                <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="10.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,6,2,0"
                           Visibility="{Binding Scheduled, Converter={StaticResource Visible}}" ToolTip="{Binding When}" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Good}" Value="True">
          <Setter TargetName="g" Property="Foreground" Value="{DynamicResource On}" /><Setter TargetName="strip" Property="Background" Value="{DynamicResource On}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Bad}" Value="True">
          <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Danger}" /><Setter TargetName="strip" Property="Background" Value="{DynamicResource Danger}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMerged}" Value="True"><Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource On}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsDiscarded}" Value="True"><Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource Muted}" /></DataTrigger>
        <Trigger SourceName="card" Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Muted}" /></Trigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter TargetName="card" Property="Background" Value="{DynamicResource AccentSoft}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Programadas: el día que toca, lo que viene y cómo salió la última vez. -->
    <DataTemplate x:Key="TeamDayDot">
      <StackPanel Margin="0,0,5,0" Width="14">
        <Ellipse x:Name="dot" Width="6" Height="6" Fill="{DynamicResource MutedHalf}" HorizontalAlignment="Center" />
        <TextBlock x:Name="letter" Text="{Binding Letter}" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding On}" Value="True">
          <Setter TargetName="dot" Property="Fill" Value="{DynamicResource On}" /><Setter TargetName="letter" Property="Foreground" Value="{DynamicResource Secondary}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TeamScheduleRowTemplate">
      <Border x:Name="card" Style="{StaticResource TeamCard}" Margin="0,0,0,8" Padding="12,11">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{DynamicResource AccentSoft}">
            <TextBlock x:Name="clock" Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
            <WrapPanel Margin="0,5,0,0">
              <Border Style="{StaticResource TeamChipBox}"><TextBlock Text="{Binding Frequency}" FontSize="10.5" Foreground="{DynamicResource Secondary}" /></Border>
              <Border Style="{StaticResource TeamChipBox}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,5,0" />
                  <TextBlock Text="{Binding Project}" FontSize="10.5" Foreground="{DynamicResource Secondary}" />
                </StackPanel>
              </Border>
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource TeamDayDot}" Focusable="False" Margin="0,2,0,6" Visibility="{Binding ShowDays, Converter={StaticResource Visible}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock FontSize="11" Foreground="{DynamicResource Fg}">
              <Run Text="{Binding NextLabel, Mode=OneWay}" Foreground="{DynamicResource Muted}" /><Run Text="  " /><Run Text="{Binding NextWhen, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Bad}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger>
                    <DataTrigger Binding="{Binding LastGood}" Value="True"><Setter Property="Foreground" Value="{DynamicResource On}" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
              <Run Text="{Binding LastLabel, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding LastText, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <ui:BrandSwitch IsOn="{Binding Enabled, Mode=OneWay}" Command="{Binding Toggle}" AutomationProperties.Name="{Binding ToggleHelp}" ToolTip="{Binding ToggleHelp}" HorizontalAlignment="Right" Margin="0,2,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Command="{Binding RunNow}" Style="{StaticResource TeamBtnIcon}" Tag="&#xE768;" ToolTip="{Binding RunHelp}" AutomationProperties.Name="{Binding RunHelp}" />
              <Button Command="{Binding Edit}" Style="{StaticResource TeamBtnIcon}" Tag="&#xE70F;" ToolTip="{Binding EditHelp}" AutomationProperties.Name="{Binding EditHelp}" />
              <Button Command="{Binding Delete}" Style="{StaticResource TeamBtnIconDanger}" Tag="&#xE74D;" ToolTip="{Binding DeleteHelp}" AutomationProperties.Name="{Binding DeleteHelp}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Enabled}" Value="False">
          <Setter TargetName="card" Property="Opacity" Value="0.7" /><Setter TargetName="clock" Property="Foreground" Value="{DynamicResource Muted}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TeamTemplateButton">
      <Button Command="{Binding Open}" Style="{StaticResource TeamBtn}" Tag="{Binding Glyph}" MinHeight="40" Padding="12,0" Margin="0,0,0,6" HorizontalContentAlignment="Left" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Help}" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <!-- El nombre del reparto y, solo en la lista desplegada, qué hace: sin esto «Diseño» o «Calidad» no dicen a quien no sabe de modelos qué eligen. -->
    <DataTemplate x:Key="TeamPresetText">
      <StackPanel VerticalAlignment="Center" ToolTip="{Binding Hint}">
        <TextBlock x:Name="nm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="lbl" Text="{Binding Label}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
        <TextBlock x:Name="hint" Text="{Binding Hint}" FontSize="10" Opacity="{DynamicResource SubtleOpacity}" TextWrapping="Wrap" MaxWidth="240" Margin="0,1,0,0" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}"><Setter TargetName="hint" Property="Visibility" Value="Collapsed" /><Setter TargetName="nm" Property="Visibility" Value="Collapsed" /><Setter TargetName="lbl" Property="Visibility" Value="Visible" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- TABLERO: una tarjeta por tarea con su agente, su estado y sus cifras; al pulsarla se despliega con el detalle y las acciones que tocan
         (aprobar o rechazar un plan, reintentar, abrir). Tres columnas (o tres grupos en la lista) con el título centrado. -->
    <Style x:Key="TeamBtnInk" TargetType="Button" BasedOn="{StaticResource TeamBtn}">
      <Setter Property="Background" Value="{DynamicResource Fg}" />
      <Setter Property="Foreground" Value="{DynamicResource Bg}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="12,0" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88" /></Trigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="TeamBoardLine">
      <!-- Dos filas: «Implementar · Sonnet» entero (en la tarjeta estrecha, con la hora al lado se cortaba justo el modelo) y debajo cuánto tardó. -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Ellipse x:Name="dot" Width="5" Height="5" Fill="{DynamicResource Muted}" Margin="2,5,8,0" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="txt" Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding When}" Style="{StaticResource MonoSmall}" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Current}" Value="True"><Setter TargetName="dot" Property="Fill" Value="{DynamicResource Fg}" /><Setter TargetName="txt" Property="Foreground" Value="{DynamicResource Fg}" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Acción principal de una tarjeta (Aprobar, Reintentar): pastilla de tinta del tema con su icono. -->
    <DataTemplate x:Key="TeamBoardAction">
      <Button Command="{Binding Command}" Content="{Binding Text}" Tag="{Binding Glyph}" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}"
              MinHeight="30" Padding="9,0,11,0" FontSize="11" FontWeight="SemiBold" Background="{DynamicResource Fg}" Foreground="{DynamicResource Bg}" BorderBrush="Transparent"
              Style="{StaticResource TeamBtn}" />
    </DataTemplate>

    <!-- Acciones secundarias: botones sin fondo dentro de una pastilla común, separados por una línea fina. -->
    <DataTemplate x:Key="TeamBoardGroupAction">
      <Grid>
        <Border Width="1" Margin="0,7" HorizontalAlignment="Left" Background="{DynamicResource Line}" Opacity="0.6" Visibility="{Binding Divider, Converter={StaticResource Visible}}" />
        <Button Command="{Binding Command}" Content="{Binding Text}" Tag="{Binding Glyph}" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}"
                MinHeight="30" MinWidth="26" Padding="4,0" FontSize="10.5" HorizontalContentAlignment="Center">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TeamBtnGhost}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDanger}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TeamBoardCard">
      <Border x:Name="card" CornerRadius="11" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Margin="0,0,0,7">
        <StackPanel>
          <Button Command="{Binding Toggle}" Style="{StaticResource Plain}" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}" HorizontalContentAlignment="Stretch">
            <StackPanel Margin="10,9,10,9">
              <DockPanel>
                <Path DockPanel.Dock="Right" VerticalAlignment="Top" Margin="6,7,0,0" Stroke="{DynamicResource Muted}">
                  <Path.Style>
                    <Style TargetType="Path" BasedOn="{StaticResource TeamIconChevron}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
                <ui:TeamAgentBadge DockPanel.Dock="Left" Width="22" Height="22" Agent="{Binding Agent}" State="{Binding State}" Concern="{Binding Concern}" VerticalAlignment="Top" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <TextBlock Text="{Binding Excerpt}" Style="{StaticResource Hint}" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                         Visibility="{Binding HasExcerpt, Converter={StaticResource Visible}}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Spinner x:Name="spin" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="10.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="status" Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Meta}" Style="{StaticResource MonoSmall}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding HasMeta, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Button>
          <!-- Desplegada: quién, el detalle (texto y pasos) y las acciones -->
          <StackPanel Margin="12,0,12,12" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
            <Border Height="1" Background="{DynamicResource Line}" Opacity="0.5" Margin="0,0,0,10" />
            <Border Style="{StaticResource TeamChipBox}" HorizontalAlignment="Left" Margin="0,0,0,9">
              <TextBlock Text="{Binding AgentLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" />
            </Border>
            <Border Style="{StaticResource TeamInset}" Padding="0" Margin="0,0,0,10" Visibility="{Binding HasDetailText, Converter={StaticResource Visible}}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="bar" CornerRadius="9,0,0,9" Background="{DynamicResource Muted}" Opacity="0.7" />
                <ui:MarkdownView Grid.Column="1" Markdown="{Binding DetailText}" MaxHeight="170" FontSize="11.5" Margin="12,8,10,8" AutomationProperties.Name="{Binding Title}" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource TeamBoardLine}" Focusable="False" Margin="2,0,2,0" Visibility="{Binding HasLines, Converter={StaticResource Visible}}" />
            <DockPanel Margin="0,12,0,0">
              <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding PrimaryActions}" ItemTemplate="{StaticResource TeamBoardAction}" Focusable="False" Margin="8,0,0,0"
                            Visibility="{Binding HasPrimary, Converter={StaticResource Visible}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <Border HorizontalAlignment="Left" CornerRadius="9" Background="{DynamicResource Track}" Visibility="{Binding HasSecondary, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding SecondaryActions}" ItemTemplate="{StaticResource TeamBoardGroupAction}" Focusable="False">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </Border>
            </DockPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="card" Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Muted}" /></Trigger>
        <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter TargetName="bar" Property="Background" Value="{DynamicResource Accent}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter TargetName="spin" Property="Visibility" Value="Visible" /><Setter TargetName="glyph" Property="Visibility" Value="Collapsed" /></DataTrigger>
        <DataTrigger Binding="{Binding IsGood}" Value="True"><Setter TargetName="bar" Property="Background" Value="{DynamicResource On}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsWarn}" Value="True"><Setter TargetName="bar" Property="Background" Value="{DynamicResource Warm}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsBad}" Value="True"><Setter TargetName="bar" Property="Background" Value="{DynamicResource Danger}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Accent}" /><Setter TargetName="status" Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsGood}" Value="True"><Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource On}" /><Setter TargetName="status" Property="Foreground" Value="{DynamicResource On}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsWarn}" Value="True"><Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Warm}" /><Setter TargetName="status" Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsBad}" Value="True"><Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Danger}" /><Setter TargetName="status" Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TeamBoardColumn">
      <Border CornerRadius="14" Background="{DynamicResource Track}" Padding="8,8,8,2" Margin="0,0,8,0" VerticalAlignment="Top">
        <StackPanel>
          <Grid Margin="4,2,4,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="g" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TeamEyebrow}" FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" />
            <Border Grid.Column="2" HorizontalAlignment="Right" CornerRadius="9" Padding="7,1" Background="{DynamicResource CardFill}"><TextBlock Text="{Binding Count}" Style="{StaticResource MonoSmall}" /></Border>
          </Grid>
          <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource TeamBoardCard}" Focusable="False" />
          <TextBlock Text="{Binding EmptyText}" Style="{StaticResource TeamMeta}" TextWrapping="Wrap" TextAlignment="Center" Margin="6,0,6,12" Visibility="{Binding NoCards, Converter={StaticResource Visible}}" />
          <Button Style="{StaticResource Plain}" Command="{Binding More}" AutomationProperties.Name="{Binding MoreLabel}" HorizontalAlignment="Center" Margin="0,2,0,8" Visibility="{Binding HasMore, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding MoreLabel}" Style="{StaticResource TeamMeta}" Foreground="{DynamicResource Accent}" />
          </Button>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="need"><Setter TargetName="g" Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="run"><Setter TargetName="g" Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="done"><Setter TargetName="g" Property="Foreground" Value="{DynamicResource On}" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TeamBoardColumnList">
      <Border CornerRadius="14" Background="{DynamicResource Track}" Padding="8,8,8,2" Margin="0,0,0,10">
        <StackPanel>
          <Grid Margin="4,2,4,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="g" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TeamEyebrow}" FontSize="10" TextAlignment="Center" HorizontalAlignment="Center" />
            <Border Grid.Column="2" HorizontalAlignment="Right" CornerRadius="9" Padding="7,1" Background="{DynamicResource CardFill}"><TextBlock Text="{Binding Count}" Style="{StaticResource MonoSmall}" /></Border>
          </Grid>
          <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource TeamBoardCard}" Focusable="False" />
          <TextBlock Text="{Binding EmptyText}" Style="{StaticResource TeamMeta}" TextWrapping="Wrap" TextAlignment="Center" Margin="6,0,6,12" Visibility="{Binding NoCards, Converter={StaticResource Visible}}" />
          <Button Style="{StaticResource Plain}" Command="{Binding More}" AutomationProperties.Name="{Binding MoreLabel}" HorizontalAlignment="Center" Margin="0,2,0,8" Visibility="{Binding HasMore, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding MoreLabel}" Style="{StaticResource TeamMeta}" Foreground="{DynamicResource Accent}" />
          </Button>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="need"><Setter TargetName="g" Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="run"><Setter TargetName="g" Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="done"><Setter TargetName="g" Property="Foreground" Value="{DynamicResource On}" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- El avance como tres nodos unidos por hilos discontinuos: los pasos de verdad o, sin tarea, tres fantasmas con su nombre. DataContext: la ranura. -->
    <DataTemplate x:Key="TeamGlanceNodes">
      <Grid>
        <Grid Visibility="{Binding Model.NoSteps, Converter={StaticResource Visible}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <ui:TeamAgentBadge Width="30" Height="30" Agent="Haiku" State="Pending" Opacity="0.85" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Model.GhostPlanLabel}" Style="{StaticResource TeamMeta}" HorizontalAlignment="Center" Margin="0,3,0,0" Padding="0,0,4,0" />
          </StackPanel>
          <Line Grid.Column="1" X1="0" X2="100" Stretch="Fill" Height="1.5" VerticalAlignment="Top" Margin="6,15,6,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeDashArray="2 3" StrokeDashCap="Round" Opacity="0.7" />
          <StackPanel Grid.Column="2">
            <ui:TeamAgentBadge Width="30" Height="30" Agent="Codex" State="Pending" Opacity="0.85" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Model.GhostDoLabel}" Style="{StaticResource TeamMeta}" HorizontalAlignment="Center" Margin="0,3,0,0" Padding="0,0,4,0" />
          </StackPanel>
          <Line Grid.Column="3" X1="0" X2="100" Stretch="Fill" Height="1.5" VerticalAlignment="Top" Margin="6,15,6,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeDashArray="2 3" StrokeDashCap="Round" Opacity="0.7" />
          <StackPanel Grid.Column="4">
            <ui:TeamAgentBadge Width="30" Height="30" Agent="Sonnet" State="Pending" Opacity="0.85" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Model.GhostReviewLabel}" Style="{StaticResource TeamMeta}" HorizontalAlignment="Center" Margin="0,3,0,0" Padding="0,0,4,0" />
          </StackPanel>
        </Grid>
        <ItemsControl ItemsSource="{Binding Model.Steps}" Focusable="False" Visibility="{Binding Model.HasSteps, Converter={StaticResource Visible}}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <ui:TeamAgentBadge Width="30" Height="30" Margin="0,0,8,4" Agent="{Binding Agent}" State="{Binding State}" Concern="{Binding Concern}" Animated="{Binding Running}"
                               Motion="{Binding DataContext.Model.Motion, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               ToolTip="{Binding Help}" AutomationProperties.Name="{Binding NodeName}" />
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WidgetTeamWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <StackPanel>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" Visibility="{Binding Full, Converter={StaticResource Visible}}" />

          <!-- Una fila (una o dos celdas, o la vista corta): el avance como tres nodos, el estado y, si trabaja, la barra. Aquí no se escribe. -->
          <Grid Visibility="{Binding Peek, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" Margin="0,0,0,2" />
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TeamGlanceNodes}" Margin="0,0,22,0" />
              <DockPanel Margin="0,9,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Model.ProgressText}" Style="{StaticResource MonoSmall}" Margin="8,0,0,0" Visibility="{Binding Model.Busy, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding Model.Status}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <ui:MemoryBar Margin="0,7,0,0" Height="5" Used="{Binding Model.ProgressFraction}" Visibility="{Binding Model.Busy, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Grid>

          <StackPanel Visibility="{Binding Full, Converter={StaticResource Visible}}">
            <!-- Pestañas (solo con dos celdas). -->
            <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding Model.Tabs}" Margin="0,0,0,12" AutomationProperties.Name="{Binding Model.TabsHelp}"
                          Visibility="{Binding Wide, Converter={StaticResource Visible}}" />

            <!-- ============ TAREA ============ -->
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid.Style>
                <Style TargetType="Grid">
                  <Style.Triggers>
                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Model.IsTaskTab}" Value="False" /><Condition Binding="{Binding Model.IsPlanTab}" Value="False" /><Condition Binding="{Binding Wide}" Value="True" />
                    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>

              <StackPanel Grid.Column="0" MinWidth="0">
                <!-- Con dos celdas la tarea ocupa todo el ancho (la caja de escribir, larga) y el plan vive en su pestaña -->
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Wide}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2" /></DataTrigger>
                      <MultiDataTrigger><MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Wide}" Value="True" /><Condition Binding="{Binding Model.IsPlanTab}" Value="True" />
                      </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
              <!-- El plan espera tu visto bueno -->
              <Border Style="{StaticResource TeamCard}" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" Visibility="{Binding Model.HasPending, Converter={StaticResource Visible}}">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding Model.EditPlan}" Style="{StaticResource TeamBtnGhost}" Tag="&#xE70F;" MinHeight="24" Padding="8,0" FontSize="10.5"
                            AutomationProperties.Name="{Binding Model.EditPlanHelp}" ToolTip="{Binding Model.EditPlanHelp}">
                      <TextBlock Text="{Binding Model.EditPlanLabel}" />
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Model.PendingTitle}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Text="{Binding Model.PendingHelp}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,8" />
                  <Border Style="{StaticResource TeamInset}" Padding="12,10" Visibility="{Binding Model.PlanPreview, Converter={StaticResource Visible}}">
                    <ui:MarkdownView Markdown="{Binding Model.PlanDraft}" MaxHeight="300" FontSize="11.5" AutomationProperties.Name="{Binding Model.PendingTitle}" />
                  </Border>
                  <TextBox Text="{Binding Model.PlanDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" Height="200"
                           VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Sans}" FontSize="11.5" AutomationProperties.Name="{Binding Model.EditPlanHelp}"
                           Visibility="{Binding Model.PlanEditing, Converter={StaticResource Visible}}" />
                  <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Command="{Binding Model.ApprovePlan}" Style="{StaticResource TeamBtnPrimary}" Tag="&#xE73E;" AutomationProperties.Name="{Binding Model.ApproveLabel}">
                      <TextBlock Text="{Binding Model.ApproveLabel}" />
                    </Button>
                    <Button Command="{Binding Model.RejectPlan}" Style="{StaticResource TeamBtnDanger}" Tag="&#xE711;" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Model.RejectLabel}">
                      <TextBlock Text="{Binding Model.RejectLabel}" />
                    </Button>
                  </DockPanel>
                </StackPanel>
              </Border>

              <!-- La tarea: se escribe en reposo; con una ejecución en marcha se ve su título y su reloj. En reposo, la tarjeta llena el hueco que le deja la vista alta. -->
              <Border>
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource TeamCard}">
                    <Style.Triggers><DataTrigger Binding="{Binding Model.Idle}" Value="True"><Setter Property="MinHeight" Value="{Binding TeamTaskMin}" /></DataTrigger></Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Command="{Binding Model.PickFolder}" Style="{StaticResource TeamBtnGhost}" Tag="&#xE838;" MinHeight="24" Padding="8,0" MaxWidth="150"
                            AutomationProperties.Name="{Binding Model.RootHelp}" ToolTip="{Binding Model.RootHelp}">
                      <TextBlock Text="{Binding Model.RootLabel}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <TextBlock Text="{Binding Model.MissionLabel}" Style="{StaticResource TeamEyebrow}" />
                  </DockPanel>
                  <!-- La caja: texto arriba y, debajo, + (adjuntar imágenes), reparto, esfuerzo y enviar. Se pueden soltar o pegar imágenes. -->
                  <Border x:Name="PromptField" Style="{StaticResource TeamPromptField}" ui:TeamAttach.Target="{Binding Model}"
                          Visibility="{Binding Model.Idle, Converter={StaticResource Visible}}">
                    <Grid>
                    <Border Height="1" VerticalAlignment="Top" Margin="22,0,22,0" Background="{DynamicResource PromptSheen}" IsHitTestVisible="False" />
                    <Border Height="1" VerticalAlignment="Bottom" Margin="30,0,30,0" Opacity="0.35" Background="{DynamicResource PromptSheen}" IsHitTestVisible="False" />
                    <StackPanel Margin="14,12,10,9">
                      <Border Style="{StaticResource TeamInset}" Margin="0,0,0,8" Visibility="{Binding Model.HasHeavyWarning, Converter={StaticResource Visible}}">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Warm}" VerticalAlignment="Top" Margin="0,1,8,0" />
                            <TextBlock Text="{Binding Model.HeavyWarningText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Warm}" />
                          </DockPanel>
                          <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Command="{Binding Model.HeavyCancel}" Style="{StaticResource TeamBtn}" Margin="0,0,6,0" AutomationProperties.Name="{Binding Model.HeavyCancelLabel}">
                              <TextBlock Text="{Binding Model.HeavyCancelLabel}" />
                            </Button>
                            <Button Command="{Binding Model.HeavyContinue}" Style="{StaticResource TeamBtnInk}" AutomationProperties.Name="{Binding Model.HeavyContinueLabel}">
                              <TextBlock Text="{Binding Model.HeavyContinueLabel}" />
                            </Button>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,4" Focusable="False"
                                    Visibility="{Binding Model.HasAttachments, Converter={StaticResource Visible}}">
                        <ItemsControl ItemsSource="{Binding Model.Attachments}" ItemTemplate="{StaticResource TeamAttachmentChip}" Focusable="False" AutomationProperties.Name="{Binding Model.AttachedHelp}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                      </ScrollViewer>
                      <Grid>
                        <TextBox Text="{Binding Model.Prompt, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Model.PromptHelp}"
                                 ui:TeamAttach.Target="{Binding Model}">
                          <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource TeamPromptText}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding WideAlone}" Value="True"><Setter Property="MinHeight" Value="48" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding Model.PromptHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" IsHitTestVisible="False" Margin="1,1,6,0" VerticalAlignment="Top"
                                   Visibility="{Binding Model.ShowPromptHint, Converter={StaticResource Visible}}" />
                      </Grid>
                      <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding Model.AttachImages}" Style="{StaticResource TeamBtnIcon}" MinWidth="28" MinHeight="28" Margin="-3,0,2,0"
                                AutomationProperties.Name="{Binding Model.AttachHelp}" ToolTip="{Binding Model.AttachHelp}">
                          <Path Style="{StaticResource TeamIconPlus}" />
                        </Button>
                        <ComboBox Grid.Column="1" Style="{StaticResource TeamPillCombo}" ItemsSource="{Binding Model.PresetItems}" SelectedItem="{Binding Model.SelectedPreset}"
                                  ItemTemplate="{StaticResource TeamPresetText}" AutomationProperties.Name="{Binding Model.PresetButtonHelp}" ToolTip="{Binding Model.PresetHint}"
                                  VerticalAlignment="Center" />
                        <ToggleButton x:Name="EffortToggle" Grid.Column="3" Style="{StaticResource TeamEffortToggle}" AutomationProperties.Name="{Binding Model.EffortButtonHelp}"
                                      ToolTip="{Binding Model.EffortHelp}" IsChecked="{Binding IsOpen, ElementName=EffortPopup, Mode=TwoWay}">
                          <StackPanel Orientation="Horizontal">
                            <ui:TeamGauge Width="20" Height="20" Fraction="{Binding Model.EffortFraction}" Motion="{Binding Model.Motion}" />
                          </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="EffortPopup" PlacementTarget="{Binding ElementName=EffortToggle}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                          <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PromptRim}" BorderThickness="1" CornerRadius="16" Width="268" Margin="0,0,0,8">
                            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.5" /></Border.Effect>
                            <Grid>
                              <Border Height="1" VerticalAlignment="Top" Margin="26,0,26,0" Background="{DynamicResource PromptSheen}" IsHitTestVisible="False" />
                              <StackPanel Margin="18,16,18,18">
                                <DockPanel>
                                  <ui:TeamGauge DockPanel.Dock="Left" Width="42" Height="42" Fraction="{Binding Model.EffortFraction}" Motion="{Binding Model.Motion}" Margin="0,0,14,0" />
                                  <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Model.EffortTitle}" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding Model.EffortText}" FontSize="19" FontWeight="SemiBold">
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Setter Property="Foreground" Value="{DynamicResource On}" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.EffortIndex}" Value="0"><Setter Property="Foreground" Value="{DynamicResource Secondary}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Model.EffortIndex}" Value="4"><Setter Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                  </StackPanel>
                                </DockPanel>
                                <Slider Style="{StaticResource TeamEffortSlider}" Margin="0,16,0,0" Maximum="{Binding Model.EffortMaximum}" Value="{Binding Model.EffortIndex, Mode=TwoWay}"
                                        AutomationProperties.Name="{Binding Model.EffortTitle}" AutomationProperties.HelpText="{Binding Model.EffortHelp}" ToolTip="{Binding Model.EffortHelp}" />
                                <DockPanel Margin="4,5,4,0">
                                  <TextBlock DockPanel.Dock="Right" Text="{Binding Model.EffortSmarter}" Style="{StaticResource TeamMeta}" />
                                  <TextBlock Text="{Binding Model.EffortFaster}" Style="{StaticResource TeamMeta}" />
                                </DockPanel>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </Popup>
                        <Button Grid.Column="4" Command="{Binding Model.Launch}" Margin="6,0,0,0"
                                AutomationProperties.Name="{Binding Model.LaunchLabel}" ToolTip="{Binding Model.SendHelp}">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TeamSendTile}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Model.CanLaunch}" Value="False">
                                  <Setter Property="Background" Value="{DynamicResource Track}" />
                                  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                          <Path Style="{StaticResource TeamIconArrowUp}" />
                        </Button>
                      </Grid>
                    </StackPanel>
                    </Grid>
                  </Border>
                  <DockPanel Visibility="{Binding Model.Busy, Converter={StaticResource Visible}}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Model.ElapsedText}" Style="{StaticResource MonoSmall}" VerticalAlignment="Top" Margin="8,2,0,0" />
                    <TextBlock Text="{Binding Model.RunTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                  </DockPanel>

                  <!-- Ejemplos para empezar (solo si el Team está solo en el Home: en un hueco de la cuadrícula no caben) -->
                  <StackPanel Visibility="{Binding WideAlone, Converter={StaticResource Visible}}">
                  <!-- Una sola fila que se desplaza de lado: la página del Home mide dos filas y nada debe obligar a bajar para ver las flechas o el resto -->
                  <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                                Visibility="{Binding Model.ShowSuggestions, Converter={StaticResource Visible}}">
                    <ItemsControl ItemsSource="{Binding Model.Suggestions}" ItemTemplate="{StaticResource TeamSuggestionButton}" Focusable="False"
                                  AutomationProperties.Name="{Binding Model.SuggestionsTitle}" ToolTip="{Binding Model.SuggestionsTitle}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                  </StackPanel>

                  <!-- En marcha: el estado y cancelar. -->
                  <DockPanel Margin="0,10,0,0" Visibility="{Binding Model.Busy, Converter={StaticResource Visible}}">
                    <Button DockPanel.Dock="Right" Command="{Binding Model.Cancel}" Style="{StaticResource TeamBtnDanger}" Tag="&#xE711;" Margin="8,0,0,0"
                            AutomationProperties.Name="{Binding Model.CancelHelp}" ToolTip="{Binding Model.CancelHelp}" />
                    <TextBlock Text="{Binding Model.Status}" FontSize="11.5" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <StackPanel Visibility="{Binding Model.Idle, Converter={StaticResource Visible}}">
                    <DockPanel Margin="2,8,0,0" Visibility="{Binding WideAlone, Converter={StaticResource Visible}}">
                      <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding Model.ReviewPlanOn, Mode=OneWay}" Command="{Binding Model.ToggleReviewPlan}"
                                      AutomationProperties.Name="{Binding Model.ReviewPlanTitle}" ToolTip="{Binding Model.ReviewPlanHelp}" Margin="10,0,0,0" />
                      <TextBlock Text="{Binding Model.ReviewPlanTitle}" FontSize="11" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" ToolTip="{Binding Model.ReviewPlanHelp}" />
                    </DockPanel>
                    <ItemsControl Visibility="{Binding WideAlone, Converter={StaticResource Visible}}" ItemsSource="{Binding Model.ContextChips}" ItemTemplate="{StaticResource TeamChip}" Focusable="False" Margin="0,10,0,-5">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource TeamInset}" Margin="0,0,0,0" Padding="11,8" Visibility="{Binding Model.ShowStatusLine, Converter={StaticResource Visible}}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Model.StatusGlyph}" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Top" Margin="0,1,9,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                        <Style.Triggers><DataTrigger Binding="{Binding Model.StatusIsWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger></Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding Model.Status}" TextWrapping="Wrap" FontSize="11">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
                        <Style.Triggers><DataTrigger Binding="{Binding Model.StatusIsWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger></Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DockPanel>
              </Border>
              </StackPanel>

              <!-- La columna del plan y el resultado (con una celda va debajo) -->
              <StackPanel Margin="12,0,0,0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Width" Value="270" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Compact}" Value="True">
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Width" Value="NaN" />
                        <Setter Property="Margin" Value="0,10,0,0" />
                      </DataTrigger>
                      <!-- Con una tarea en marcha el plan necesita todo el ancho: va debajo -->
                      <DataTrigger Binding="{Binding Model.HasSteps}" Value="True">
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                        <Setter Property="Width" Value="NaN" />
                        <Setter Property="Margin" Value="0,10,0,0" />
                      </DataTrigger>
                      <!-- Con dos celdas el plan tiene su pestaña, al lado de Tablero: ocupa todo el ancho y, fuera de ella, no se ve -->
                      <MultiDataTrigger><MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Wide}" Value="True" /><Condition Binding="{Binding Model.IsPlanTab}" Value="False" />
                      </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger>
                      <MultiDataTrigger><MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Wide}" Value="True" /><Condition Binding="{Binding Model.IsPlanTab}" Value="True" />
                      </MultiDataTrigger.Conditions>
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.Row" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                        <Setter Property="Width" Value="NaN" />
                        <Setter Property="Margin" Value="0" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <!-- Una celda y sin tarea: en vez de la tarjeta del plan, sus tres nodos -->
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TeamGlanceNodes}" Margin="4,2,22,0">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Compact}" Value="True" /><Condition Binding="{Binding Model.NoSteps}" Value="True" />
                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                </ContentControl>
              <!-- El plan: quién hace qué y cómo va -->
              <Border>
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource TeamCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Model.ShowPlanCard}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                      <DataTrigger Binding="{Binding Model.NoSteps}" Value="True"><Setter Property="MinHeight" Value="{Binding TeamPlanMin}" /></DataTrigger>
                      <MultiDataTrigger><MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Compact}" Value="True" /><Condition Binding="{Binding Model.NoSteps}" Value="True" />
                      </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Model.ProgressText}" Style="{StaticResource MonoSmall}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Model.PlanLabel}" Style="{StaticResource TeamEyebrow}" />
                  </DockPanel>
                  <ContentControl Content="{Binding}" Style="{StaticResource TeamFlowHost}" Visibility="{Binding Model.HasSteps, Converter={StaticResource Visible}}" />
                  <!-- Sin pasos todavía: tres nodos fantasma para que se vea qué se espera -->
                  <StackPanel Visibility="{Binding Model.NoSteps, Converter={StaticResource Visible}}" Margin="0,12,0,0">
                    <Grid HorizontalAlignment="Center" Width="270">
                      <Line X1="0" X2="40" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeDashArray="2 3" StrokeDashCap="Round" Opacity="0.7"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70,18,0,0" />
                      <Line X1="0" X2="40" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeDashArray="2 3" StrokeDashCap="Round" Opacity="0.7"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="160,18,0,0" />
                      <UniformGrid Rows="1">
                        <StackPanel>
                          <ui:TeamAgentBadge Width="36" Height="36" Agent="Haiku" State="Pending" Opacity="0.8" />
                          <TextBlock Text="{Binding Model.GhostPlanLabel}" Style="{StaticResource TeamMeta}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel>
                          <ui:TeamAgentBadge Width="36" Height="36" Agent="Codex" State="Pending" Opacity="0.8" />
                          <TextBlock Text="{Binding Model.GhostDoLabel}" Style="{StaticResource TeamMeta}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel>
                          <ui:TeamAgentBadge Width="36" Height="36" Agent="Sonnet" State="Pending" Opacity="0.8" />
                          <TextBlock Text="{Binding Model.GhostReviewLabel}" Style="{StaticResource TeamMeta}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                      </UniformGrid>
                    </Grid>
                    <TextBlock Text="{Binding Model.PlanHint}" Style="{StaticResource TeamMeta}" TextWrapping="Wrap" TextAlignment="Center" Margin="12,12,12,4" />
                  </StackPanel>
                  <TextBlock Text="{Binding Model.PlanHint}" TextWrapping="Wrap" Margin="0,6,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource TeamMeta}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <MultiDataTrigger><MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Model.HasProfile}" Value="True" /><Condition Binding="{Binding Model.Idle}" Value="True" /><Condition Binding="{Binding Model.HasSteps}" Value="True" />
                          </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                  <!-- Ahora: lo que hace el agente, en frases cortas, para ver que avanza y no se ha parado -->
                  <Border Style="{StaticResource TeamInset}" Margin="0,12,0,0" Visibility="{Binding Model.HasLiveLog, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Model.LastMoveText}" Style="{StaticResource TeamMeta}" VerticalAlignment="Center" />
                        <ui:Spinner DockPanel.Dock="Left" Width="11" Height="11" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Model.LiveTitle}" Style="{StaticResource TeamEyebrow}" VerticalAlignment="Center" />
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding Model.LiveLog}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <DockPanel Margin="0,2,0,0">
                              <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource TeamMeta}" Margin="10,0,0,0" VerticalAlignment="Center" />
                              <Ellipse x:Name="dot" DockPanel.Dock="Left" Width="5" Height="5" Fill="{DynamicResource Muted}" Margin="1,0,9,0" VerticalAlignment="Center" />
                              <TextBlock x:Name="line" Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                              <DataTrigger Binding="{Binding IsLast}" Value="True">
                                <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Accent}" />
                                <Setter TargetName="line" Property="Foreground" Value="{DynamicResource Fg}" />
                                <Setter TargetName="line" Property="FontWeight" Value="SemiBold" />
                              </DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding Model.LiveHint}" Style="{StaticResource TeamMeta}" TextWrapping="Wrap" Margin="0,7,0,0" Visibility="{Binding Model.HasLiveHint, Converter={StaticResource Visible}}" />
                    </StackPanel>
                  </Border>

                  <StackPanel Visibility="{Binding Model.ShowFocusMessage, Converter={StaticResource Visible}}">
                  <Border Style="{StaticResource TeamInset}" Margin="0,10,0,0" DataContext="{Binding Model.Focus}">
                    <Border.Visibility>
                      <Binding Path="HasMessage" Converter="{StaticResource Visible}" FallbackValue="Collapsed" />
                    </Border.Visibility>
                    <DockPanel>
                      <ui:TeamAgentBadge DockPanel.Dock="Left" Width="26" Height="26" Agent="{Binding Agent}" State="{Binding State}" Concern="{Binding Concern}" VerticalAlignment="Top" />
                      <StackPanel Margin="9,0,0,0">
                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"><Run Text="{Binding AgentName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding RoleName, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding ReportText}" Style="{StaticResource Hint}" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  </StackPanel>

                  <Border Style="{StaticResource TeamInset}" Margin="0,10,0,0" Visibility="{Binding Model.HasWarning, Converter={StaticResource Visible}}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Warm}" VerticalAlignment="Top" Margin="0,1,8,0" />
                      <TextBlock Text="{Binding Model.Warning}" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Warm}" />
                    </DockPanel>
                  </Border>

                  <!-- Lo gastado y su reparto -->
                  <StackPanel Margin="0,12,0,0" Visibility="{Binding Model.HasShare, Converter={StaticResource Visible}}">
                    <DockPanel Margin="0,0,0,6">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding Model.HasQueue, Converter={StaticResource Visible}}">
                        <Border Style="{StaticResource TeamChipBox}" Margin="8,0,0,0"><TextBlock Text="{Binding Model.QueueText}" FontSize="10" Foreground="{DynamicResource Accent}" /></Border>
                      </StackPanel>
                      <ui:RollingNumber Value="{Binding Model.TokenValue}" Suffix="{Binding Model.TokenSuffix}" Motion="{Binding Model.Motion}" FontSize="11.5" FontFamily="{StaticResource Mono}"
                                        Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ui:TokenSplitBar ClaudeShare="{Binding Model.ClaudeShare}" HasData="{Binding Model.HasShare}" ToolTip="{Binding Model.ShareText}" AutomationProperties.Name="{Binding Model.ShareText}" />
                    <DockPanel Margin="0,4,0,0">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Model.Footer}" Style="{StaticResource MonoSmall}" Visibility="{Binding WideAlone, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding Model.ShareText}" Style="{StaticResource TeamMeta}" />
                    </DockPanel>
                  </StackPanel>
                </StackPanel>
              </Border>


              <!-- Resultado de la última tarea -->
              <Border Style="{StaticResource TeamCard}" Padding="0" Margin="0" Visibility="{Binding Model.ShowResult, Converter={StaticResource Visible}}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border CornerRadius="12,0,0,12">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Warm}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Model.EntryGood}" Value="True"><Setter Property="Background" Value="{DynamicResource On}" /></DataTrigger>
                          <DataTrigger Binding="{Binding Model.EntryBad}" Value="True"><Setter Property="Background" Value="{DynamicResource Danger}" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,12,14,14">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Track}" VerticalAlignment="Top" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Model.EntryGlyph}" FontFamily="{StaticResource Icons}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource Warm}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Model.EntryGood}" Value="True"><Setter Property="Foreground" Value="{DynamicResource On}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Model.EntryBad}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                      <StackPanel>
                        <TextBlock Text="{Binding Model.ResultLabel}" Style="{StaticResource TeamEyebrow}" />
                        <TextBlock Text="{Binding Model.EntryTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Model.EntryWhen}" Style="{StaticResource MonoSmall}" Margin="0,3,0,0" />
                      </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="0,10,0,0">
                      <Border Style="{StaticResource TeamChipBox}">
                        <TextBlock FontSize="10.5" FontWeight="SemiBold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource Warm}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Model.EntryGood}" Value="True"><Setter Property="Foreground" Value="{DynamicResource On}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Model.EntryBad}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                          <Run Text="{Binding Model.EntryOutcome, Mode=OneWay}" />
                        </TextBlock>
                      </Border>
                      <Border Style="{StaticResource TeamChipBox}" Padding="0" Visibility="{Binding Model.HasEntryParent, Converter={StaticResource Visible}}">
                        <Button Command="{Binding Model.OpenParent}" Style="{StaticResource TeamBtnGhost}" MinHeight="22" Padding="8,0" FontSize="10.5" Tag="&#xE72B;"
                                AutomationProperties.Name="{Binding Model.EntryParentHelp}" ToolTip="{Binding Model.EntryParentHelp}">
                          <TextBlock Text="{Binding Model.EntryParentText}" />
                        </Button>
                      </Border>
                      <Border Style="{StaticResource TeamChipBox}" Visibility="{Binding Model.ShowEntryFacts, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Model.EntryFiles}" FontSize="10.5" Foreground="{DynamicResource Secondary}" /></Border>
                      <Border Style="{StaticResource TeamChipBox}" Visibility="{Binding Model.HasChanges, Converter={StaticResource Visible}}">
                        <TextBlock FontSize="10.5" FontFamily="{StaticResource Mono}"><Run Text="{Binding Model.EntryAdded, Mode=OneWay}" Foreground="{DynamicResource On}" /><Run Text=" " /><Run Text="{Binding Model.EntryRemoved, Mode=OneWay}" Foreground="{DynamicResource Danger}" /></TextBlock>
                      </Border>
                      <Border Style="{StaticResource TeamChipBox}" Visibility="{Binding Model.HasVerdict, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Model.EntryVerdict}" FontSize="10.5" Foreground="{DynamicResource Secondary}" /></Border>
                      <Border Style="{StaticResource TeamChipBox}" Visibility="{Binding Model.HasEntryState, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Model.EntryState}" FontSize="10.5" Foreground="{DynamicResource Accent}" /></Border>
                      <Border Style="{StaticResource TeamChipBox}" Visibility="{Binding Model.EntryScheduled, Converter={StaticResource Visible}}">
                        <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="10.5" Foreground="{DynamicResource Secondary}" ToolTip="{Binding Model.EntryWhen}" />
                      </Border>
                    </WrapPanel>
                    <Border Style="{StaticResource TeamInset}" Margin="0,4,0,0" Padding="0" Visibility="{Binding Model.ShowEntryAnswer, Converter={StaticResource Visible}}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border CornerRadius="9,0,0,9" Background="{DynamicResource Accent}" Opacity="0.75" />
                        <StackPanel Grid.Column="1" Margin="14,10,12,10">
                          <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Command="{Binding Model.CopyReport}" Padding="8,0" MinHeight="24" FontSize="10.5" Tag="{Binding Model.CopyReportGlyph}"
                                    AutomationProperties.Name="{Binding Model.CopyReportHelp}" ToolTip="{Binding Model.CopyReportHelp}">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TeamBtnGhost}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Model.ReportCopied}" Value="True"><Setter Property="Foreground" Value="#FF34C759" /></DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                              <TextBlock Text="{Binding Model.CopyReportLabel}" />
                            </Button>
                            <TextBlock Text="{Binding Model.AnswerLabel}" Style="{StaticResource TeamEyebrow}" VerticalAlignment="Center" />
                          </DockPanel>
                          <ui:MarkdownView Markdown="{Binding Model.EntryReport}" MaxHeight="320" FontSize="12.5" AutomationProperties.Name="{Binding Model.AnswerLabel}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Style="{StaticResource TeamInset}" Margin="0,4,0,0" Visibility="{Binding Model.ShowEntryReport, Converter={StaticResource Visible}}">
                      <TextBlock Text="{Binding Model.EntryReport}" Style="{StaticResource Hint}" TextWrapping="Wrap" MaxHeight="76" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <!-- Qué hacer ahora: una acción principal, dos de apoyo y una de peligro al final -->
                    <DockPanel Margin="0,12,0,0" Visibility="{Binding Model.EntryOpen, Converter={StaticResource Visible}}">
                      <Button DockPanel.Dock="Right" Command="{Binding Model.Discard}" Style="{StaticResource TeamBtnIconDanger}" Tag="&#xE74D;" Margin="8,0,0,0"
                              AutomationProperties.Name="{Binding Model.DiscardHelp}" ToolTip="{Binding Model.DiscardHelp}" />
                      <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding Model.Merge}" Style="{StaticResource TeamBtnPrimary}" Tag="&#xE8AB;" Margin="0,0,8,0" AutomationProperties.Name="{Binding Model.MergeHelp}" ToolTip="{Binding Model.MergeHelp}">
                          <TextBlock Text="{Binding Model.MergeLabel}" />
                        </Button>
                        <Button Command="{Binding Model.ToggleDiff}" Style="{StaticResource TeamBtn}" Tag="&#xE8FD;" Margin="0,0,8,0" AutomationProperties.Name="{Binding Model.DiffHelp}" ToolTip="{Binding Model.DiffHelp}"
                                Visibility="{Binding Model.HasChanges, Converter={StaticResource Visible}}">
                          <TextBlock Text="{Binding Model.DiffLabel}" />
                        </Button>
                        <Button Command="{Binding Model.OpenFolder}" Style="{StaticResource TeamBtnIcon}" Tag="&#xE838;" AutomationProperties.Name="{Binding Model.OpenHelp}" ToolTip="{Binding Model.OpenHelp}" />
                      </StackPanel>
                    </DockPanel>
                    <!-- Los cambios, sin salir del notch -->
                    <StackPanel Margin="0,10,0,0">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <MultiDataTrigger><MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding Model.ShowDiff}" Value="True" /><Condition Binding="{Binding Wide}" Value="True" />
                            </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <ItemsControl ItemsSource="{Binding Model.ChangedFiles}" ItemTemplate="{StaticResource TeamFileRowTemplate}" Focusable="False" />
                      <Border Style="{StaticResource TeamInset}" Margin="0,8,0,0" Visibility="{Binding Model.HasDiffText, Converter={StaticResource Visible}}">
                        <ScrollViewer MaxHeight="190" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                          <ui:TeamDiffBlock Diff="{Binding Model.DiffText}" />
                        </ScrollViewer>
                      </Border>
                    </StackPanel>
                    <!-- Pedir cambios sobre la misma rama -->
                    <Grid Margin="0,12,0,0">
                      <Grid.Style>
                        <Style TargetType="Grid">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <MultiDataTrigger><MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding Model.EntryOpen}" Value="True" /><Condition Binding="{Binding Wide}" Value="True" />
                            </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                            <DataTrigger Binding="{Binding Model.EntryIsAnswer}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Grid.Style>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Grid>
                        <TextBox Style="{StaticResource Field}" Text="{Binding Model.FollowUp, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="72"
                                 VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Sans}" FontSize="11.5" AutomationProperties.Name="{Binding Model.FollowUpHint}" />
                        <TextBlock Text="{Binding Model.FollowUpHint}" Style="{StaticResource Hint}" IsHitTestVisible="False" Margin="11,8,11,0" VerticalAlignment="Top"
                                   Visibility="{Binding Model.ShowFollowUpHint, Converter={StaticResource Visible}}" />
                      </Grid>
                      <Button Grid.Column="1" Command="{Binding Model.SendFollowUp}" Style="{StaticResource TeamBtn}" Tag="&#xE724;" Margin="8,0,0,0" VerticalAlignment="Top" MinHeight="34" IsEnabled="{Binding Model.CanFollowUp}"
                              AutomationProperties.Name="{Binding Model.FollowUpHelp}" ToolTip="{Binding Model.FollowUpHelp}">
                        <TextBlock Text="{Binding Model.FollowUpLabel}" />
                      </Button>
                    </Grid>
                  </StackPanel>
                </Grid>
              </Border>
              </StackPanel>
            </Grid>

            <!-- ============ TABLERO ============ -->
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Model.IsBoardTab}" Value="True" /><Condition Binding="{Binding Wide}" Value="True" />
                    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <DockPanel Margin="2,0,0,10">
                <ItemsControl DockPanel.Dock="Right" Style="{StaticResource Segmented}" ItemsSource="{Binding Model.BoardViews}" Width="190" AutomationProperties.Name="{Binding Model.BoardViewsHelp}" />
                <TextBlock Text="{Binding Model.BoardSummary}" Style="{StaticResource TeamMeta}" VerticalAlignment="Center" />
              </DockPanel>
              <Border Style="{StaticResource TeamInset}" Margin="0,0,0,10" Padding="12,10" Visibility="{Binding Model.BoardOfferExternal, Converter={StaticResource Visible}}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Command="{Binding Model.EnableExternal}" Style="{StaticResource TeamBtnInk}" Margin="12,0,0,0" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Model.ExternalOfferLabel}">
                    <TextBlock Text="{Binding Model.ExternalOfferLabel}" />
                  </Button>
                  <TextBlock Text="{Binding Model.ExternalOfferText}" Style="{StaticResource TeamMeta}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding Model.BoardColumns}" ItemTemplate="{StaticResource TeamBoardColumn}" Focusable="False" Visibility="{Binding Model.BoardIsBoard, Converter={StaticResource Visible}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Model.BoardColumns}" ItemTemplate="{StaticResource TeamBoardColumnList}" Focusable="False" Visibility="{Binding Model.BoardIsList, Converter={StaticResource Visible}}" />
            </StackPanel>

            <!-- ============ HISTORIAL ============ -->
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Model.IsHistoryTab}" Value="True" /><Condition Binding="{Binding Wide}" Value="True" />
                    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <!-- Vacío -->
              <Border Style="{StaticResource TeamCard}" Visibility="{Binding Model.NoHistory, Converter={StaticResource Visible}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,10">
                  <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Track}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Model.HistoryEmpty}" Style="{StaticResource Hint}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
              <!-- Con tareas -->
              <StackPanel Visibility="{Binding Model.HasHistory, Converter={StaticResource Visible}}">
                <DockPanel Margin="2,0,0,8">
                  <Button DockPanel.Dock="Right" Command="{Binding Model.ClearHistory}" Style="{StaticResource TeamBtnDanger}" Tag="&#xE74D;" MinHeight="26" Padding="9,0"
                          AutomationProperties.Name="{Binding Model.ClearHistoryHelp}" ToolTip="{Binding Model.ClearHistoryHelp}">
                    <TextBlock Text="{Binding Model.ClearHistoryLabel}" FontSize="10.5" />
                  </Button>
                  <TextBlock Text="{Binding Model.HistorySummary}" Style="{StaticResource TeamMeta}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding Model.HistoryFilters}" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Model.FilteredEmpty}" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,12" Visibility="{Binding Model.ShowFilteredEmpty, Converter={StaticResource Visible}}" />
                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Model.HistoryRows}" ItemTemplate="{StaticResource TeamHistoryRowTemplate}" Focusable="False" />
                </ScrollViewer>
              </StackPanel>
            </StackPanel>

            <!-- ============ PROGRAMADAS ============ -->
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Model.IsScheduleTab}" Value="True" /><Condition Binding="{Binding Wide}" Value="True" />
                    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <!-- La lista -->
              <StackPanel>
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers><DataTrigger Binding="{Binding Model.HasEditor}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <!-- Vacío: qué son, y tres plantillas para empezar -->
                <Border Style="{StaticResource TeamCard}" Visibility="{Binding Model.NoSchedules, Converter={StaticResource Visible}}">
                  <StackPanel Margin="0,8,0,4">
                    <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
                      <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Model.SchedulesEmpty}" Style="{StaticResource Hint}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Margin="0,10,0,14" />
                    <ItemsControl ItemsSource="{Binding Model.ScheduleTemplates}" ItemTemplate="{StaticResource TeamTemplateButton}" Focusable="False" MaxWidth="420" />
                  </StackPanel>
                </Border>
                <!-- Con tareas -->
                <StackPanel Visibility="{Binding Model.HasSchedules, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding Model.ScheduleSummary}" Style="{StaticResource TeamMeta}" Margin="2,0,0,8" />
                  <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Model.ScheduleRows}" ItemTemplate="{StaticResource TeamScheduleRowTemplate}" Focusable="False" />
                  </ScrollViewer>
                </StackPanel>
                <Button Command="{Binding Model.NewSchedule}" Style="{StaticResource TeamBtnPrimary}" Tag="&#xE710;" Margin="0,2,0,0" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Model.NewScheduleLabel}">
                  <TextBlock Text="{Binding Model.NewScheduleLabel}" />
                </Button>
                <TextBlock Text="{Binding Model.SchedulesNote}" Style="{StaticResource TeamMeta}" TextWrapping="Wrap" Margin="2,12,0,0" />
              </StackPanel>
              <!-- El formulario: tres bloques (qué, cuándo, cómo) y sus acciones -->
              <StackPanel x:Name="TeamForm" Visibility="{Binding HasEditor, Converter={StaticResource Visible}}" DataContext="{Binding Model}">
                <TextBlock Text="{Binding EditorTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="2,0,0,10" />
                <StackPanel DataContext="{Binding Editor}">
                  <Border Style="{StaticResource TeamCard}">
                    <StackPanel>
                      <TextBlock Text="{Binding DataContext.WhatLabel, ElementName=TeamForm}" Style="{StaticResource TeamEyebrow}" Margin="0,0,0,8" />
                      <TextBlock Text="{Binding DataContext.TitleLabel, ElementName=TeamForm}" Style="{StaticResource TeamMeta}" Margin="0,0,0,4" />
                      <TextBox Style="{StaticResource Field}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Sans}" FontSize="11.5" />
                      <TextBlock Text="{Binding DataContext.EditorHint, ElementName=TeamForm}" Style="{StaticResource TeamMeta}" TextWrapping="Wrap" Margin="0,10,0,4" />
                      <TextBox Style="{StaticResource Field}" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" Height="76" VerticalScrollBarVisibility="Auto"
                               FontFamily="{StaticResource Sans}" FontSize="11.5" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource TeamCard}">
                    <StackPanel>
                      <TextBlock Text="{Binding DataContext.WhenLabel, ElementName=TeamForm}" Style="{StaticResource TeamEyebrow}" Margin="0,0,0,8" />
                      <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding KindSegments}" />
                      <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowTime, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding DataContext.TimeLabel, ElementName=TeamForm}" Style="{StaticResource TeamMeta}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource Field}" Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" Width="96" HorizontalAlignment="Left" FontFamily="{StaticResource Mono}" FontSize="12" />
                      </StackPanel>
                      <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowEvery, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding DataContext.EveryLabel, ElementName=TeamForm}" Style="{StaticResource TeamMeta}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource Field}" Text="{Binding Every, UpdateSourceTrigger=PropertyChanged}" Width="96" HorizontalAlignment="Left" FontFamily="{StaticResource Mono}" FontSize="12" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding ShowDays, Converter={StaticResource Visible}}">
                        <ToggleButton Style="{StaticResource TeamDayToggle}" IsChecked="{Binding Day0}" Content="{Binding DataContext.DayLetters[0], ElementName=TeamForm}" ToolTip="{Binding DataContext.DayNames[0], ElementName=TeamForm}" AutomationProperties.Name="{Binding DataContext.DayNames[0], ElementName=TeamForm}" />
                        <ToggleButton Style="{StaticResource TeamDayToggle}" IsChecked="{Binding Day1}" Content="{Binding DataContext.DayLetters[1], ElementName=TeamForm}" ToolTip="{Binding DataContext.DayNames[1], ElementName=TeamForm}" AutomationProperties.Name="{Binding DataContext.DayNames[1], ElementName=TeamForm}" />
                        <ToggleButton Style="{StaticResource TeamDayToggle}" IsChecked="{Binding Day2}" Content="{Binding DataContext.DayLetters[2], ElementName=TeamForm}" ToolTip="{Binding DataContext.DayNames[2], ElementName=TeamForm}" AutomationProperties.Name="{Binding DataContext.DayNames[2], ElementName=TeamForm}" />
                        <ToggleButton Style="{StaticResource TeamDayToggle}" IsChecked="{Binding Day3}" Content="{Binding DataContext.DayLetters[3], ElementName=TeamForm}" ToolTip="{Binding DataContext.DayNames[3], ElementName=TeamForm}" AutomationProperties.Name="{Binding DataContext.DayNames[3], ElementName=TeamForm}" />
                        <ToggleButton Style="{StaticResource TeamDayToggle}" IsChecked="{Binding Day4}" Content="{Binding DataContext.DayLetters[4], ElementName=TeamForm}" ToolTip="{Binding DataContext.DayNames[4], ElementName=TeamForm}" AutomationProperties.Name="{Binding DataContext.DayNames[4], ElementName=TeamForm}" />
                        <ToggleButton Style="{StaticResource TeamDayToggle}" IsChecked="{Binding Day5}" Content="{Binding DataContext.DayLetters[5], ElementName=TeamForm}" ToolTip="{Binding DataContext.DayNames[5], ElementName=TeamForm}" AutomationProperties.Name="{Binding DataContext.DayNames[5], ElementName=TeamForm}" />
                        <ToggleButton Style="{StaticResource TeamDayToggle}" IsChecked="{Binding Day6}" Content="{Binding DataContext.DayLetters[6], ElementName=TeamForm}" ToolTip="{Binding DataContext.DayNames[6], ElementName=TeamForm}" AutomationProperties.Name="{Binding DataContext.DayNames[6], ElementName=TeamForm}" />
                      </StackPanel>
                      <DockPanel Margin="0,14,0,0">
                        <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding CatchUp, Mode=OneWay}" Command="{Binding ToggleCatchUp}" Margin="10,0,0,0"
                                        AutomationProperties.Name="{Binding DataContext.CatchUpLabel, ElementName=TeamForm}" />
                        <TextBlock Text="{Binding DataContext.CatchUpLabel, ElementName=TeamForm}" FontSize="11" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource TeamCard}">
                    <StackPanel>
                      <TextBlock Text="{Binding DataContext.HowLabel, ElementName=TeamForm}" Style="{StaticResource TeamEyebrow}" Margin="0,0,0,8" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource GlassComboBox}" ItemsSource="{Binding DataContext.PresetItems, ElementName=TeamForm}" ItemTemplate="{StaticResource TeamPresetText}" SelectedIndex="{Binding Preset}" MinHeight="30"
                                  AutomationProperties.Name="{Binding DataContext.PresetHelp, ElementName=TeamForm}" />
                        <Button Grid.Column="2" Command="{Binding DataContext.PickEditorFolder, ElementName=TeamForm}" Style="{StaticResource TeamBtn}" Tag="&#xE838;" MaxWidth="180"
                                AutomationProperties.Name="{Binding DataContext.PickFolderLabel, ElementName=TeamForm}" ToolTip="{Binding Root}">
                          <TextBlock Text="{Binding RootLabel}" TextTrimming="CharacterEllipsis" />
                        </Button>
                      </Grid>
                      <TextBlock Text="{Binding DataContext.TokensLabel, ElementName=TeamForm}" Style="{StaticResource TeamMeta}" Margin="0,12,0,4" />
                      <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource Field}" Text="{Binding TokensK, UpdateSourceTrigger=PropertyChanged}" Width="96" FontFamily="{StaticResource Mono}" FontSize="12" />
                        <TextBlock Text="{Binding DataContext.TokensUnit, ElementName=TeamForm}" Style="{StaticResource TeamMeta}" VerticalAlignment="Center" Margin="8,0,0,0" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <DockPanel Margin="0,2,0,0">
                    <Button DockPanel.Dock="Right" Command="{Binding DataContext.CancelEdit, ElementName=TeamForm}" Style="{StaticResource TeamBtnGhost}" Margin="8,0,0,0"
                            AutomationProperties.Name="{Binding DataContext.CancelLabel, ElementName=TeamForm}">
                      <TextBlock Text="{Binding DataContext.CancelLabel, ElementName=TeamForm}" />
                    </Button>
                    <Button DockPanel.Dock="Right" Command="{Binding DataContext.SaveSchedule, ElementName=TeamForm}" Style="{StaticResource TeamBtnPrimary}" Tag="&#xE73E;" IsEnabled="{Binding Valid}"
                            AutomationProperties.Name="{Binding DataContext.SaveLabel, ElementName=TeamForm}">
                      <TextBlock Text="{Binding DataContext.SaveLabel, ElementName=TeamForm}" />
                    </Button>
                    <TextBlock />
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ============ Notas, al estilo de las Notas de iOS ============ -->
    <!-- Un botón de la banda amarilla: un símbolo del color de la banda (sin fondo) -->
    <Style x:Key="NoteBandButton" TargetType="Button" BasedOn="{StaticResource Plain}">
      <Setter Property="Margin" Value="2,0,0,0" />
    </Style>

    <!-- Una fila de la lista: el título y, debajo, la fecha con el principio del texto; una línea fina la separa de la siguiente -->
    <DataTemplate x:Key="NoteListRow">
      <Button Style="{StaticResource Plain}" Command="{Binding Open}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}" HorizontalContentAlignment="Stretch">
        <Border x:Name="row" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="2,6,2,6" CornerRadius="0">
          <StackPanel>
            <TextBlock x:Name="title" Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Meta}" FontSize="10.5" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="title" Property="FontWeight" Value="SemiBold" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- La fila de una línea (dos celdas en una fila): el título y la fecha a la derecha -->
    <DataTemplate x:Key="NoteListRowTight">
      <Button Style="{StaticResource Plain}" Command="{Binding Open}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}" HorizontalContentAlignment="Stretch">
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="2,6,2,6">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Date}" FontSize="10.5" Foreground="{DynamicResource Secondary}" Margin="10,1,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
      </Button>
    </DataTemplate>

    <Style x:Key="NoteEditor" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="CaretBrush" Value="{DynamicResource NoteAccent}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource NoteAccent}" />
      <Setter Property="FontFamily" Value="{StaticResource Sans}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <DataTemplate x:Key="WidgetNotesWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <!-- La banda amarilla: la carpeta y «Notas» a la izquierda y, a la derecha, volver / borrar / nueva / editar -->
          <Border Margin="-12,-8,-12,0" Height="34" CornerRadius="16,16,0,0" Background="{DynamicResource NoteBand}">
            <DockPanel Margin="14,0,10,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource NoteBandButton}" Command="{Binding Model.Back}" ToolTip="{Binding Model.BackHelp}" AutomationProperties.Name="{Binding Model.BackHelp}" Visibility="{Binding Model.Editing, Converter={StaticResource Visible}}">
                  <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource OnNote}" Margin="6,3" />
                </Button>
                <Button Style="{StaticResource NoteBandButton}" Command="{Binding Model.Delete}" ToolTip="{Binding Model.DeleteHelp}" AutomationProperties.Name="{Binding Model.DeleteHelp}" Visibility="{Binding Model.Editing, Converter={StaticResource Visible}}">
                  <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource OnNote}" Margin="6,3" />
                </Button>
                <Button Style="{StaticResource NoteBandButton}" Command="{Binding Model.NewNote}" ToolTip="{Binding Model.NewHelp}" AutomationProperties.Name="{Binding Model.NewHelp}">
                  <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource OnNote}" Margin="6,3" />
                </Button>
              </StackPanel>
              <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource OnNote}" Margin="0,1,9,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Model.HeaderTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OnNote}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <!-- La línea de puntos bajo la banda, como el papel de las Notas -->
          <Line Grid.Row="1" X1="0" X2="1" Stretch="Fill" VerticalAlignment="Top" Margin="-12,0,-12,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" StrokeDashArray="0.2 2.4" StrokeDashCap="Round" />

          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <!-- ===== Editando (una celda, dos en una fila, una celda y dos filas): el texto de la nota elegida ===== -->
            <Grid Grid.Row="0">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Model.Editing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    <!-- Con dos celdas y dos filas el editor ya está a la derecha de la lista -->
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding WideTall}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBox Style="{StaticResource NoteEditor}" Text="{Binding Model.Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Model.EditorName}" />
              <TextBlock Grid.Row="1" Text="{Binding Model.CurrentDate}" FontSize="10.5" Foreground="{DynamicResource Secondary}" Margin="0,4,0,0" />
            </Grid>

            <Grid>
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Model.NotEditing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding WideTall}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <!-- Una celda: la nota de iOS, con el título, el principio del texto y la fecha abajo; tocarla la abre -->
              <Button Style="{StaticResource Plain}" Command="{Binding Model.StartEdit}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="{Binding Model.EditHelp}" ToolTip="{Binding Model.EditHelp}"
                      Visibility="{Binding CompactFlat, Converter={StaticResource Visible}}">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Model.CurrentTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Model.CurrentPreview}" FontSize="11.5" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" Margin="0,3,0,0" Visibility="{Binding Model.HasCurrentPreview, Converter={StaticResource Visible}}" />
                  </StackPanel>
                  <DockPanel Grid.Row="1" Margin="0,0,0,2">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding Model.CanCycle, Converter={StaticResource Visible}}">
                      <Button Style="{StaticResource Plain}" Command="{Binding Model.Previous}" ToolTip="{Binding Model.PreviousHelp}" AutomationProperties.Name="{Binding Model.PreviousHelp}">
                        <TextBlock Text="&#xE76B;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Secondary}" Margin="6,2" />
                      </Button>
                      <Button Style="{StaticResource Plain}" Command="{Binding Model.Next}" ToolTip="{Binding Model.NextHelp}" AutomationProperties.Name="{Binding Model.NextHelp}">
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Secondary}" Margin="6,2,0,2" />
                      </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding Model.CurrentDate}" FontSize="10.5" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" />
                  </DockPanel>
                </Grid>
              </Button>

              <!-- Dos celdas en una fila: tres notas en lista, con el título y la fecha -->
              <ItemsControl ItemsSource="{Binding Model.Top3}" ItemTemplate="{StaticResource NoteListRowTight}" Focusable="False" Visibility="{Binding WideFlat, Converter={StaticResource Visible}}" />

              <!-- Una celda y dos filas: la lista larga con título, fecha y vista previa -->
              <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="{Binding BodyMax}" Visibility="{Binding CompactTall, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Model.Top9}" ItemTemplate="{StaticResource NoteListRow}" Focusable="False" />
              </ScrollViewer>

              <!-- Dos celdas y dos filas: la lista a la izquierda y la nota elegida, editable, a la derecha -->
              <Grid Visibility="{Binding WideTall, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="{Binding BodyMax}">
                  <ItemsControl ItemsSource="{Binding Model.Top9}" ItemTemplate="{StaticResource NoteListRow}" Focusable="False" />
                </ScrollViewer>
                <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Center" Fill="{DynamicResource Line}" />
                <Grid Grid.Column="2">
                  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <TextBox Style="{StaticResource NoteEditor}" Text="{Binding Model.Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Model.EditorName}" MaxHeight="{Binding BodyMax}" />
                  <TextBlock Grid.Row="1" Text="{Binding Model.CurrentDate}" FontSize="10.5" Foreground="{DynamicResource Secondary}" Margin="0,4,0,0" />
                </Grid>
              </Grid>
            </Grid>
            <DockPanel Grid.Row="1" Margin="0,3,0,0" Visibility="{Binding Model.HasStatus, Converter={StaticResource Visible}}">
              <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding Model.UndoDelete}" Visibility="{Binding Model.HasUndoDelete, Converter={StaticResource Visible}}"
                      Content="{Binding Model.UndoDeleteLabel}" AutomationProperties.Name="{Binding Model.UndoDeleteHelp}" ToolTip="{Binding Model.UndoDeleteHelp}" Margin="4,0" />
              <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding Model.DismissStatus}" AutomationProperties.Name="{Binding Model.DismissStatusHelp}" ToolTip="{Binding Model.DismissStatusHelp}" Margin="2,0">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{DynamicResource Secondary}" />
              </Button>
              <TextBlock Text="{Binding Model.StatusText}" ToolTip="{Binding Model.StatusText}" FontSize="10.5" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" VerticalAlignment="Center" />
            </DockPanel>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ============ Tareas (TodoList) ============ -->
    <!-- Los colores y medidas son los de Nusa, medidos en su grabación (Theme.cs: Todo*). Todo lo que se pulsa es un Button o un TextBox: la ventana del notch no cuenta esos clics como «clic en vacío» (que fija el panel). -->
    <!-- Píldora de la columna de acciones: gris; «Añadir» y «Editar» pasan a verde mientras su modo está activo. -->
    <Style x:Key="TodoPill" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource TodoPill}" />
      <Setter Property="Foreground" Value="{DynamicResource TodoText}" />
      <Setter Property="FontFamily" Value="{StaticResource Sans}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="6,0,7,0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.92" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.7" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TodoPillAdd" TargetType="Button" BasedOn="{StaticResource TodoPill}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding AddActive}" Value="True">
          <Setter Property="Background" Value="{DynamicResource TodoGreenSoft}" />
          <Setter Property="Foreground" Value="{DynamicResource TodoGreen}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TodoPillEdit" TargetType="Button" BasedOn="{StaticResource TodoPill}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding EditEnabled}" Value="False">
          <Setter Property="Background" Value="{DynamicResource TodoPillOff}" />
          <Setter Property="Foreground" Value="{DynamicResource TodoOff}" />
          <Setter Property="Opacity" Value="1" />
          <Setter Property="Cursor" Value="Arrow" />
        </DataTrigger>
        <DataTrigger Binding="{Binding EditActive}" Value="True">
          <Setter Property="Background" Value="{DynamicResource TodoGreenSoft}" />
          <Setter Property="Foreground" Value="{DynamicResource TodoGreen}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Botón redondo (calendario; + y ✎ en las vistas estrecha y ancha) -->
    <Style x:Key="TodoRound" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource TodoPill}" />
      <Setter Property="Foreground" Value="{DynamicResource TodoText}" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.92" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.7" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TodoRoundAdd" TargetType="Button" BasedOn="{StaticResource TodoRound}">
      <Style.Triggers><DataTrigger Binding="{Binding AddActive}" Value="True"><Setter Property="Background" Value="{DynamicResource TodoGreenSoft}" /><Setter Property="Foreground" Value="{DynamicResource TodoGreen}" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="TodoRoundEdit" TargetType="Button" BasedOn="{StaticResource TodoRound}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding EditEnabled}" Value="False">
          <Setter Property="Background" Value="{DynamicResource TodoPillOff}" /><Setter Property="Foreground" Value="{DynamicResource TodoOff}" /><Setter Property="Opacity" Value="1" /><Setter Property="Cursor" Value="Arrow" />
        </DataTrigger>
        <DataTrigger Binding="{Binding EditActive}" Value="True"><Setter Property="Background" Value="{DynamicResource TodoGreenSoft}" /><Setter Property="Foreground" Value="{DynamicResource TodoGreen}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- «Cancelar» y «Guardar» del formulario: píldoras de 22 px -->
    <Style x:Key="TodoFormButton" TargetType="Button" BasedOn="{StaticResource TodoPill}">
      <Setter Property="Height" Value="20" />
      <Setter Property="Background" Value="{DynamicResource TodoCancel}" />
      <Setter Property="Foreground" Value="{DynamicResource TodoWhite}" />
    </Style>
    <Style x:Key="TodoFormSave" TargetType="Button" BasedOn="{StaticResource TodoFormButton}">
      <Setter Property="Background" Value="{DynamicResource TodoGreen}" />
      <Setter Property="Foreground" Value="{DynamicResource TodoOnGreen}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- La chip «Daily» dentro del campo de la hora -->
    <Style x:Key="TodoChip" TargetType="Button" BasedOn="{StaticResource TodoPill}">
      <Setter Property="Height" Value="16" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Background" Value="{DynamicResource TodoChip}" />
      <Setter Property="Foreground" Value="{DynamicResource TodoChipText}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding FormDaily}" Value="True">
          <Setter Property="Background" Value="{DynamicResource TodoGreenSoft}" />
          <Setter Property="Foreground" Value="{DynamicResource TodoGreen}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Campo de la tarjeta de tareas: sin borde propio (lo pone el contenedor), cursor verde -->
    <Style x:Key="TodoInput" TargetType="TextBox">
      <EventSetter Event="TextChanged" Handler="TodoInputChanged" />
      <EventSetter Event="SizeChanged" Handler="TodoInputChanged" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TodoWhite}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TodoGreen}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource TodoDim}" />
      <Setter Property="FontFamily" Value="{StaticResource Sans}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalAlignment="Center" /></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TodoFieldBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource TodoField}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TodoLine}" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="Padding" Value="10,0,8,0" />
      <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource TodoRim}" /></Trigger></Style.Triggers>
    </Style>
    <!-- La barra de desplazamiento fina y blanca de la lista -->
    <Style x:Key="TodoScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="3" />
      <Setter Property="MinWidth" Value="3" />
      <Setter Property="Margin" Value="2,6,3,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource TodoBar}" CornerRadius="1.5" /></ControlTemplate></Thumb.Template></Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Una fila de 28 px (paso de 32): círculo para marcar, título (en «editar» abre el formulario), la hora y la repetición, y la ✕ roja que la borra solo en «editar».
         Con «editar» la fila gana fondo y borde de tarjeta. -->
    <DataTemplate DataType="{x:Type ui:TodoRow}">
      <Border x:Name="card" Height="28" Margin="4,2" CornerRadius="11" BorderThickness="1" BorderBrush="Transparent" Padding="5,0,0,0">
        <DockPanel>
          <!-- El hueco de la ✕ se reserva siempre (como en Nusa): el título se corta con «…» antes de llegar -->
          <Grid DockPanel.Dock="Right" Width="40">
            <Button x:Name="remove" Style="{StaticResource Plain}" Command="{Binding Remove}" Visibility="Collapsed" Cursor="Hand" HorizontalAlignment="Center"
                    AutomationProperties.Name="{Binding RemoveHelp}" ToolTip="{Binding RemoveHelp}">
              <Border Width="17" Height="17" CornerRadius="8.5" Background="{DynamicResource TodoRed}">
                <Path Data="M0,0 L6,6 M6,0 L0,6" Stroke="{DynamicResource TodoWhite}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="6" Height="6" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Button>
          </Grid>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" FontSize="10" Foreground="{DynamicResource TodoEmpty}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90"
                     Visibility="{Binding HasMeta, Converter={StaticResource Visible}}" />
          <Button DockPanel.Dock="Left" Style="{StaticResource Plain}" Command="{Binding Toggle}" Margin="0,0,6,0" VerticalAlignment="Center" Cursor="Hand"
                  AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
            <Border x:Name="dot" Width="14" Height="14" CornerRadius="7" BorderThickness="1.2" BorderBrush="{DynamicResource TodoDim}">
              <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="8" Foreground="{DynamicResource TodoOnGreen}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Border>
          </Button>
          <Button Style="{StaticResource Plain}" Command="{Binding Open}" HorizontalContentAlignment="Left" Cursor="Hand" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
            <TextBlock x:Name="title" Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource TodoWhite}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Button>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Done}" Value="True">
          <Setter TargetName="dot" Property="Background" Value="{DynamicResource TodoGreen}" />
          <Setter TargetName="dot" Property="BorderBrush" Value="{DynamicResource TodoGreen}" />
          <Setter TargetName="check" Property="Visibility" Value="Visible" />
          <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough" />
          <Setter TargetName="title" Property="Foreground" Value="{DynamicResource TodoDim}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding EditMode}" Value="True">
          <Setter TargetName="card" Property="Background" Value="{DynamicResource TodoRow}" />
          <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource TodoRowLine}" />
          <Setter TargetName="remove" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Al cambiar entre la lista y el formulario, el que entra se funde (Nusa: ~0,2 s) -->
    <Style x:Key="TodoListPane" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ShowList}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
          <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TodoFormPane" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ShowForm}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
          <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Una casilla del calendario: número pequeño; en verde si tiene tareas, atenuado fuera del mes, con anillo hoy y relleno el día elegido -->
    <DataTemplate DataType="{x:Type ui:TodoDay}">
      <Button Style="{StaticResource Plain}" Command="{Binding Select}" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}" Cursor="Hand" Margin="0.5">
        <Border x:Name="cell" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
          <TextBlock x:Name="num" Text="{Binding Text}" FontSize="9.5" Foreground="{DynamicResource TodoWhite}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding InMonth}" Value="False"><Setter TargetName="num" Property="Foreground" Value="{DynamicResource TodoHint}" /></DataTrigger>
        <DataTrigger Binding="{Binding HasTasks}" Value="True"><Setter TargetName="num" Property="Foreground" Value="{DynamicResource TodoGreen}" /><Setter TargetName="num" Property="FontWeight" Value="Bold" /></DataTrigger>
        <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource TodoRim}" /></DataTrigger>
        <DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="cell" Property="Background" Value="{DynamicResource TodoGreen}" /><Setter TargetName="num" Property="Foreground" Value="{DynamicResource TodoOnGreen}" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="TodoCalendarPane" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ShowCalendar}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
          <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- La tarjeta oscura (180 px en la vista corta): la lista (con «Sin tareas.» si está vacía) o, mientras se añade o edita, el formulario. Llena el alto de su hueco. -->
    <DataTemplate x:Key="TodoCard">
      <Border x:Name="cardHit" Background="{DynamicResource TodoCard}" CornerRadius="16" Padding="0,2">
        <Grid>
          <Grid Style="{StaticResource TodoListPane}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NoTasks, Converter={StaticResource Visible}}">
              <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource TodoGlyphBox}" HorizontalAlignment="Center">
                <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{DynamicResource TodoGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding EmptyText}" FontSize="12.5" Foreground="{DynamicResource TodoEmpty}" HorizontalAlignment="Center" Margin="0,9,0,0" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Visibility="{Binding HasTasks, Converter={StaticResource Visible}}">
              <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource TodoScrollBar}" /></ScrollViewer.Resources>
              <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
            </ScrollViewer>
          </Grid>
          <!-- El mes: ‹ mes año › (tocar el nombre vuelve a hoy) y la cuadrícula de 6 semanas -->
          <Grid Margin="6,3,6,3" Style="{StaticResource TodoCalendarPane}">
            <Grid.RowDefinitions><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
              <Button Style="{StaticResource Plain}" Command="{Binding PrevMonth}" Cursor="Hand" ToolTip="{Binding PrevMonthHelp}" AutomationProperties.Name="{Binding PrevMonthHelp}">
                <TextBlock Text="&#xE76B;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{DynamicResource TodoDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
              <Button Grid.Column="1" Style="{StaticResource Plain}" Command="{Binding GoToday}" Cursor="Hand" ToolTip="{Binding TodayHelp}" AutomationProperties.Name="{Binding TodayHelp}">
                <TextBlock Text="{Binding MonthLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TodoWhite}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
              <Button Grid.Column="2" Style="{StaticResource Plain}" Command="{Binding NextMonth}" Cursor="Hand" ToolTip="{Binding NextMonthHelp}" AutomationProperties.Name="{Binding NextMonthHelp}">
                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{DynamicResource TodoDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" Focusable="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </Grid>
          <Grid Margin="6,6,6,1" Style="{StaticResource TodoFormPane}">
            <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="3" /><RowDefinition Height="25" /><RowDefinition Height="5" /><RowDefinition Height="20" /></Grid.RowDefinitions>
            <!-- El anillo tenue de fuera del campo de título (Nusa lo dibuja siempre, como un foco) -->
            <Border Margin="-1" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource TodoGlow}" IsHitTestVisible="False" />
            <Border Style="{StaticResource TodoFieldBox}" CornerRadius="13" BorderBrush="{DynamicResource TodoRim}" Padding="6,0,8,0">
              <DockPanel>
                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{DynamicResource TodoGreen}" Margin="0,0,9,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding ClearTitle}" Margin="6,0,0,0" Cursor="Hand" ToolTip="{Binding ClearHelp}" AutomationProperties.Name="{Binding ClearHelp}"
                        Visibility="{Binding TitleFilled, Converter={StaticResource Visible}}">
                  <Border Width="14" Height="14" CornerRadius="7" Background="{DynamicResource TodoClear}">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource TodoField}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Button>
                <Grid>
                  <TextBlock Text="{Binding TitlePlaceholder}" FontSize="13" Foreground="{DynamicResource TodoHint}" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="{Binding TitleEmpty, Converter={StaticResource Visible}}" />
                  <TextBox Style="{StaticResource TodoInput}" Tag="TodoTitle" FontSize="13" Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="{Binding TitleName}" />
                </Grid>
              </DockPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource TodoFieldBox}" CornerRadius="12" Background="{DynamicResource TodoFill}" BorderBrush="{DynamicResource TodoLine}" Padding="4,0,4,0" BorderThickness="1">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE121;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource TodoWhite}" Margin="0,0,5,0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource TodoChip}" Command="{Binding ToggleDaily}" Margin="6,0,0,0" AutomationProperties.Name="{Binding DailyHelp}" ToolTip="{Binding DailyHelp}" Content="{Binding DailyLabel}" />
                <Grid>
                  <TextBlock Text="{Binding TimePlaceholder}" FontFamily="{StaticResource Sans}" FontSize="11" Foreground="{DynamicResource TodoHint}" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="{Binding TimeEmpty, Converter={StaticResource Visible}}" />
                  <TextBox Style="{StaticResource TodoInput}" Tag="TodoTime" Text="{Binding FormTime, UpdateSourceTrigger=PropertyChanged}" MaxLength="13" FontFamily="{StaticResource Sans}" FontSize="11" AutomationProperties.Name="{Binding TimeName}" />
                </Grid>
              </DockPanel>
            </Border>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource TodoFormButton}" Width="81" Margin="0,0,6,0" Command="{Binding Cancel}" Content="{Binding CancelLabel}" AutomationProperties.Name="{Binding CancelLabel}" />
              <Button Style="{StaticResource TodoFormSave}" Width="81" Command="{Binding Save}" Content="{Binding SaveLabel}" AutomationProperties.Name="{Binding SaveLabel}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- «TodoList» con «List» en verde -->
    <DataTemplate x:Key="TodoTitle">
      <TextBlock FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource Sans}"><Run Text="Todo" Foreground="{DynamicResource TodoWhite}" /><Run Text="List" Foreground="{DynamicResource TodoGreen}" /></TextBlock>
    </DataTemplate>

    <!-- El botón del calendario (con el punto azul de Nusa): abre el mes en la tarjeta; en verde mientras está abierto o se mira otro día -->
    <DataTemplate x:Key="TodoCalendar">
      <Button Width="26" Height="26" ToolTip="{Binding CalendarHelp}" AutomationProperties.Name="{Binding CalendarHelp}" Command="{Binding ToggleCalendar}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource TodoRound}">
            <Setter Property="Background" Value="{DynamicResource TodoCal}" />
            <Style.Triggers><DataTrigger Binding="{Binding CalendarActive}" Value="True"><Setter Property="Background" Value="{DynamicResource TodoGreenSoft}" /><Setter Property="Foreground" Value="{DynamicResource TodoGreen}" /></DataTrigger></Style.Triggers>
          </Style>
        </Button.Style>
        <Grid Width="26" Height="26">
          <TextBlock Text="&#xE787;" FontFamily="{StaticResource Icons}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Ellipse Width="6" Height="6" Fill="{DynamicResource TodoBlue}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" />
        </Grid>
      </Button>
    </DataTemplate>

    <!-- La vista de Nusa. Su Tag es el alto del hueco. Izquierda (152 px): contador «hechas hoy / total» con el calendario, «Task Done Today» y las píldoras Add / Edit; derecha: la tarjeta (180 px).
         Con el widget solo en la vista corta, al pasar el ratón por la tarjeta se ensancha sobre la columna y quedan dos botones redondos (+ y ✎) a la izquierda. -->
    <Style x:Key="TodoRoot" TargetType="Grid"><EventSetter Event="MouseLeave" Handler="TodoRootLeave" /></Style>
    <DataTemplate x:Key="TodoNusa">
      <Grid x:Name="root" Style="{StaticResource TodoRoot}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="152" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <!-- «TodoList» arriba a la izquierda: en la vista corta sale a la altura de la fecha, fuera del hueco del widget (como en Nusa); en el Home, dentro de la columna -->
        <ContentControl x:Name="head" ContentTemplate="{StaticResource TodoTitle}" Content="{Binding Model}" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Margin="-29,-22,0,0" />
        <Grid x:Name="info" DataContext="{Binding Model}" Margin="0,0,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="{Binding CountText}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TodoWhite}" LineHeight="36" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Left" />
          <ContentControl ContentTemplate="{StaticResource TodoCalendar}" Content="{Binding}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="68,0,0,0" />
          <TextBlock Grid.Row="1" Text="{Binding DoneLabel}" FontSize="12" Foreground="{DynamicResource TodoDim}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="-2,0,0,2">
            <Button Style="{StaticResource TodoPillAdd}" Command="{Binding AddTask}" AutomationProperties.Name="{Binding AddLabel}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal"><Border Width="13" Height="13" CornerRadius="6.5" Margin="0,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><Path Data="M1,3.5 H6 M3.5,1 V6" Stroke="{DynamicResource TodoField}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding AddLabel}" VerticalAlignment="Center" /></StackPanel>
            </Button>
            <Button Style="{StaticResource TodoPillEdit}" Command="{Binding EditTasks}" IsEnabled="{Binding EditEnabled}" AutomationProperties.Name="{Binding EditLabel}">
              <StackPanel Orientation="Horizontal"><Grid Margin="0,0,3,0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="14" Height="14"><Path Data="M1.4,9.2 L2.2,6.2 L8.6,-0.2 L11.2,2.4 L4.8,8.8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" Margin="0,1,0,0" /><Rectangle Height="1.6" Width="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Grid><TextBlock Text="{Binding EditLabel}" VerticalAlignment="Center" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <StackPanel x:Name="rounds" DataContext="{Binding Model}" Visibility="Collapsed" VerticalAlignment="Stretch" HorizontalAlignment="Left" Width="34" Background="Transparent">
          <Button Style="{StaticResource TodoRoundAdd}" Command="{Binding AddTask}" ToolTip="{Binding AddLabel}" AutomationProperties.Name="{Binding AddLabel}" Margin="-3,12,0,0" HorizontalAlignment="Left">
            <Border Width="16" Height="16" CornerRadius="8.0"  VerticalAlignment="Center" HorizontalAlignment="Center" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><Path Data="M1.75,5 H8.25 M5,1.75 V8.25" Stroke="{DynamicResource TodoField}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          </Button>
          <Button Style="{StaticResource TodoRoundEdit}" Command="{Binding EditTasks}" IsEnabled="{Binding EditEnabled}" ToolTip="{Binding EditLabel}" AutomationProperties.Name="{Binding EditLabel}" Margin="-3,10,0,0" HorizontalAlignment="Left">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="14" Height="14"><Path Data="M1.4,9.2 L2.2,6.2 L8.6,-0.2 L11.2,2.4 L4.8,8.8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" Margin="0,1,0,0" /><Rectangle Height="1.6" Width="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Grid>
          </Button>
        </StackPanel>
        <ContentControl x:Name="card" Grid.Column="1" Content="{Binding Model}" ContentTemplate="{StaticResource TodoCard}" Cursor="Hand">
          <ContentControl.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding Model.ToggleWide}" /></ContentControl.InputBindings>
        </ContentControl>
      </Grid>
      <DataTemplate.Triggers>
        <!-- Fuera de la vista corta con el widget solo, el título va dentro de la columna -->
        <DataTrigger Binding="{Binding Wide}" Value="False">
          <Setter TargetName="root" Property="Width" Value="332" />
          <Setter TargetName="root" Property="Margin" Value="26,-6,0,6" />
          <Setter TargetName="root" Property="HorizontalAlignment" Value="Left" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Wide}" Value="True">
          <Setter TargetName="head" Property="Margin" Value="0" />
          <Setter TargetName="info" Property="Margin" Value="0,20,0,0" />
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Wide}" Value="False" />
            <Condition Binding="{Binding Model.WideHover}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="info" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="rounds" Property="Visibility" Value="Visible" />
          <Setter TargetName="card" Property="Grid.Column" Value="0" />
          <Setter TargetName="card" Property="Grid.ColumnSpan" Value="2" />
          <Setter TargetName="card" Property="Margin" Value="34,0,0,0" />
        </MultiDataTrigger>
        <!-- Sigue ancho mientras el ratón está en los botones redondos (como en Nusa) -->
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Wide}" Value="False" />
            <Condition Binding="{Binding IsMouseOver, ElementName=rounds}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="info" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="rounds" Property="Visibility" Value="Visible" />
          <Setter TargetName="card" Property="Grid.Column" Value="0" />
          <Setter TargetName="card" Property="Grid.ColumnSpan" Value="2" />
          <Setter TargetName="card" Property="Margin" Value="34,0,0,0" />
        </MultiDataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Una celda dentro de una lista de widgets: arriba el título con el contador y los botones redondos (+ y ✎), debajo la tarjeta. Su Tag es el alto. -->
    <DataTemplate x:Key="TodoCompact">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel DataContext="{Binding Model}" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <ContentControl ContentTemplate="{StaticResource TodoCalendar}" Content="{Binding}" Margin="0,0,4,0" />
            <Button Style="{StaticResource TodoRoundAdd}" Command="{Binding AddTask}" Margin="0,0,4,0" ToolTip="{Binding AddLabel}" AutomationProperties.Name="{Binding AddLabel}">
              <Border Width="16" Height="16" CornerRadius="8.0"  VerticalAlignment="Center" HorizontalAlignment="Center" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><Path Data="M1.75,5 H8.25 M5,1.75 V8.25" Stroke="{DynamicResource TodoField}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Button>
            <Button Style="{StaticResource TodoRoundEdit}" Command="{Binding EditTasks}" IsEnabled="{Binding EditEnabled}" ToolTip="{Binding EditLabel}" AutomationProperties.Name="{Binding EditLabel}">
              <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="14" Height="14"><Path Data="M1.4,9.2 L2.2,6.2 L8.6,-0.2 L11.2,2.4 L4.8,8.8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" Margin="0,1,0,0" /><Rectangle Height="1.6" Width="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Grid>
            </Button>
          </StackPanel>
          <ContentControl ContentTemplate="{StaticResource TodoTitle}" Content="{Binding}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TodoDim}" Margin="9,1,0,0" VerticalAlignment="Center" ToolTip="{Binding DoneLabel}" />
        </DockPanel>
        <ContentControl Grid.Row="1" Content="{Binding Model}" ContentTemplate="{StaticResource TodoCard}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WidgetTodoWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <!-- La vista de Nusa: con el widget solo en la vista corta (Bare) y con dos celdas (Wide). Las filas son de una línea, así que la vista corta y la completa comparten diseño
               (no hace falta una variante densa aparte); dos filas solo alargan la tarjeta. -->
          <Grid>
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Bare}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  <DataTrigger Binding="{Binding Wide}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TodoNusa}" VerticalAlignment="Center">
              <ContentControl.Style>
                <Style TargetType="ContentControl"><Setter Property="Height" Value="91" /><Style.Triggers><DataTrigger Binding="{Binding Wide}" Value="True"><Setter Property="Height" Value="120" /></DataTrigger><DataTrigger Binding="{Binding Tall}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
              </ContentControl.Style>
            </ContentControl>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TodoNusa}" Height="{Binding BodyMax}" VerticalAlignment="Center" Visibility="{Binding Tall, Converter={StaticResource Visible}}" />
          </Grid>
          <!-- Una celda dentro de una lista de widgets -->
          <Grid>
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Bare}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                  <DataTrigger Binding="{Binding Wide}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TodoCompact}" Height="124" Visibility="{Binding CompactFlat, Converter={StaticResource Visible}}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TodoCompact}" Height="{Binding BodyMax}" Visibility="{Binding CompactTall, Converter={StaticResource Visible}}" />
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Código: 1×1 resume el stack y el README del proyecto; las vistas anchas abren el IDE completo. La vista corta sigue siendo solo lectura. -->
    <DataTemplate DataType="{x:Type ui:CodeRow}">
      <Button Style="{StaticResource Plain}" Command="{Binding Click}" AutomationProperties.Name="{Binding Help}" ToolTip="{Binding Path}">
        <Border x:Name="row" Background="Transparent" Padding="4,3" CornerRadius="5">
          <DockPanel Margin="{Binding Indent}">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Chevron}" FontFamily="{StaticResource Icons}" FontSize="9" Width="12" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" />
            <Grid DockPanel.Dock="Left" Width="23" VerticalAlignment="Center">
              <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" Visibility="{Binding HasIcon, Converter={StaticResource Visible}}" />
              <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" Visibility="{Binding NoIcon, Converter={StaticResource Visible}}" />
            </Grid>
            <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Active}" Value="True">
          <Setter TargetName="row" Property="Background" Value="{DynamicResource ButtonHover}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type ui:CodeTab}">
      <Border x:Name="tab" CornerRadius="6" Margin="0,0,4,0" Background="Transparent">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource Plain}" Command="{Binding Select}" AutomationProperties.Name="{Binding SelectHelp}" ToolTip="{Binding Path}">
            <TextBlock x:Name="label" Text="{Binding Label}" FontSize="11.5" Margin="8,5,4,5" MaxWidth="150" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg}" />
          </Button>
          <Button Style="{StaticResource Plain}" Command="{Binding Close}" AutomationProperties.Name="{Binding CloseHelp}" ToolTip="{Binding CloseHelp}">
            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9" Margin="2,0,7,0" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Active}" Value="True">
          <Setter TargetName="tab" Property="Background" Value="{DynamicResource ButtonHover}" />
          <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Fg}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ Estante (colores y medidas tomados del de Nusa): un mosaico por archivo de 68×89 (icono de 44, nombre en negrita y tamaño gris); al pasar el ratón se aclara y sale la ✕;
         en «Elegir» lleva un círculo arriba a la izquierda y, marcado, fondo y borde azules. Clic abre, clic derecho copia el archivo, se arrastra hacia fuera. ============ -->
    <DataTemplate x:Key="ShelfTileCell">
      <Button x:Name="tileButton" Style="{StaticResource Plain}" Command="{Binding Activate}" ui:FileDrag.Path="{Binding Path}" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}" Cursor="Hand">
        <Button.InputBindings><MouseBinding Gesture="RightClick" Command="{Binding Copy}" /></Button.InputBindings>
        <Grid x:Name="root" Width="68" Height="89">
          <Border x:Name="bg" CornerRadius="11" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" />
          <StackPanel Margin="0,10,0,0">
            <Image Source="{Binding Icon}" Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" MaxWidth="62" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Detail}" FontSize="9.5" Foreground="{DynamicResource ShelfSize}" HorizontalAlignment="Center" MaxWidth="62" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Ellipse x:Name="circle" Width="13" Height="13" Stroke="#DEDEDE" StrokeThickness="1.3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,3,0,0" Visibility="Collapsed" IsHitTestVisible="False" />
          <Grid x:Name="check" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,3,0,0" Visibility="Collapsed" IsHitTestVisible="False">
            <Ellipse Fill="{DynamicResource ShelfCheck}" />
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="7.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <Button x:Name="remove" Style="{StaticResource Plain}" Command="{Binding Remove}" ToolTip="{Binding RemoveHelp}" AutomationProperties.Name="{Binding RemoveHelp}" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,5,0" Visibility="Collapsed">
            <Border Width="13" Height="13" CornerRadius="7" Background="{DynamicResource ShelfX}"><TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="6.5" Foreground="{DynamicResource ShelfXText}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          </Button>
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <Trigger SourceName="root" Property="IsMouseOver" Value="True">
          <Setter TargetName="bg" Property="Background" Value="{DynamicResource ShelfHover}" />
          <Setter TargetName="remove" Property="Visibility" Value="Visible" />
        </Trigger>
        <DataTrigger Binding="{Binding Selecting}" Value="True"><Setter TargetName="circle" Property="Visibility" Value="Visible" /></DataTrigger>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="check" Property="Visibility" Value="Visible" />
          <Setter TargetName="circle" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="bg" Property="Background" Value="{DynamicResource ShelfSelectedFill}" />
          <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource ShelfSelectedEdge}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Una chip de la cabecera del Estante (16 de alto, redonda): el color de fondo y el del texto los pone cada uso -->
    <Style x:Key="ShelfChip" TargetType="Button" BasedOn="{StaticResource Plain}">
      <Setter Property="Background" Value="{DynamicResource ShelfChip}" />
      <Setter Property="Foreground" Value="{DynamicResource ShelfChipText}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="chip" CornerRadius="8" Height="16" Padding="8,0" Background="{TemplateBinding Background}">
              <TextBlock Text="{TemplateBinding Content}" FontSize="10" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chip" Property="Opacity" Value="0.8" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Una celda, dos celdas, la vista corta (la zona vacía conserva su pista salvo en una celda en una fila), dos filas (varias filas de mosaicos) y sola en su lista (WideAlone: no necesita otra vista, la zona ya llena su celda). -->
    <DataTemplate x:Key="WidgetShelfWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding ShelfWidth}" Margin="{Binding ShelfMargin}">
        <Grid>
          <!-- Al arrastrar, un halo turquesa a la izquierda y violeta a la derecha abraza la zona de suelta sin cambiar el tamaño del notch. -->
          <Grid IsHitTestVisible="False">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="Margin" Value="-14,-8,-14,-12" />
                <Style.Triggers>
                  <!-- Solo en la vista corta: el halo sube hasta el borde de arriba del notch para que la cabecera no quede cortada del fondo -->
                  <DataTrigger Binding="{Binding Bare}" Value="True">
                    <Setter Property="Margin" Value="-14,-70,-14,-18" />
                    <!-- La cabecera sigue en negro puro y el color nace de abajo (como en Nusa): sin esta máscara el tinte lateral cubría también la cabecera y la separaba del fondo -->
                    <Setter Property="OpacityMask">
                      <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="Transparent" Offset="0" /><GradientStop Color="Transparent" Offset="0.4" /><GradientStop Color="#99000000" Offset="0.7" /><GradientStop Color="Black" Offset="1" />
                        </LinearGradientBrush>
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding Model.Dragging}" Value="True" /><Condition Binding="{Binding Model.ReducedMotion}" Value="False" /></MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.42"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding Model.Dragging}" Value="True" /><Condition Binding="{Binding Model.ReducedMotion}" Value="True" /></MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="1" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Border CornerRadius="0,0,22,22" Background="{DynamicResource ShelfAuraHorizontal}" />
            <Border CornerRadius="0,0,22,22" Background="{DynamicResource ShelfAuraVertical}" />
          </Grid>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,2">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Style.Triggers><DataTrigger Binding="{Binding Bare}" Value="True"><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-31" /></Setter.Value></Setter></DataTrigger></Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Model.HeaderTitle}" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13.5" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Bare}" Value="True">
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="FontWeight" Value="Bold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Button Grid.Column="1" Command="{Binding Model.ToggleSelect}" Content="{Binding Model.SelectLabel}" ToolTip="{Binding Model.SelectHelp}" AutomationProperties.Name="{Binding Model.SelectHelp}" Cursor="Hand" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding Model.HasContent, Converter={StaticResource Visible}}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource ShelfChip}">
                    <Style.Triggers><DataTrigger Binding="{Binding Model.Selecting}" Value="True"><Setter Property="Background" Value="{DynamicResource ShelfDoneChip}" /><Setter Property="Foreground" Value="{DynamicResource ShelfDoneText}" /></DataTrigger></Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button x:Name="clearAllButton" Grid.Column="3" Command="{Binding Model.ClearOrRemove}" Content="{Binding Model.ClearLabel}" ToolTip="{Binding Model.ClearHelp}" AutomationProperties.Name="{Binding Model.ClearHelp}" Cursor="Hand" VerticalAlignment="Center" Visibility="{Binding Model.HasContent, Converter={StaticResource Visible}}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource ShelfChip}">
                    <Setter Property="Background" Value="{DynamicResource ShelfDangerChip}" /><Setter Property="Foreground" Value="{DynamicResource ShelfDangerText}" />
                  </Style>
                </Button.Style>
              </Button>
            </Grid>

            <!-- Con archivos, una fila que se desplaza de lado (rueda del ratón) o, con dos filas, varias filas; durante un arrastre se ocultan -->
            <ScrollViewer Grid.Row="1" ui:ShelfScroll.Wheel="True" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" VerticalAlignment="Top">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Bare}" Value="True">
                      <Setter Property="Margin" Value="24,0,24,0" />
                      <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-22" /></Setter.Value></Setter>
                    </DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Model.HasContent}" Value="True" /><Condition Binding="{Binding Tall}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                    <DataTrigger Binding="{Binding Model.Dragging}" Value="True"><Setter Property="Opacity" Value="0" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <ItemsControl ItemsSource="{Binding Model.Tiles}" ItemTemplate="{StaticResource ShelfTileCell}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Bare}" Value="True"><Setter Property="Margin" Value="24,0,24,0" /></DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Model.HasContent}" Value="True" /><Condition Binding="{Binding Tall}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                    <DataTrigger Binding="{Binding Model.Dragging}" Value="True"><Setter Property="Opacity" Value="0" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <ItemsControl ItemsSource="{Binding Model.Tiles}" ItemTemplate="{StaticResource ShelfTileCell}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>

            <!-- La zona de rayas: vacía, o con un arrastre encima («Suelta para añadir», borde blanco y fondo claro) -->
            <Grid Grid.Row="1" MinHeight="52" AllowDrop="True">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <!-- El marco crece dentro del alto fijo del widget; el margen compensa para no agrandar el notch. -->
                    <DataTrigger Binding="{Binding Bare}" Value="True">
                      <Setter Property="Height" Value="92" />
                      <Setter Property="VerticalAlignment" Value="Top" />
                      <Setter Property="Margin" Value="24,-6,24,-20" />
                      <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-20" /></Setter.Value></Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Model.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding Model.Dragging}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Rectangle RadiusX="20" RadiusY="20" StrokeThickness="1.4" StrokeDashArray="3.2 2.6">
                <Rectangle.Style>
                  <Style TargetType="Rectangle">
                    <Setter Property="Stroke" Value="{DynamicResource ShelfDash}" /><Setter Property="Fill" Value="{DynamicResource ShelfZone}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Model.Dragging}" Value="True">
                        <Setter Property="Stroke" Value="{DynamicResource ShelfDropStroke}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Rectangle.Style>
              </Rectangle>
              <Border Margin="1" CornerRadius="19" Background="{DynamicResource ShelfDropActive}" IsHitTestVisible="False">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions><Condition Binding="{Binding Model.Dragging}" Value="True" /><Condition Binding="{Binding Model.ReducedMotion}" Value="False" /></MultiDataTrigger.Conditions>
                        <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                        <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.38"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
                      </MultiDataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions><Condition Binding="{Binding Model.Dragging}" Value="True" /><Condition Binding="{Binding Model.ReducedMotion}" Value="True" /></MultiDataTrigger.Conditions>
                        <Setter Property="Opacity" Value="1" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Margin" Value="10,4" />
                    <Style.Triggers><DataTrigger Binding="{Binding Bare}" Value="True"><Setter Property="Margin" Value="10,5,10,0" /></DataTrigger></Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <Viewbox HorizontalAlignment="Center">
                  <Viewbox.Style>
                    <Style TargetType="Viewbox">
                      <Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Margin" Value="0,0,0,3" />
                      <!-- Como en Nusa: el icono mide unos 29 × 33 y deja unos 9 px hasta el texto -->
                      <Style.Triggers><DataTrigger Binding="{Binding Bare}" Value="True"><Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Margin" Value="0,0,0,7" /></DataTrigger></Style.Triggers>
                    </Style>
                  </Viewbox.Style>
                  <Canvas Width="26" Height="26">
                  <Path Fill="{DynamicResource ShelfTray}" Data="M0,15 H8 L9.5,18.5 H16.5 L18,15 H26 V23.5 Q26,26 23.5,26 H2.5 Q0,26 0,23.5 Z" />
                  <Path Fill="{DynamicResource ShelfTray}" Opacity="0.82" Data="M0,21 H26 V23.5 Q26,26 23.5,26 H2.5 Q0,26 0,23.5 Z" />
                  <Path Data="M10,0 H16 V6 H20 L13,13.5 L6,6 H10 Z">
                    <Path.Style>
                      <Style TargetType="Path">
                        <Setter Property="Fill" Value="{DynamicResource ShelfArrow}" />
                        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform /></Setter.Value></Setter>
                        <Style.Triggers>
                          <!-- La flecha «deja caer» el archivo en la bandeja: despacio en reposo, más rápido y más honda al arrastrar; quieta con el movimiento reducido -->
                          <DataTrigger Binding="{Binding Model.ReducedMotion}" Value="False">
                            <DataTrigger.EnterActions><BeginStoryboard x:Name="arrowBob">
                              <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.Y" Duration="0:0:2.0">
                                  <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="0" />
                                  <SplineDoubleKeyFrame KeyTime="0:0:1.00" Value="4.5" KeySpline="0.5,0 0.2,1" />
                                  <SplineDoubleKeyFrame KeyTime="0:0:1.12" Value="4.5" />
                                  <SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="0" KeySpline="0.3,0 0.2,1" />
                                </DoubleAnimationUsingKeyFrames>
                              </Storyboard>
                            </BeginStoryboard></DataTrigger.EnterActions>
                            <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="arrowBob" /></DataTrigger.ExitActions>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Model.Dragging}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource ShelfDropText}" />
                          </DataTrigger>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding Model.ReducedMotion}" Value="False" />
                              <Condition Binding="{Binding Model.Dragging}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions><BeginStoryboard x:Name="arrowBobFast">
                              <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.Y" Duration="0:0:1.1">
                                  <SplineDoubleKeyFrame KeyTime="0:0:0.1" Value="0" />
                                  <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="6" KeySpline="0.5,0 0.2,1" />
                                  <SplineDoubleKeyFrame KeyTime="0:0:0.53" Value="6" />
                                  <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0" KeySpline="0.3,0 0.2,1" />
                                </DoubleAnimationUsingKeyFrames>
                              </Storyboard>
                            </BeginStoryboard></MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="arrowBobFast" /></MultiDataTrigger.ExitActions>
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Path.Style>
                  </Path>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="{Binding Model.DropText}" FontSize="13.5" FontWeight="Normal" Foreground="{DynamicResource ShelfDropText}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Model.DropHint}" FontSize="9.5" Foreground="{DynamicResource ShelfHint}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1,0,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CompactPeek}" Value="True" /><Condition Binding="{Binding Bare}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger>
                        <DataTrigger Binding="{Binding Model.Dragging}" Value="True"><Setter Property="Opacity" Value="0" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Grid>
          </Grid>
          <ui:ShelfRipple Source="{Binding Model}">
            <ui:ShelfRipple.Style>
              <Style TargetType="ui:ShelfRipple">
                <Setter Property="Margin" Value="-12,-8" />
                <!-- En la vista corta sola, la luz que sigue al ratón llega hasta el borde de arriba del notch: si se recortara en la tarjeta, dibujaría una raya bajo la cabecera -->
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Bare}" Value="True">
                    <Setter Property="Margin" Value="-12,-70,-12,-12" />
                    <!-- La luz nace desde cero bajo la cabecera (el borde de la tarjeta queda a 70 px): así se funde con el negro y no deja una línea -->
                    <Setter Property="OpacityMask">
                      <Setter.Value>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,140">
                          <GradientStop Color="Transparent" Offset="0.5" />
                          <GradientStop Color="#66000000" Offset="0.68" />
                          <GradientStop Color="Black" Offset="0.92" />
                        </LinearGradientBrush>
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:ShelfRipple.Style>
          </ui:ShelfRipple>
          <ui:ShelfRemovalAnimation Source="{Binding Model}" Target="{Binding ElementName=clearAllButton}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="WidgetCodeWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding Full, Converter={StaticResource Visible}}">
              <Button Style="{StaticResource Plain}" Command="{Binding Model.Overwrite}" AutomationProperties.Name="{Binding Model.OverwriteHelp}" ToolTip="{Binding Model.OverwriteHelp}"
                      Visibility="{Binding Model.Conflict, Converter={StaticResource Visible}}">
                <Border Width="28" Height="24" CornerRadius="6"><TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Warm}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              </Button>
              <Button Style="{StaticResource Plain}" Command="{Binding Model.Save}" AutomationProperties.Name="{Binding Model.SaveHelp}" ToolTip="{Binding Model.SaveHelp}"
                      Visibility="{Binding Model.ShowText, Converter={StaticResource Visible}}">
                <Border Width="28" Height="24" CornerRadius="6"><TextBlock Text="&#xE74E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              </Button>
              <Button Style="{StaticResource Plain}" Command="{Binding Model.Reload}" AutomationProperties.Name="{Binding Model.ReloadHelp}" ToolTip="{Binding Model.ReloadHelp}"
                      Visibility="{Binding Model.ShowText, Converter={StaticResource Visible}}">
                <Border Width="28" Height="24" CornerRadius="6"><TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              </Button>
              <Button Style="{StaticResource Plain}" Command="{Binding Model.Refresh}" AutomationProperties.Name="{Binding Model.RefreshHelp}" ToolTip="{Binding Model.RefreshHelp}"
                      Visibility="{Binding Model.HasRoot, Converter={StaticResource Visible}}">
                <Border Width="28" Height="24" CornerRadius="6"><TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              </Button>
              <Button Style="{StaticResource Plain}" Command="{Binding Model.OpenFolder}" AutomationProperties.Name="{Binding Model.OpenFolderHelp}" ToolTip="{Binding Model.OpenFolderHelp}"
                      Visibility="{Binding Model.HasRoot, Converter={StaticResource Visible}}">
                <Border Width="28" Height="24" CornerRadius="6"><TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              </Button>
            </StackPanel>
            <Button x:Name="compactOpen" DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding Model.OpenFolder}" AutomationProperties.Name="{Binding Model.OpenFolderHelp}"
                    ToolTip="{Binding Model.OpenFolderHelp}" Visibility="Collapsed" Margin="0,0,6,0">
              <Border Width="28" Height="24" CornerRadius="6"><TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Button>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Model.Glyph}" Style="{StaticResource HeadGlyph}" FontFamily="{StaticResource Icons}" FontSize="12"
                       Foreground="{DynamicResource Secondary}" Margin="0,1,7,0" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding Model.Title}" Style="{StaticResource HeadTitle}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Model.ShortStatus}" ToolTip="{Binding Model.Status}" FontSize="11" Foreground="{DynamicResource Fg}" Margin="14,0,8,0" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Visibility="{Binding Full, Converter={StaticResource Visible}}" />
          </DockPanel>

          <StackPanel x:Name="peekPanel" Visibility="{Binding Peek, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Model.Summary}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
            <!-- Las pestañas abiertas -->
            <ItemsControl ItemsSource="{Binding Model.PeekTabs}" Focusable="False" Margin="0,7,0,0" Visibility="{Binding Model.HasPeekTabs, Converter={StaticResource Visible}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Style="{StaticResource Plain}" Command="{Binding Select}" AutomationProperties.Name="{Binding SelectHelp}" ToolTip="{Binding SelectHelp}" Margin="0,0,6,0">
                  <Border x:Name="tab" CornerRadius="9" Padding="10,3,10,4" Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <TextBlock x:Name="tabLabel" Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource Secondary}" />
                  </Border>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter TargetName="tab" Property="Background" Value="{DynamicResource ButtonBg}" />
                    <Setter TargetName="tabLabel" Property="Foreground" Value="{DynamicResource Fg}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Los archivos y carpetas de primer nivel -->
            <ItemsControl ItemsSource="{Binding Model.PeekRows}" Focusable="False" Margin="0,7,0,0" MaxHeight="62" ClipToBounds="True" Visibility="{Binding Model.HasPeekRows, Converter={StaticResource Visible}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Style="{StaticResource Plain}" Command="{Binding Click}" AutomationProperties.Name="{Binding Help}" ToolTip="{Binding Help}" Margin="0,0,6,6">
                  <Border CornerRadius="9" Padding="7,3,10,3" Background="{DynamicResource Track}">
                    <StackPanel Orientation="Horizontal">
                      <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding HasIcon, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" MaxWidth="120" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel x:Name="fullPanel" Visibility="{Binding Full, Converter={StaticResource Visible}}">
            <StackPanel Visibility="{Binding Model.NoRoot, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding Model.EmptyText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
              <Button Style="{StaticResource Bordered}" Command="{Binding Model.OpenFolder}" AutomationProperties.Name="{Binding Model.OpenFolderLabel}" ToolTip="{Binding Model.OpenFolderHelp}"
                      HorizontalAlignment="Left" Margin="0,10,0,0">
                <TextBlock Text="{Binding Model.OpenFolderLabel}" />
              </Button>
            </StackPanel>

            <Grid Visibility="{Binding Model.HasRoot, Converter={StaticResource Visible}}">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Height" Value="240" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WideAlone}" Value="True"><Setter Property="Height" Value="330" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Background="{DynamicResource Track}" CornerRadius="6" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Model.Rows}" Focusable="False" Margin="3" />
                </ScrollViewer>
              </Border>
              <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6" Visibility="{Binding Model.HasTabs, Converter={StaticResource Visible}}">
                  <ItemsControl ItemsSource="{Binding Model.Tabs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </ScrollViewer>
                <Grid Grid.Row="1">
                  <TextBlock Text="{Binding Model.NoTabsText}" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding Model.NoTabs, Converter={StaticResource Visible}}" />
                  <Border CornerRadius="6" BorderThickness="1" Background="{DynamicResource Track}" Visibility="{Binding Model.ShowText, Converter={StaticResource Visible}}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                        <Style.Triggers>
                          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Muted}" /></Trigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <ui:CodeEditor Source="{Binding Model.ActiveText, Mode=TwoWay}" FileName="{Binding Model.ActiveName}" Foreground="{DynamicResource Fg}"
                                   AutomationProperties.Name="{Binding Model.EditorName}">
                      <ui:CodeEditor.InputBindings>
                        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding Model.Save}" />
                        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding Model.CloseActive}" />
                      </ui:CodeEditor.InputBindings>
                    </ui:CodeEditor>
                  </Border>
                  <Image Source="{Binding Model.ActiveImage}" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"
                         Visibility="{Binding Model.ShowImage, Converter={StaticResource Visible}}" />
                  <TextBlock Text="{Binding Model.ActiveMessage}" Style="{StaticResource Hint}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="12" Visibility="{Binding Model.ShowMessage, Converter={StaticResource Visible}}" />
                </Grid>
              </Grid>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="compactOverview" Visibility="Collapsed" Margin="0,1,0,0">
            <TextBlock Text="{Binding Model.RootName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
            <Border Background="{DynamicResource Track}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left" Margin="0,5,0,0" MaxWidth="250">
              <TextBlock Text="{Binding Model.ProjectStack}" Style="{StaticResource Eyebrow}" FontSize="10" TextTrimming="CharacterEllipsis" />
            </Border>
            <TextBlock Text="{Binding Model.ProjectSummary}" Style="{StaticResource Hint}" FontSize="11.5" MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Compact}" Value="True">
          <Setter TargetName="peekPanel" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="fullPanel" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="compactOpen" Property="Visibility" Value="Visible" />
          <Setter TargetName="compactOverview" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Batería: con dos celdas, el porcentaje y la barra en una fila. -->
    <!-- Baterías de los aparatos, como el widget de baterías de iOS. Un anillo con el icono del aparato dentro y su nivel debajo (una celda y dos celdas en
         una fila), y una lista con icono, nombre, nivel y una barra (las vistas altas). -->
    <DataTemplate x:Key="DeviceRingSmall">
      <StackPanel Width="68" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}">
        <Grid Width="48" Height="48" HorizontalAlignment="Center">
          <ui:ArcGauge Width="48" Height="48" Progress="{Binding Fraction}" Alert="{Binding Low}" />
          <ui:DeviceIcon Kind="{Binding Kind}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding Label}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" Margin="0,5,0,0" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="DeviceRingNamed">
      <StackPanel Width="92" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}">
        <Grid Width="54" Height="54" HorizontalAlignment="Center">
          <ui:ArcGauge Width="54" Height="54" Progress="{Binding Fraction}" Alert="{Binding Low}" />
          <ui:DeviceIcon Kind="{Binding Kind}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding Label}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" Margin="0,5,0,0" />
        <TextBlock Text="{Binding Name}" Style="{StaticResource Hint}" FontSize="10.5" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="4,1,4,0" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="DeviceBatteryLine">
      <Grid Height="42" Margin="0,0,0,2" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Track}" VerticalAlignment="Center">
          <ui:DeviceIcon Kind="{Binding Kind}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="11,0,8,0" />
        <Grid Grid.Column="2" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Visibility="{Binding Charging, Converter={StaticResource Visible}}" />
          <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Fg}" TextAlignment="Right" />
        </Grid>
        <ui:MemoryBar Grid.Column="3" Width="46" Height="8" Margin="12,0,0,0" Used="{Binding Fraction}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WidgetBatteryWidget">
      <Border Style="{DynamicResource WidgetBox}" Width="{Binding CardWidth}" Margin="{Binding CardMargin}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" />
          <TextBlock Grid.Row="1" Text="{Binding Model.Missing}" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="{Binding Model.NoDevices, Converter={StaticResource Visible}}">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Hint}" /></TextBlock.Style>
          </TextBlock>
          <!-- Una celda: hasta cuatro anillos en fila -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Model.Top4}" ItemTemplate="{StaticResource DeviceRingSmall}" Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Left">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Compact}" Value="True" /><Condition Binding="{Binding Tall}" Value="False" /><Condition Binding="{Binding Model.HasDevices}" Value="True" />
                  </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
          </ItemsControl>
          <!-- Dos celdas en una fila: hasta seis anillos con su nombre -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Model.Top6}" ItemTemplate="{StaticResource DeviceRingNamed}" Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Left">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Wide}" Value="True" /><Condition Binding="{Binding Tall}" Value="False" /><Condition Binding="{Binding Model.HasDevices}" Value="True" />
                  </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
          </ItemsControl>
          <!-- Una celda y dos filas: la lista de seis -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Model.Top6}" ItemTemplate="{StaticResource DeviceBatteryLine}" Focusable="False" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,2,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Compact}" Value="True" /><Condition Binding="{Binding Tall}" Value="True" /><Condition Binding="{Binding Model.HasDevices}" Value="True" />
                  </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
          </ItemsControl>
          <!-- Dos celdas y dos filas: la lista en dos columnas -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Model.Top10}" ItemTemplate="{StaticResource DeviceBatteryLine}" Focusable="False" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,2,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Wide}" Value="True" /><Condition Binding="{Binding Tall}" Value="True" /><Condition Binding="{Binding Model.HasDevices}" Value="True" />
                  </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
          </ItemsControl>
        </Grid>
      </Border>
    </DataTemplate>


    <!-- Los controles de la música, como los de Droppy: iconos limpios, sin disco (el de pausa, más grande) y, a los lados, mezclar y repetir
         en cuadritos de cristal cuando el reproductor los admite. DataContext: la música. -->
    <DataTemplate x:Key="MediaTransportCore">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Style="{StaticResource Plain}" Command="{Binding Previous}" AutomationProperties.Name="{Binding PreviousHelp}" ToolTip="{Binding PreviousHelp}" VerticalAlignment="Center" Visibility="{Binding CanSkip, Converter={StaticResource Visible}}">
          <Border Width="40" Height="40" Background="Transparent"><Path Data="M21,0 L10,9 L21,18 Z M11,0 L0,9 L11,18 Z" StrokeLineJoin="Round" StrokeThickness="2.5" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        </Button>
        <Button Style="{StaticResource Plain}" Command="{Binding Toggle}" AutomationProperties.Name="{Binding ToggleHelp}" ToolTip="{Binding ToggleHelp}" Margin="6,0" VerticalAlignment="Center">
          <Border Width="48" Height="48" Background="Transparent"><Grid><Path Data="M0,0 L7,0 L7,26 L0,26 Z M14,0 L21,0 L21,26 L14,26 Z" Visibility="{Binding IsPlaying, Converter={StaticResource Visible}}" StrokeLineJoin="Round" StrokeThickness="2.5" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Path Data="M0,0 L22,13 L0,26 Z" Visibility="{Binding IsPaused, Converter={StaticResource Visible}}" StrokeLineJoin="Round" StrokeThickness="2.5" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Border>
        </Button>
        <Button Style="{StaticResource Plain}" Command="{Binding Next}" AutomationProperties.Name="{Binding NextHelp}" ToolTip="{Binding NextHelp}" VerticalAlignment="Center" Visibility="{Binding CanSkip, Converter={StaticResource Visible}}">
          <Border Width="40" Height="40" Background="Transparent"><Path Data="M0,0 L11,9 L0,18 Z M10,0 L21,9 L10,18 Z" StrokeLineJoin="Round" StrokeThickness="2.5" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        </Button>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="MediaTransport">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Style="{StaticResource Plain}" Command="{Binding ToggleShuffle}" Visibility="{Binding CanShuffle, Converter={StaticResource Visible}}"
                AutomationProperties.Name="{Binding ShuffleHelp}" ToolTip="{Binding ShuffleHelp}" Margin="0,0,14,0" VerticalAlignment="Center">
          <Border Width="36" Height="32" CornerRadius="10" Background="{Binding ShuffleBack}" BorderBrush="{Binding ShuffleRim}" BorderThickness="1">
            <Path Data="M1,3.5 H4.5 C8,3.5 9.5,10.5 13,10.5 H15.5 M13.5,8.5 L15.5,10.5 L13.5,12.5 M1,10.5 H4.5 C5.7,10.5 6.6,9.7 7.3,8.6 M10.7,5.4 C11.4,4.3 12.2,3.5 13.5,3.5 H15.5 M13.5,1.5 L15.5,3.5 L13.5,5.5" Stroke="{Binding ShuffleBrush}" Stretch="Uniform" Width="20" Height="16" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Button>
        <Button Style="{StaticResource Plain}" Command="{Binding Previous}" AutomationProperties.Name="{Binding PreviousHelp}" ToolTip="{Binding PreviousHelp}" VerticalAlignment="Center" Visibility="{Binding CanSkip, Converter={StaticResource Visible}}">
          <Border Width="40" Height="40" Background="Transparent"><Path Data="M21,0 L10,9 L21,18 Z M11,0 L0,9 L11,18 Z" StrokeLineJoin="Round" StrokeThickness="2.5" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        </Button>
        <Button Style="{StaticResource Plain}" Command="{Binding Toggle}" AutomationProperties.Name="{Binding ToggleHelp}" ToolTip="{Binding ToggleHelp}" Margin="6,0" VerticalAlignment="Center">
          <Border Width="48" Height="48" Background="Transparent"><Grid><Path Data="M0,0 L7,0 L7,26 L0,26 Z M14,0 L21,0 L21,26 L14,26 Z" Visibility="{Binding IsPlaying, Converter={StaticResource Visible}}" StrokeLineJoin="Round" StrokeThickness="2.5" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Path Data="M0,0 L22,13 L0,26 Z" Visibility="{Binding IsPaused, Converter={StaticResource Visible}}" StrokeLineJoin="Round" StrokeThickness="2.5" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Border>
        </Button>
        <Button Style="{StaticResource Plain}" Command="{Binding Next}" AutomationProperties.Name="{Binding NextHelp}" ToolTip="{Binding NextHelp}" VerticalAlignment="Center" Visibility="{Binding CanSkip, Converter={StaticResource Visible}}">
          <Border Width="40" Height="40" Background="Transparent"><Path Data="M0,0 L11,9 L0,18 Z M10,0 L21,9 L10,18 Z" StrokeLineJoin="Round" StrokeThickness="2.5" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        </Button>
        <Button Style="{StaticResource Plain}" Command="{Binding CycleRepeat}" Visibility="{Binding CanRepeat, Converter={StaticResource Visible}}"
                AutomationProperties.Name="{Binding RepeatHelp}" ToolTip="{Binding RepeatHelp}" Margin="16,0,0,0" VerticalAlignment="Center">
          <Border Width="36" Height="32" CornerRadius="10" Background="{Binding RepeatBack}" BorderBrush="{Binding RepeatRim}" BorderThickness="1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M3,7 V6 C3,4 4,3 6,3 H15 M13,1 L15,3 L13,5 M15,7 V8 C15,10 14,11 12,11 H3 M5,9 L3,11 L5,13" Stroke="{Binding RepeatBrush}" Stretch="Uniform" Width="20" Height="16" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" /><TextBlock Text="1" FontSize="7.5" FontWeight="Bold" Foreground="{Binding RepeatBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" Visibility="{Binding RepeatOne, Converter={StaticResource Visible}}" /></Grid>
          </Border>
        </Button>
      </StackPanel>
    </DataTemplate>

    <!-- Música: portada redondeada con sombra, un velo con el color de la portada, tiempos y controles redondos. Una celda: portada y
         título arriba y controles debajo; dos celdas: todo en una fila. -->
    <DataTemplate x:Key="WidgetMediaWidget">
      <Border Style="{DynamicResource WidgetBox}" Margin="{Binding CardMargin}"
              ui:Swipe.Next="{Binding Model.Next}" ui:Swipe.Previous="{Binding Model.Previous}">
        <Border.Width><MultiBinding Converter="{x:Static ui:LyricsWidthConverter.Instance}"><Binding Path="CardWidth" /><Binding Path="Bare" /><Binding Path="Model.LyricsOpen" /></MultiBinding></Border.Width>
        <Grid>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetHeader}" Visibility="{Binding NotBare, Converter={StaticResource Visible}}" />
            <Grid Grid.Row="1" Grid.RowSpan="2" Margin="0,6,0,0" Visibility="{Binding Model.NoSession, Converter={StaticResource Visible}}">
              <Grid Visibility="{Binding Model.HasLaunchers, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,5" LastChildFill="False">
                  <TextBlock Text="{Binding Model.LaunchersTitle}" Style="{StaticResource Hint}" FontWeight="SemiBold" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Model.LaunchersHint}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Muted}" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" MaxHeight="112" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Model.Launchers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource Bordered}" Command="{Binding Open}" AutomationProperties.Name="{Binding Name}"
                                ToolTip="{Binding Name}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,4" Margin="0,0,0,4">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Secondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Grid>
            <Grid Grid.Row="2" Visibility="{Binding Model.HasSession, Converter={StaticResource Visible}}">
              <!-- La vista corta con un solo widget (las medidas son las de Nusa, en píxeles): portada de 62, título de 15 y artista de 12 abajo a su derecha,
                   tiempos de 15 a los lados de la barra de 4 y, debajo, los controles en posiciones fijas -->
              <Grid Width="332" Margin="0,-6,0,-6">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                  <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Wide}" Value="False" /><Condition Binding="{Binding Model.LyricsOpen}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                </Style.Triggers></Style></Grid.Style>
                <Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="34" /><RowDefinition Height="20" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="62" Height="62" CornerRadius="8" Background="{DynamicResource Track}" Margin="0,0,17,0" Visibility="{Binding Model.HasArt, Converter={StaticResource Visible}}">
                  <Rectangle RadiusX="8" RadiusY="8"><Rectangle.Fill><ImageBrush ImageSource="{Binding Model.Art}" Stretch="UniformToFill" /></Rectangle.Fill></Rectangle>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                  <TextBlock Text="{Binding Model.MediaTitle}" FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Model.ArtistLine}" FontSize="12" Foreground="#737373" TextTrimming="CharacterEllipsis" Margin="0,-3,0,0" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Model.ElapsedPadded}" FontSize="16.5" Foreground="White" VerticalAlignment="Center" />
                  <ui:SeekBar Accent="White" TrackBrush="#4C4C4C" Grid.Column="1" Margin="13,0" Value="{Binding Model.Progress, Mode=OneWay}" Command="{Binding Model.Seek}" AutomationProperties.Name="{Binding Model.SeekHelp}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Model.RemainingPadded}" FontSize="16.5" Foreground="White" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
                <Canvas Grid.Row="2" Grid.ColumnSpan="2" Height="20">
                  <Button Canvas.Left="14.5" Canvas.Top="-4" Width="32" Height="28" Style="{StaticResource Plain}" Command="{Binding Model.ToggleLyricsView}"
                          AutomationProperties.Name="{Binding Model.LyricsHelp}" ToolTip="{Binding Model.LyricsHelp}">
                    <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path Data="M4,2.4 H14 A2.4,2.4 0 0 1 16.4,4.8 V10 A2.4,2.4 0 0 1 14,12.4 H9.6 L6.2,15.8 V12.4 H4 A2.4,2.4 0 0 1 1.6,10 V4.8 A2.4,2.4 0 0 1 4,2.4 Z" Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent" />
                      <Path Data="M5.2,5.6 H7.6 V8 L6.4,9.8 M10.4,5.6 H12.8 V8 L11.6,9.8" Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                  </Button>
                  <Button Canvas.Left="98.5" Canvas.Top="-4" Width="40" Height="28" Style="{StaticResource Plain}" Command="{Binding Model.Previous}" Visibility="{Binding Model.CanSkip, Converter={StaticResource Visible}}"
                          AutomationProperties.Name="{Binding Model.PreviousHelp}" ToolTip="{Binding Model.PreviousHelp}">
                    <Path Data="M17,0 L8.5,5.5 L17,11 Z M8.5,0 L0,5.5 L8.5,11 Z" Fill="White" Stroke="White" StrokeThickness="1" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Button>
                  <Button Canvas.Left="147" Canvas.Top="-4" Width="40" Height="28" Style="{StaticResource Plain}" Command="{Binding Model.Toggle}"
                          AutomationProperties.Name="{Binding Model.ToggleHelp}" ToolTip="{Binding Model.ToggleHelp}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path Data="M0.5,0.5 H4 V12.5 H0.5 Z M8,0.5 H11.5 V12.5 H8 Z" Fill="White" Stroke="White" StrokeThickness="1" StrokeLineJoin="Round" Visibility="{Binding Model.IsPlaying, Converter={StaticResource Visible}}" />
                      <Path Data="M0.5,0.5 L11.5,6.5 L0.5,12.5 Z" Fill="White" Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Round" Visibility="{Binding Model.IsPaused, Converter={StaticResource Visible}}" />
                    </Grid>
                  </Button>
                  <Button Canvas.Left="192.5" Canvas.Top="-4" Width="40" Height="28" Style="{StaticResource Plain}" Command="{Binding Model.Next}" Visibility="{Binding Model.CanSkip, Converter={StaticResource Visible}}"
                          AutomationProperties.Name="{Binding Model.NextHelp}" ToolTip="{Binding Model.NextHelp}">
                    <Path Data="M0,0 L8.5,5.5 L0,11 Z M8.5,0 L17,5.5 L8.5,11 Z" Fill="White" Stroke="White" StrokeThickness="1" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Button>
                  <Button Canvas.Left="307.5" Canvas.Top="-4" Width="32" Height="28" Style="{StaticResource Plain}" Command="{Binding Model.ToggleMute}"
                          AutomationProperties.Name="{Binding Model.VolumeHelp}" ToolTip="{Binding Model.VolumeHelp}">
                    <Grid Width="17" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path Data="M0,4.5 H3.5 L8,0.8 V13.2 L3.5,9.5 H0 Z" Fill="White" Stroke="White" StrokeThickness="0.6" StrokeLineJoin="Round" />
                      <Path Data="M10.5,4.4 A3.6,3.6 0 0 1 10.5,9.6 M13,2.2 A6.8,6.8 0 0 1 13,11.8" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                      <Path Data="M1,13 L16,1" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="{Binding Model.Volume.Muted, Converter={StaticResource Visible}}" />
                    </Grid>
                  </Button>
                </Canvas>
              </Grid>
              <!-- Con la vista de letras (Nusa): a la izquierda la portada, el título, el tiempo y los controles; una línea; y a la derecha la letra sincronizada -->
              <Grid Width="476" HorizontalAlignment="Center" Margin="0,-2,0,-10">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                  <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Wide}" Value="False" /><Condition Binding="{Binding Model.LyricsOpen}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                </Style.Triggers></Style></Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="36" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="58" Height="58" CornerRadius="8" Background="{DynamicResource Track}" Margin="0,0,18,0" Visibility="{Binding Model.HasArt, Converter={StaticResource Visible}}">
                    <Rectangle RadiusX="8" RadiusY="8"><Rectangle.Fill><ImageBrush ImageSource="{Binding Model.Art}" Stretch="UniformToFill" /></Rectangle.Fill></Rectangle>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,2">
                    <TextBlock Text="{Binding Model.MediaTitle}" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Model.ArtistLine}" FontSize="11.5" Foreground="#737373" TextTrimming="CharacterEllipsis" Margin="0,0,0,0" />
                  </StackPanel>
                  <Grid Grid.Row="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Model.ElapsedPadded}" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                    <ui:SeekBar Accent="White" TrackBrush="#4C4C4C" Grid.Column="1" Margin="10,0" Value="{Binding Model.Progress, Mode=OneWay}" Command="{Binding Model.Seek}" AutomationProperties.Name="{Binding Model.SeekHelp}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Model.RemainingPadded}" FontSize="16" Foreground="White" VerticalAlignment="Center" TextAlignment="Right" />
                  </Grid>
                  <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,-5,0,5">
                    <!-- Como en Nusa: anterior, reproducir y siguiente centrados en la columna; el botón de letras aparte, a la izquierda -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
                    <Button Style="{StaticResource Plain}" Command="{Binding Model.ToggleLyricsView}" Width="36" Height="28" AutomationProperties.Name="{Binding Model.LyricsHelp}" ToolTip="{Binding Model.LyricsHelp}">
                      <Grid Width="18" Height="18">
                        <Path Data="M4,2.4 H14 A2.4,2.4 0 0 1 16.4,4.8 V10 A2.4,2.4 0 0 1 14,12.4 H9.6 L6.2,15.8 V12.4 H4 A2.4,2.4 0 0 1 1.6,10 V4.8 A2.4,2.4 0 0 1 4,2.4 Z" Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="White" />
                        <Path Data="M5.2,5.6 H7.6 V8 L6.4,9.8 M10.4,5.6 H12.8 V8 L11.6,9.8" Stroke="Black" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                      </Grid>
                    </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource Plain}" Command="{Binding Model.Previous}" Width="40" Height="28" Visibility="{Binding Model.CanSkip, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Model.PreviousHelp}" ToolTip="{Binding Model.PreviousHelp}">
                      <Path Data="M17,0 L8.5,5.5 L17,11 Z M8.5,0 L0,5.5 L8.5,11 Z" Fill="White" Stroke="White" StrokeThickness="1" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource Plain}" Command="{Binding Model.Toggle}" Width="40" Height="28" AutomationProperties.Name="{Binding Model.ToggleHelp}" ToolTip="{Binding Model.ToggleHelp}">
                      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M0.5,0.5 H4 V12.5 H0.5 Z M8,0.5 H11.5 V12.5 H8 Z" Fill="White" Stroke="White" StrokeThickness="1" StrokeLineJoin="Round" Visibility="{Binding Model.IsPlaying, Converter={StaticResource Visible}}" />
                        <Path Data="M0.5,0.5 L11.5,6.5 L0.5,12.5 Z" Fill="White" Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Round" Visibility="{Binding Model.IsPaused, Converter={StaticResource Visible}}" />
                      </Grid>
                    </Button>
                    <Button Style="{StaticResource Plain}" Command="{Binding Model.Next}" Width="40" Height="28" Visibility="{Binding Model.CanSkip, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Model.NextHelp}" ToolTip="{Binding Model.NextHelp}">
                      <Path Data="M0,0 L8.5,5.5 L0,11 Z M8.5,0 L17,5.5 L8.5,11 Z" Fill="White" Stroke="White" StrokeThickness="1" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                  </StackPanel>
                  </Grid>
                </Grid>
                <!-- La raya de en medio, como en Nusa: fina, blanca al 12 %, más corta que la tarjeta (102 de 140) y centrada -->
                <Rectangle Grid.Column="1" Width="1" Height="112" Margin="18,0,0,0" VerticalAlignment="Center">
                  <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00FFFFFF" Offset="0" /><GradientStop Color="#2EFFFFFF" Offset="0.3" /><GradientStop Color="#2EFFFFFF" Offset="0.7" /><GradientStop Color="#00FFFFFF" Offset="1" />
                  </LinearGradientBrush></Rectangle.Fill>
                </Rectangle>
                <ui:LyricsView Grid.Column="2" Media="{Binding Model}" Margin="12,0,0,0" />
              </Grid>
              <!-- Una celda: la portada y el título arriba, el progreso y los controles abajo; si el vecino de la fila es más alto, sobra aire entre ambos -->
              <Grid Visibility="{Binding CompactNotBare, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Visibility="{Binding Full, Converter={StaticResource Visible}}" VerticalAlignment="Center" Margin="0,4,0,0">
                  <Border Width="140" Height="140" CornerRadius="14" Background="{DynamicResource Track}" HorizontalAlignment="Center"
                          Visibility="{Binding Model.HasArt, Converter={StaticResource Visible}}">
                    <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5" /></Border.Effect>
                    <Rectangle RadiusX="14" RadiusY="14"><Rectangle.Fill><ImageBrush ImageSource="{Binding Model.Art}" Stretch="UniformToFill" /></Rectangle.Fill></Rectangle>
                  </Border>
                  <TextBlock Text="{Binding Model.MediaTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" />
                  <TextBlock Text="{Binding Model.Artist}" Style="{StaticResource Hint}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <Grid VerticalAlignment="Center" Visibility="{Binding Peek, Converter={StaticResource Visible}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="54" Height="54" CornerRadius="10" Background="{DynamicResource Track}" Margin="0,0,14,0" VerticalAlignment="Center"
                          Visibility="{Binding Model.HasArt, Converter={StaticResource Visible}}">
                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" /></Border.Effect>
                    <Rectangle RadiusX="10" RadiusY="10"><Rectangle.Fill><ImageBrush ImageSource="{Binding Model.Art}" Stretch="UniformToFill" /></Rectangle.Fill></Rectangle>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Model.MediaTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Model.Artist}" FontSize="13" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Model.ElapsedText}" FontFamily="{StaticResource Sans}" FontSize="13" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                  <ui:SeekBar Accent="{Binding Model.AccentBrush}" Grid.Column="1" Margin="10,0" Value="{Binding Model.Progress, Mode=OneWay}" Command="{Binding Model.Seek}" AutomationProperties.Name="{Binding Model.SeekHelp}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Model.RemainingText}" FontFamily="{StaticResource Sans}" FontSize="13" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                </Grid>
                <ContentControl Grid.Row="2" Content="{Binding Model}" ContentTemplate="{StaticResource MediaTransport}" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="{Binding Full, Converter={StaticResource Visible}}"><ContentControl.LayoutTransform><ScaleTransform ScaleX="1.0" ScaleY="1.0" /></ContentControl.LayoutTransform></ContentControl>
                <Grid Grid.Row="2" Margin="0,0,0,0" Visibility="{Binding Peek, Converter={StaticResource Visible}}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Button Style="{StaticResource Plain}" Command="{Binding Model.ToggleShuffle}" Visibility="{Binding Model.CanShuffle, Converter={StaticResource Visible}}" HorizontalAlignment="Left" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Model.ShuffleHelp}" ToolTip="{Binding Model.ShuffleHelp}">
                    <Border Width="34" Height="30" Background="Transparent">
                      <Path Data="M1,3.5 H4.5 C8,3.5 9.5,10.5 13,10.5 H15.5 M13.5,8.5 L15.5,10.5 L13.5,12.5 M1,10.5 H4.5 C5.7,10.5 6.6,9.7 7.3,8.6 M10.7,5.4 C11.4,4.3 12.2,3.5 13.5,3.5 H15.5 M13.5,1.5 L15.5,3.5 L13.5,5.5" Stroke="{Binding Model.ShuffleBrush}" Stretch="Uniform" Width="20" Height="16" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Button>
                  <ContentControl Grid.Column="1" Content="{Binding Model}" ContentTemplate="{StaticResource MediaTransportCore}" HorizontalAlignment="Center"><ContentControl.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8" /></ContentControl.LayoutTransform></ContentControl>
                  <Button Grid.Column="2" Style="{StaticResource Plain}" Command="{Binding Model.ToggleMute}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Model.VolumeHelp}" ToolTip="{Binding Model.VolumeHelp}">
                    <Border Width="34" Height="30" Background="Transparent"><TextBlock Text="{Binding Model.VolumeGlyph}" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  </Button>
                </Grid>
              </Grid>
              <!-- Solo en su lista: una vista grande que llena la celda -->
              <Grid Visibility="{Binding WideBig, Converter={StaticResource Visible}}" MinHeight="132">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="186" Height="186" CornerRadius="18" Background="{DynamicResource Track}" Margin="8,0,30,0" VerticalAlignment="Center"
                        Visibility="{Binding Model.HasArt, Converter={StaticResource Visible}}">
                  <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.55" /></Border.Effect>
                  <Rectangle RadiusX="14" RadiusY="14"><Rectangle.Fill><ImageBrush ImageSource="{Binding Model.Art}" Stretch="UniformToFill" /></Rectangle.Fill></Rectangle>
                </Border>
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Model.MediaTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Model.Artist}" Foreground="{DynamicResource Secondary}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                  </StackPanel>
                  <Grid Grid.Row="2" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Model.ElapsedText}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <ui:SeekBar Accent="{Binding Model.AccentBrush}" Grid.Column="1" Margin="10,0" Value="{Binding Model.Progress, Mode=OneWay}" Command="{Binding Model.Seek}" AutomationProperties.Name="{Binding Model.SeekHelp}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Model.RemainingText}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                  </Grid>
                  <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource MediaTransport}" HorizontalAlignment="Center" Grid.Row="3"  Margin="0,12,0,0"><ContentControl.LayoutTransform><ScaleTransform ScaleX="1.2" ScaleY="1.2" /></ContentControl.LayoutTransform></ContentControl>
                </Grid>
              </Grid>
              <!-- Dos celdas, con compañeros -->
              <Grid Visibility="{Binding WideSlim, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="88" Height="88" CornerRadius="12" Background="{DynamicResource Track}" Margin="0,0,18,0"
                        Visibility="{Binding Model.HasArt, Converter={StaticResource Visible}}">
                  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" /></Border.Effect>
                  <Rectangle RadiusX="12" RadiusY="12"><Rectangle.Fill><ImageBrush ImageSource="{Binding Model.Art}" Stretch="UniformToFill" /></Rectangle.Fill></Rectangle>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Model.MediaTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Model.Artist}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Model.ElapsedText}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <ui:SeekBar Accent="{Binding Model.AccentBrush}" Grid.Column="1" Margin="8,0" Value="{Binding Model.Progress, Mode=OneWay}" Command="{Binding Model.Seek}" AutomationProperties.Name="{Binding Model.SeekHelp}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Model.RemainingText}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
                <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource MediaTransport}" HorizontalAlignment="Center" Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0"><ContentControl.LayoutTransform><ScaleTransform ScaleX="1.12" ScaleY="1.12" /></ContentControl.LayoutTransform></ContentControl>
              </Grid>
            </Grid>
          </Grid>
          <!-- Arriba a la derecha: la app que suena y un ecualizador que baila mientras suena. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                      >
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Model.HasSession}" Value="True" /><Condition Binding="{Binding NotBare}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="{Binding Model.SourceApp}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel Orientation="Horizontal" Height="12" VerticalAlignment="Center">
              <Rectangle Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Model.AccentBrush}" Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                <Rectangle.RenderTransform><ScaleTransform x:Name="EqA" ScaleY="0.3" /></Rectangle.RenderTransform>
              </Rectangle>
              <Rectangle Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Model.AccentBrush}" Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                <Rectangle.RenderTransform><ScaleTransform x:Name="EqB" ScaleY="0.3" /></Rectangle.RenderTransform>
              </Rectangle>
              <Rectangle Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Model.AccentBrush}" RenderTransformOrigin="0.5,1">
                <Rectangle.RenderTransform><ScaleTransform x:Name="EqC" ScaleY="0.3" /></Rectangle.RenderTransform>
              </Rectangle>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Model.IsPlaying}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="EqRun">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="EqA" Storyboard.TargetProperty="ScaleY" From="0.25" To="1" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever" />
                <DoubleAnimation Storyboard.TargetName="EqB" Storyboard.TargetProperty="ScaleY" From="1" To="0.3" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
                <DoubleAnimation Storyboard.TargetName="EqC" Storyboard.TargetProperty="ScaleY" From="0.4" To="0.9" Duration="0:0:0.35" AutoReverse="True" RepeatBehavior="Forever" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <RemoveStoryboard BeginStoryboardName="EqRun" />
          </DataTrigger.ExitActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- El historial del portapapeles: copiar, fijar o quitar cada texto. -->
    <DataTemplate DataType="{x:Type ui:ClipRow}">
        <Border x:Name="clipRow" CornerRadius="9" Padding="6,3" Margin="0,1" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
              <Button x:Name="copyButton" Style="{StaticResource Plain}" Command="{Binding Copy}" AutomationProperties.Name="{Binding CopyHelp}" ToolTip="{Binding CopyHelp}">
                <Border x:Name="copySurface" Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Track}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
                  <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="11.5" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
              <Button x:Name="pinButton" Style="{StaticResource Plain}" Command="{Binding Pin}" AutomationProperties.Name="{Binding PinHelp}" ToolTip="{Binding PinHelp}">
                <Border x:Name="pinSurface" Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Track}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
                  <TextBlock x:Name="pinGlyph" Text="&#xE718;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
              <Button x:Name="removeButton" Style="{StaticResource Plain}" Command="{Binding Remove}" AutomationProperties.Name="{Binding RemoveHelp}" ToolTip="{Binding RemoveHelp}">
                <Border x:Name="removeSurface" Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Track}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
                  <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10.5" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
            </StackPanel>
            <Border x:Name="pinRail" DockPanel.Dock="Left" Width="3" CornerRadius="2" Margin="0,2,7,2" Background="Transparent" />
            <StackPanel VerticalAlignment="Center" Margin="0,1,2,1">
              <TextBlock Text="{Binding Preview}" FontSize="12.3" FontWeight="Medium" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="10.3" Margin="0,2,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
            </StackPanel>
          </DockPanel>
        </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsPinned}" Value="True">
          <Setter TargetName="pinSurface" Property="Background" Value="{DynamicResource AccentSoft}" />
          <Setter TargetName="pinGlyph" Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter TargetName="pinRail" Property="Background" Value="{DynamicResource Accent}" />
        </DataTrigger>
        <Trigger SourceName="clipRow" Property="IsMouseOver" Value="True">
          <Setter TargetName="clipRow" Property="Background" Value="{DynamicResource ButtonHover}" />
            <Setter TargetName="clipRow" Property="BorderBrush" Value="{DynamicResource Muted}" />
        </Trigger>
        <Trigger SourceName="clipRow" Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="clipRow" Property="Background" Value="{DynamicResource ButtonHover}" />
            <Setter TargetName="clipRow" Property="BorderBrush" Value="{DynamicResource Muted}" />
        </Trigger>
          <Trigger SourceName="copyButton" Property="IsMouseOver" Value="True"><Setter TargetName="copySurface" Property="Background" Value="{DynamicResource ButtonHover}" /></Trigger>
          <Trigger SourceName="pinButton" Property="IsMouseOver" Value="True"><Setter TargetName="pinSurface" Property="Background" Value="{DynamicResource ButtonHover}" /></Trigger>
          <Trigger SourceName="removeButton" Property="IsMouseOver" Value="True"><Setter TargetName="removeSurface" Property="Background" Value="{DynamicResource ButtonHover}" /></Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- La bandeja de archivos: una fila por elemento (miniatura, nombre y detalle). Las acciones se aclaran al pasar el ratón; doble clic abre; se arrastra hacia fuera. -->
    <DataTemplate DataType="{x:Type ui:TrayRow}">
      <Border x:Name="box" CornerRadius="9" Padding="6,5" Margin="0,1" Background="Transparent" ui:FileDrag.Path="{Binding Path}" ToolTip="{Binding Path}">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick" Command="{Binding Open}" />
        </Border.InputBindings>
        <DockPanel>
          <StackPanel x:Name="actions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.55">
            <Button Style="{StaticResource Plain}" Command="{Binding ReadText}" AutomationProperties.Name="{Binding ReadTextHelp}" ToolTip="{Binding ReadTextHelp}"
                    Visibility="{Binding CanReadText, Converter={StaticResource Visible}}">
              <Border Width="28" Height="26" CornerRadius="6"><TextBlock Text="&#xE8D2;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Button>
            <Button Style="{StaticResource Plain}" Command="{Binding Edit}" AutomationProperties.Name="{Binding EditHelp}" ToolTip="{Binding EditHelp}"
                    Visibility="{Binding CanEdit, Converter={StaticResource Visible}}">
              <Border Width="28" Height="26" CornerRadius="6"><TextBlock Text="&#xE70F;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Button>
            <Button Style="{StaticResource Plain}" Command="{Binding OpenProject}" AutomationProperties.Name="{Binding ProjectHelp}" ToolTip="{Binding ProjectHelp}"
                    Visibility="{Binding IsFolder, Converter={StaticResource Visible}}">
              <Border Width="28" Height="26" CornerRadius="6"><TextBlock Text="&#xE943;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Button>
            <Button Style="{StaticResource Plain}" Command="{Binding Open}" AutomationProperties.Name="{Binding OpenHelp}" ToolTip="{Binding OpenHelp}">
              <Border Width="28" Height="26" CornerRadius="6"><TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Button>
            <Button Style="{StaticResource Plain}" Command="{Binding Reveal}" AutomationProperties.Name="{Binding RevealHelp}" ToolTip="{Binding RevealHelp}">
              <Border Width="28" Height="26" CornerRadius="6"><TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Button>
            <Button Style="{StaticResource Plain}" Command="{Binding CopyPath}" AutomationProperties.Name="{Binding CopyHelp}" ToolTip="{Binding CopyHelp}">
              <Border Width="28" Height="26" CornerRadius="6"><TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Button>
            <Button Style="{StaticResource Plain}" Command="{Binding Remove}" AutomationProperties.Name="{Binding RemoveHelp}" ToolTip="{Binding RemoveHelp}">
              <Border Width="28" Height="26" CornerRadius="6"><TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Button>
          </StackPanel>
          <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource Track}" Margin="0,0,11,0" VerticalAlignment="Center">
            <Grid>
              <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform" Visibility="{Binding HasIcon, Converter={StaticResource Visible}}" />
              <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding NoIcon, Converter={StaticResource Visible}}" />
            </Grid>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="box" Property="IsMouseOver" Value="True">
          <Setter TargetName="box" Property="Background" Value="{DynamicResource ButtonHover}" />
          <Setter TargetName="actions" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger SourceName="box" Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="actions" Property="Opacity" Value="1" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Las carpetas de la página Widgets: cuadrados de cristal con los iconos de sus widgets en miniatura, como las carpetas del iPhone. -->
    <DataTemplate DataType="{x:Type ui:FolderMini}">
      <Grid Width="20" Height="20" Margin="2">
        <Border x:Name="mini" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
        <Grid>
          <Border x:Name="plate" CornerRadius="4" Background="{DynamicResource FolderIconSurface}" />
          <Rectangle x:Name="icon" Width="18" Height="18" RadiusX="4" RadiusY="4">
            <Rectangle.Fill><ImageBrush ImageSource="{Binding Icon}" Stretch="Uniform" /></Rectangle.Fill>
          </Rectangle>
          <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="9.5" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
          <Ellipse x:Name="activeDot" Width="4" Height="4" Fill="{DynamicResource FolderActive}" Stroke="{DynamicResource FolderIconSurface}" StrokeThickness="0.75"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" Visibility="Collapsed" />
        </Grid>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
          <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="glyph" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter TargetName="activeDot" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:WidgetFolderTile}">
      <Button Command="{Binding Open}" AutomationProperties.Name="{Binding Name}" AutomationProperties.AutomationId="{Binding AutomationId}" ToolTip="{Binding Name}" Cursor="Hand" Focusable="True" Background="Transparent" BorderBrush="Transparent"
              FocusVisualStyle="{StaticResource FocusRing}" HorizontalAlignment="Stretch">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <StackPanel HorizontalAlignment="Stretch" Background="Transparent">
              <Viewbox MaxWidth="96" MaxHeight="96" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                <Grid x:Name="box" Width="96" Height="96" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <Border x:Name="tile" CornerRadius="22" Background="{DynamicResource FolderTileFill}" BorderBrush="{DynamicResource FolderRim}" BorderThickness="1.3" ClipToBounds="True">
                    <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="{DynamicResource FolderShadowOpacity}" Color="Black" /></Border.Effect>
                    <Grid>
                      <Border Background="{DynamicResource FolderSheen}" CornerRadius="22" IsHitTestVisible="False" />
                      <Border Height="5" Margin="10,2,10,0" VerticalAlignment="Top" CornerRadius="2.5"
                              Background="{DynamicResource FolderSpecular}" Opacity="0.32" IsHitTestVisible="False" />
                      <ItemsControl ItemsSource="{Binding Minis}" Focusable="False" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="3" Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </Grid>
              </Viewbox>
              <TextBlock x:Name="label" Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Fg}" HorizontalAlignment="Stretch"
                         TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34" Margin="0,9,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsOpen}" Value="True">
                <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="tile" Property="BorderThickness" Value="1.5" />
                <Setter TargetName="label" Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.05" ScaleY="1.05" /></Setter.Value></Setter></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="box" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value></Setter></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:WidgetFolders}">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" Margin="0,6,0,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- La carpeta abierta, como en el iPhone: título centrado sobre una superficie de cristal con las apps en una cuadrícula. -->
    <DataTemplate DataType="{x:Type ui:FolderOption}">
      <Button Command="{Binding Open}" AutomationProperties.Name="{Binding Name}" AutomationProperties.AutomationId="{Binding AutomationId}" ToolTip="{Binding Name}" Cursor="Hand" Focusable="True"
              FocusVisualStyle="{StaticResource FocusRing}" Background="Transparent" BorderBrush="Transparent" Margin="2,0,2,14">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <StackPanel Background="Transparent" HorizontalAlignment="Center" Width="128">
              <Grid x:Name="box" Width="96" Height="96" RenderTransformOrigin="0.5,0.5">
                <Border x:Name="tile" CornerRadius="24" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" ClipToBounds="True">
                  <Grid>
                    <Border x:Name="plate" CornerRadius="24" Background="{DynamicResource FolderIconSurface}" />
                    <Rectangle x:Name="icon" RadiusX="24" RadiusY="24">
                      <Rectangle.Fill><ImageBrush ImageSource="{Binding Icon}" Stretch="Uniform" /></Rectangle.Fill>
                    </Rectangle>
                    <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{DynamicResource Secondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    <Ellipse x:Name="activeDot" Width="9" Height="9" Fill="{DynamicResource FolderActive}" Stroke="{DynamicResource FolderIconSurface}" StrokeThickness="1.5"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" Visibility="Collapsed" />
                  </Grid>
                </Border>
              </Grid>
              <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" TextAlignment="Center"
                         TextWrapping="Wrap" MaxHeight="34" Margin="4,9,4,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="glyph" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsOn}" Value="True">
                <Setter TargetName="activeDot" Property="Visibility" Value="Visible" />
                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Fg}" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.07" ScaleY="1.07" /></Setter.Value></Setter></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="box" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95" /></Setter.Value></Setter></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:FolderOverlay}">
      <StackPanel Margin="22" MaxWidth="520">
        <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" Margin="0,0,0,40" />
        <Border CornerRadius="48" Background="{DynamicResource FolderOpenFill}" BorderBrush="{DynamicResource FolderOpenRim}" BorderThickness="1.3">
          <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="{DynamicResource FolderOpenShadowOpacity}" Color="Black" /></Border.Effect>
          <Grid>
            <Border Margin="1" CornerRadius="47" Background="{DynamicResource FolderOpenSheen}" IsHitTestVisible="False" />
            <ItemsControl ItemsSource="{Binding Options}" Focusable="False" Width="438" Height="506" Margin="20,42,20,10">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="3" Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </Grid>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- La ventana de una opción: cómo se ve, su tamaño, su posición y el interruptor. -->
    <DataTemplate DataType="{x:Type ui:WidgetPreview}">
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Caption}" Style="{StaticResource Hint}" Margin="2,0,0,4" />
        <Border CornerRadius="16" Padding="4" Background="{DynamicResource PanelTint}" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
          <Viewbox MaxHeight="230" Stretch="Uniform" StretchDirection="DownOnly" IsHitTestVisible="False" KeyboardNavigation.TabNavigation="None">
            <ContentControl Content="{Binding Slot}" ContentTemplateSelector="{StaticResource WidgetSelector}" IsTabStop="False" Focusable="False" />
          </Viewbox>
        </Border>
      </StackPanel>
    </DataTemplate>
    <!-- La pastilla cerrada y las cápsulas del dock, pintadas como las pinta el notch (mismos tamaños, fuentes y colores). -->
    <DataTemplate DataType="{x:Type ui:PillPart}">
      <Border x:Name="box" Margin="5,0" Padding="4,1" CornerRadius="8" VerticalAlignment="Center" Background="Transparent">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="dot" Width="8" Height="8" Fill="{Binding Dot}" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
          <TextBlock x:Name="icon" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="11.5" Margin="0,0,4,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource Secondary}" Visibility="Collapsed" />
          <ui:ActivityRing x:Name="ring" Width="12" Height="12" Progress="{Binding Progress}" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
          <TextBlock x:Name="text" Text="{Binding Text}" FontSize="10.5" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="110" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Highlight}" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource AccentSoft}" /></DataTrigger>
        <DataTrigger Binding="{Binding HasGlyph}" Value="True"><Setter TargetName="icon" Property="Visibility" Value="Visible" /></DataTrigger>
        <DataTrigger Binding="{Binding HasRing}" Value="True"><Setter TargetName="ring" Property="Visibility" Value="Visible" /></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="warm"><Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Warm}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="danger"><Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="state">
          <Setter TargetName="dot" Property="Visibility" Value="Visible" />
          <Setter TargetName="text" Property="FontSize" Value="12" />
          <Setter TargetName="text" Property="FontWeight" Value="SemiBold" />
          <Setter TargetName="text" Property="FontFamily" Value="{StaticResource Sans}" />
          <Setter TargetName="text" Property="Foreground" Value="{DynamicResource Fg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="model">
          <Setter TargetName="text" Property="FontSize" Value="12" />
          <Setter TargetName="text" Property="FontFamily" Value="{StaticResource Sans}" />
          <Setter TargetName="text" Property="Foreground" Value="{DynamicResource Secondary}" />
          <Setter TargetName="text" Property="MaxWidth" Value="92" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="clock">
          <Setter TargetName="text" Property="FontSize" Value="12" />
          <Setter TargetName="text" Property="FontFamily" Value="{StaticResource Sans}" />
          <Setter TargetName="text" Property="Foreground" Value="{DynamicResource Fg}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:PillPreview}">
      <Border Height="37" CornerRadius="18.5" Padding="16,0" Background="#FF000000" BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,2,0,10">
        <ItemsControl ItemsSource="{Binding Parts}" Focusable="False" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:DockPart}">
      <Border x:Name="back" Width="28" Height="28" CornerRadius="14" Margin="4,0" Background="Transparent">
        <Grid>
          <Image x:Name="icon" Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
          <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="glyph" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Highlight}" Value="True">
          <Setter TargetName="back" Property="Background" Value="{DynamicResource Track}" />
          <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Fg}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:DockPreview}">
      <Border Height="34" CornerRadius="17" Padding="3,0" Background="{DynamicResource FolderFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,2,0,10">
        <ItemsControl ItemsSource="{Binding Parts}" Focusable="False" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:OptionSheet}">
      <Border Margin="20" MinWidth="300" MaxWidth="400" CornerRadius="30" Padding="18,16" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.6" Color="Black" /></Border.Effect>
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding Close}" AutomationProperties.Name="{Binding CloseLabel}" ToolTip="{Binding CloseLabel}" VerticalAlignment="Top">
              <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Track}">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Button>
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Fg}" DockPanel.Dock="Left" Margin="0,0,12,0">
              <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{DynamicResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
            </StackPanel>
          </DockPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding IsOn, Mode=OneWay}" Command="{Binding Toggle}" IsEnabled="{Binding CanToggle}" AutomationProperties.Name="{Binding SwitchName}" />
            <TextBlock Text="{Binding SwitchLabel}" FontSize="13" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
              <TextBlock Text="{Binding PreviewTitle}" Style="{StaticResource Eyebrow}" Margin="2,0,0,6" />
              <ItemsControl ItemsSource="{Binding Previews}" Focusable="False" />
              <StackPanel Visibility="{Binding HasSizes, Converter={StaticResource Visible}}" Margin="0,4,0,0">
                <TextBlock Text="{Binding SizeTitle}" Style="{StaticResource Eyebrow}" Margin="2,0,0,6" />
                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding Sizes}" />
                <TextBlock Text="{Binding SizeHint}" Style="{StaticResource Hint}" Margin="2,6,0,0" TextWrapping="Wrap" Visibility="{Binding HasSizeHint, Converter={StaticResource Visible}}" />
              </StackPanel>
              <DockPanel Margin="0,12,0,2" Visibility="{Binding HasMove, Converter={StaticResource Visible}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Style="{StaticResource Plain}" Command="{Binding Up}" AutomationProperties.Name="{Binding UpHelp}" ToolTip="{Binding UpHelp}">
                    <Border Width="34" Height="28" CornerRadius="9" Background="{DynamicResource Track}"><TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  </Button>
                  <Button Style="{StaticResource Plain}" Command="{Binding Down}" AutomationProperties.Name="{Binding DownHelp}" ToolTip="{Binding DownHelp}" Margin="6,0,0,0">
                    <Border Width="34" Height="28" CornerRadius="9" Background="{DynamicResource Track}"><TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  </Button>
                </StackPanel>
                <TextBlock Text="{Binding MoveTitle}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="2,0,0,0" />
              </DockPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- El cuerpo de una petición de agente (permiso, pregunta o plan): lo comparten la tarjeta del notch y la página Agentes. -->
    <DataTemplate x:Key="AgentApprovalBody">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Fg}" DockPanel.Dock="Left" Margin="0,0,12,0">
            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{DynamicResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Question}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
        <Border Background="{DynamicResource Track}" CornerRadius="10" Padding="10,8" Margin="0,0,0,12" Visibility="{Binding ShowDetail, Converter={StaticResource Visible}}">
          <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Focusable="False">
            <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoSmall}" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
        <Border Background="{DynamicResource DangerSoft}" CornerRadius="10" Padding="10,7" Margin="0,0,0,12" Visibility="{Binding IsRisky, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding RiskText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>

        <!-- Plan: el texto y dos respuestas -->
        <StackPanel Visibility="{Binding IsPlan, Converter={StaticResource Visible}}">
          <Border Background="{DynamicResource Track}" CornerRadius="10" Padding="10,8" Margin="0,0,0,12" Visibility="{Binding HasPlanText, Converter={StaticResource Visible}}">
            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Focusable="False">
              <TextBlock Text="{Binding PlanText}" FontSize="12" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <UniformGrid Rows="1" Columns="2">
            <Button Style="{StaticResource Tinted}" Command="{Binding RequestChanges}" Content="{Binding ChangesLabel}" AutomationProperties.Name="{Binding ChangesLabel}" Margin="0,0,6,0" Padding="0,8" />
            <Button Style="{StaticResource Prominent}" Command="{Binding Allow}" Content="{Binding ApprovePlanLabel}" AutomationProperties.Name="{Binding ApprovePlanLabel}" Padding="0,8" />
          </UniformGrid>
        </StackPanel>

        <!-- Pregunta: una lista de opciones por pregunta y un botón de enviar -->
        <StackPanel Visibility="{Binding IsQuestion, Converter={StaticResource Visible}}">
          <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Questions}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Header}" Style="{StaticResource Eyebrow}" Margin="0,0,0,2" Visibility="{Binding HasHeader, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Margin="0,0,0,5" />
                    <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Command="{Binding Pick}" Style="{StaticResource Plain}" Margin="0,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Label}">
                            <Border CornerRadius="10" Padding="10,6" BorderThickness="1">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                                  <Setter Property="Background" Value="{DynamicResource Track}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding HasDescription, Converter={StaticResource Visible}}" />
                              </StackPanel>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Style="{StaticResource Prominent}" Command="{Binding SendAnswers}" Content="{Binding SendLabel}" AutomationProperties.Name="{Binding SendLabel}" IsEnabled="{Binding CanSend}" Padding="0,8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Permiso: tres respuestas -->
        <UniformGrid Rows="1" Columns="3" Visibility="{Binding IsPermission, Converter={StaticResource Visible}}">
          <Button Style="{StaticResource DangerButton}" Command="{Binding Deny}" Content="{Binding DenyLabel}" AutomationProperties.Name="{Binding DenyLabel}" Margin="0,0,6,0" Padding="0,8" />
          <Button Style="{StaticResource Tinted}" Command="{Binding Always}" Content="{Binding AlwaysLabel}" AutomationProperties.Name="{Binding AlwaysLabel}" IsEnabled="{Binding CanAlways}" Margin="0,0,6,0" Padding="0,8" />
          <Button Style="{StaticResource Prominent}" Command="{Binding Allow}" Content="{Binding AllowLabel}" AutomationProperties.Name="{Binding AllowLabel}" Padding="0,8" />
        </UniformGrid>
        <Button Style="{StaticResource Plain}" Command="{Binding Fold}" Margin="0,10,0,0" HorizontalAlignment="Center" AutomationProperties.Name="{Binding FoldLabel}">
          <TextBlock Text="{Binding FoldLabel}" Style="{StaticResource Hint}" TextDecorations="Underline" />
        </Button>
        <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:AgentApproval}">
      <Border Margin="20" MinWidth="300" MaxWidth="400" CornerRadius="30" Padding="18,16" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.6" Color="Black" /></Border.Effect>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentApprovalBody}" Focusable="False" />
      </Border>
    </DataTemplate>

    <!-- La página Widgets: una fila por widget y otra por favorito. -->
    <DataTemplate DataType="{x:Type ui:WidgetRow}">
      <StackPanel AllowDrop="True" PreviewMouseLeftButtonDown="OnWidgetRowMouseDown" MouseMove="OnWidgetRowMouseMove"
                  DragOver="OnWidgetRowDragOver" Drop="OnWidgetRowDrop">
        <Rectangle Style="{StaticResource Divider}" Margin="0,9" Visibility="{Binding ShowDivider, Converter={StaticResource Visible}}" />
        <DockPanel>
          <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding IsOn, Mode=OneWay}" Command="{Binding Toggle}" IsEnabled="{Binding CanToggle}"
                          AutomationProperties.Name="{Binding SwitchName}" Margin="10,0,0,0" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsOn, Converter={StaticResource Visible}}">
            <Button Style="{StaticResource Plain}" Command="{Binding Resize}" AutomationProperties.Name="{Binding ResizeHelp}" ToolTip="{Binding ResizeHelp}"
                    Visibility="{Binding CanResize, Converter={StaticResource Visible}}">
              <Border Width="36" Height="24" CornerRadius="6"><TextBlock Text="1↔2" FontSize="9" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Button>
            <Button Style="{StaticResource Plain}" Command="{Binding Up}" AutomationProperties.Name="{Binding UpHelp}" ToolTip="{Binding UpHelp}">
              <Border Width="26" Height="24" CornerRadius="6"><TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Button>
            <Button Style="{StaticResource Plain}" Command="{Binding Down}" AutomationProperties.Name="{Binding DownHelp}" ToolTip="{Binding DownHelp}">
              <Border Width="26" Height="24" CornerRadius="6"><TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Button>
          </StackPanel>
          <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Secondary}" Width="26" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="12" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:FavoriteRow}">
      <StackPanel>
        <Rectangle Style="{StaticResource Divider}" Margin="0,9" Visibility="{Binding ShowDivider, Converter={StaticResource Visible}}" />
        <DockPanel>
          <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding IsOn, Mode=OneWay}" Command="{Binding Toggle}" IsEnabled="{Binding CanToggle}"
                          AutomationProperties.Name="{Binding Title}" Margin="10,0,0,0" />
          <Grid DockPanel.Dock="Left" Width="26" Height="20">
            <Image x:Name="icon" Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Secondary}" Width="26" VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
          <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
          <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="glyph" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    </Application.Resources>
</Application>
