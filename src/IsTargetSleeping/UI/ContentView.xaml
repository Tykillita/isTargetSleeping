                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Count}" FontSize="10" Foreground="{DynamicResource Muted}" />
