                                        <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Visibility="{Binding HasIcon, Converter={StaticResource Visible}}" />
                                            <Border CornerRadius="5" Background="{DynamicResource Track}" Visibility="{Binding NoIcon, Converter={StaticResource Visible}}">
