            <Border x:Name="CalendarFileSettingsCard" Style="{StaticResource CardBox}" Margin="0,10,0,0" DataContext="{Binding Hub.ClockInfo}">
                <StackPanel>
                    <TextBlock Text="{Binding IcsTitle}" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{Binding IcsDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,8" />
                    <TextBlock Text="{Binding IcsText}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Bordered}" Command="{Binding PickIcs}" Content="{Binding IcsChoose}" AutomationProperties.Name="{Binding IcsChoose}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Bordered}" Command="{Binding ClearIcs}" Content="{Binding IcsRemove}" AutomationProperties.Name="{Binding IcsRemove}" Visibility="{Binding HasIcs, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowingSettingsPet, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding PetSectionTitle}" Style="{StaticResource Eyebrow}" Margin="2,0,2,6" />
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <DockPanel>
                        <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding TaskbarPetOn}" Command="{Binding ToggleTaskbarPet}"
                                        AutomationProperties.Name="{Binding TaskbarPetTitle}" Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding TaskbarPetTitle}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding TaskbarPetDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                            <TextBlock Text="{Binding TaskbarPetError}" Style="{StaticResource Hint}" Foreground="{DynamicResource Warm}"
                                       Margin="0,4,0,0" Visibility="{Binding HasTaskbarPetError, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding TaskbarPetOn, Converter={StaticResource Visible}}">
                        <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding PetPlacementSegments}"
                                      AutomationProperties.Name="{Binding PetPlacementTitle}" />
                        <ItemsControl ItemsSource="{Binding PetChoices}" ItemTemplate="{StaticResource PetChoiceTemplate}" Margin="-3,7,-3,0"
                                      KeyboardNavigation.DirectionalNavigation="Contained"
                                      Visibility="{Binding ShowPetSpecies, Converter={StaticResource Visible}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <DockPanel Margin="0,10,0,0">
                            <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding PetInteractiveOn}" Command="{Binding TogglePetInteractive}"
                                            AutomationProperties.Name="{Binding PetInteractiveTitle}" Margin="10,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding PetInteractiveTitle}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding PetInteractiveDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowingSettingsGeneral, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding GeneralTitle}" Style="{StaticResource Eyebrow}" Margin="2,0,2,6" />
            <!-- Agentes: aprobar permisos desde el notch. Bloque autocontenido, fácil de reubicar. -->
            <Border Style="{StaticResource CardBox}" Margin="0,0,0,10">
              <StackPanel>
                <DockPanel>
                    <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding AgentApprovalsOn}" Command="{Binding ToggleAgentApprovals}" AutomationProperties.Name="{Binding AgentApprovalsTitle}" Margin="10,0,0,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{Binding AgentApprovalsTitle}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AgentApprovalsDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding AgentApprovalsStatus}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasAgentApprovalsStatus, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DockPanel>
                <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                <DockPanel>
                    <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding AgentSoundsOn}" Command="{Binding ToggleAgentSounds}" AutomationProperties.Name="{Binding AgentSoundsTitle}" Margin="10,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding AgentSoundsTitle}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding AgentSoundsDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                    </StackPanel>
                </DockPanel>
                <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                <TextBlock Text="{Binding DecisionTitle}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DecisionDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding DecisionSegments}" Margin="0,7,0,0" AutomationProperties.Name="{Binding DecisionTitle}" />
                <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                <TextBlock Text="{Binding AgentNotifyTitle}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AgentNotifyDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding AgentNotifySegments}" Margin="0,7,0,0" AutomationProperties.Name="{Binding AgentNotifyTitle}" />
                <DockPanel Margin="0,9,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding SnoozeEnd}" Visibility="{Binding IsSnoozed, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding SnoozeEndLabel}">
                        <TextBlock Text="{Binding SnoozeEndLabel}" Style="{StaticResource Hint}" TextDecorations="Underline" />
                    </Button>
                    <TextBlock Text="{Binding SnoozeLabel}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding SnoozeSegments}" Margin="0,6,0,0" AutomationProperties.Name="{Binding SnoozeLabel}" />
                <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                <DockPanel>
                    <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding AgentGlowOn}" Command="{Binding ToggleAgentGlow}" AutomationProperties.Name="{Binding AgentGlowTitle}" Margin="10,0,0,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{Binding AgentGlowTitle}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AgentGlowDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                    </StackPanel>
                </DockPanel>
                <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                <DockPanel>
                    <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding ChatDockOn}" Command="{Binding ToggleChatDock}" AutomationProperties.Name="{Binding ChatDockTitle}" Margin="10,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding ChatDockTitle}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ChatDockDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                    </StackPanel>
                </DockPanel>
                <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                <TextBlock Text="{Binding ChatterTitle}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ChatterDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding ChatterSegments}" Margin="0,7,0,0" AutomationProperties.Name="{Binding ChatterTitle}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <DockPanel>
                        <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding HotKeyOn}" Command="{Binding ToggleHotKey}" AutomationProperties.Name="{Binding HotKeyTitle}" Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding HotKeyTitle}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding HotKeyDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                    <DockPanel>
                        <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding SleepHotKeyOn}" Command="{Binding ToggleSleepHotKey}" AutomationProperties.Name="{Binding SleepHotKeyTitle}" Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding SleepHotKeyTitle}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding SleepHotKeyDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                    <DockPanel>
                        <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding LoginOn}" Command="{Binding ToggleLogin}" AutomationProperties.Name="{Binding LoginTitle}" Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding LoginTitle}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding LoginDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Visibility="{Binding ShowUpdateSetting, Converter={StaticResource Visible}}">
                        <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                        <DockPanel>
                            <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding UpdateCheckOn}" Command="{Binding ToggleUpdateCheck}" AutomationProperties.Name="{Binding UpdateCheckTitle}" Margin="10,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding UpdateCheckTitle}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding UpdateCheckDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Button Style="{StaticResource Bordered}" Content="{Binding CheckUpdatesNowLabel}" Command="{Binding CheckUpdatesNow}"
                                IsEnabled="{Binding CanCheckUpdates}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding UpdateCheckStatus}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        <StackPanel Visibility="{Binding ShowUpdate, Converter={StaticResource Visible}}" Margin="0,5,0,0">
                            <TextBlock Text="{Binding UpdateDetail}" Style="{StaticResource Hint}" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Style="{StaticResource Plain}" Foreground="{DynamicResource Secondary}" Content="{Binding UpdateNotesLabel}" Command="{Binding OpenUpdateNotes}" Margin="0,0,10,0" />
                                <Button Style="{StaticResource Bordered}" Content="{Binding UpdateLabel}" Command="{Binding InstallUpdate}"
                                        IsEnabled="{Binding CanInstallUpdate}" Visibility="{Binding UpdateIdle, Converter={StaticResource Visible}}" />
                                <Button Style="{StaticResource Bordered}" Content="{Binding UpdateCancelLabel}" Command="{Binding CancelUpdate}"
                                        Visibility="{Binding CanCancelUpdate, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasUpdateMessage, Converter={StaticResource Visible}}" Margin="0,5,0,0">
                            <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource Hint}" Foreground="{DynamicResource Warm}" />
                            <Button Style="{StaticResource Plain}" Foreground="{DynamicResource Secondary}" Content="{Binding UpdateDownloadsLabel}" Command="{Binding OpenUpdateDownloads}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                    <DockPanel>
                        <ItemsControl DockPanel.Dock="Right" Style="{StaticResource Segmented}" ItemsSource="{Binding LanguageSegments}"
                                      Width="150" ToolTip="{Binding LanguageHelp}" />
                        <TextBlock Text="{Binding LanguageTitle}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding VisibilitySectionTitle}" Style="{StaticResource Eyebrow}" Margin="2,10,2,6" />
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <DockPanel>
                        <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding HideFullscreenOn}" Command="{Binding ToggleHideFullscreen}" AutomationProperties.Name="{Binding HideFullscreenTitle}" Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding HideFullscreenTitle}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding HideFullscreenDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                    <DockPanel>
                        <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding LyricsOn}" Command="{Binding ToggleLyricsSetting}" AutomationProperties.Name="{Binding LyricsTitle}" Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding LyricsTitle}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding LyricsDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                    <DockPanel>
                        <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding LyricsPillOn}" Command="{Binding ToggleLyricsPillSetting}" AutomationProperties.Name="{Binding LyricsPillTitle}" Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding LyricsPillTitle}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding LyricsPillDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                    <TextBlock Text="{Binding OpenModeTitle}" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding OpenModeDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                    <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding OpenModeSegments}" Margin="0,7,0,0" AutomationProperties.Name="{Binding OpenModeTitle}" />
                    <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                    <TextBlock Text="{Binding AnimSpeedTitle}" Style="{StaticResource Label}" />
                    <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding AnimSpeedSegments}" Margin="0,7,0,0" AutomationProperties.Name="{Binding AnimSpeedTitle}" />
                </StackPanel>
            </Border>


            <StackPanel Orientation="Horizontal" Margin="2,10,2,0">
                <TextBlock Text="{Binding LogsTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" />
                <Button Style="{StaticResource Plain}" Command="{Binding OpenLog}" AutomationProperties.Name="{Binding OpenLogLabel}" IsEnabled="{Binding LogEnabled}" Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{Binding LogBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Ollama" Margin="5,0,0,0" FontSize="11.5" FontWeight="Medium" Foreground="{Binding LogBrush}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Plain}" Command="{Binding OpenEngineLog}" AutomationProperties.Name="{Binding OpenEngineLogLabel}" Margin="14,0,0,0"
                        Visibility="{Binding ShowEngineLog, Converter={StaticResource Visible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="llama.cpp" Margin="5,0,0,0" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Accent}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            </StackPanel>
            </StackPanel>
            </ScrollViewer>
            </Grid>
        </StackPanel>

        </Grid>
        <!-- MARK: pie en el notch: al final del contenido de cada página (se desplaza con ella), no fijo encima de lo que pasa por debajo -->
        <DockPanel Margin="{Binding FooterMargin}" Visibility="{Binding NotchFooter, Converter={StaticResource Visible}}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BrandName}" Margin="5,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" />
            </StackPanel>
        </DockPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- MARK: pie del panel de la bandeja: fijo abajo, con su línea -->
        <Rectangle Style="{StaticResource Divider}" Visibility="{Binding FlatFooter, Converter={StaticResource Visible}}" />
        <DockPanel Margin="{Binding FooterMargin}" Visibility="{Binding FlatFooter, Converter={StaticResource Visible}}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BrandName}" Margin="5,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
    <!-- MARK: carpeta de widgets abierta (encima de la página, como una carpeta del iPhone) y la ventana de la opción elegida -->
    <Grid x:Name="WidgetOverlay" Visibility="{Binding HasOverlayFolder, Converter={StaticResource Visible}}"
          IsVisibleChanged="OnWidgetOverlayVisible" KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
      <Border Background="{DynamicResource FolderScrim}">
        <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding CloseOverlay}" /></Border.InputBindings>
      </Border>
      <!-- Las capas modales no deben entrar en la medida del panel ni agrandar el notch. -->
      <Canvas>
        <Grid Width="{Binding ActualWidth, ElementName=WidgetOverlay}" Height="{Binding ActualHeight, ElementName=WidgetOverlay}">
          <Viewbox x:Name="WidgetFolderViewport" Width="{Binding ActualWidth, ElementName=WidgetOverlay}" Height="{Binding ActualHeight, ElementName=WidgetOverlay}"
                   Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="520" MaxHeight="{Binding BodyMaxHeight}"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentControl Content="{Binding OverlayFolder}" AutomationProperties.Name="{Binding OverlayFolder.Title}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
          </Viewbox>
        </Grid>
        <Grid x:Name="WidgetSheet" Width="{Binding ActualWidth, ElementName=WidgetOverlay}" Height="{Binding ActualHeight, ElementName=WidgetOverlay}"
              Visibility="{Binding HasSheet, Converter={StaticResource Visible}}" IsVisibleChanged="OnWidgetSheetVisible"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
          <Border Background="#99000000">
            <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding CloseSheet}" /></Border.InputBindings>
          </Border>
          <ContentControl Content="{Binding Sheet}" AutomationProperties.Name="{Binding Sheet.Title}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
        </Grid>
      </Canvas>
    </Grid>
    <!-- MARK: permiso que pide un agente (Claude Code): encima de todo, con Y / N / Esc -->
    <Grid x:Name="ApprovalOverlay" Visibility="{Binding HasApproval, Converter={StaticResource Visible}}"
          IsVisibleChanged="OnApprovalVisible" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
      <Grid.InputBindings>
        <KeyBinding Key="Y" Command="{Binding Approval.AllowKey}" />
        <KeyBinding Key="N" Command="{Binding Approval.Deny}" />
        <KeyBinding Key="Escape" Command="{Binding Approval.Fold}" />
      </Grid.InputBindings>
      <Border Background="#B3000000" />
      <!-- Las capas modales no deben entrar en la medida del panel ni agrandar el notch. -->
      <Canvas>
        <Grid Width="{Binding ActualWidth, ElementName=ApprovalOverlay}" Height="{Binding ActualHeight, ElementName=ApprovalOverlay}">
          <ContentControl Content="{Binding Approval}" AutomationProperties.Name="{Binding Approval.Title}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
        </Grid>
      </Canvas>
    </Grid>
  </Grid>
</UserControl>
