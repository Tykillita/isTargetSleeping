                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding OpenProcessesLabel}" Command="{Binding OpenProcesses}" Style="{StaticResource Bordered}"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0" AutomationProperties.Name="{Binding OpenProcessesLabel}" />
