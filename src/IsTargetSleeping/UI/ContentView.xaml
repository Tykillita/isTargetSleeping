<UserControl x:Class="IsTargetSleeping.UI.ContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:IsTargetSleeping.UI"
             xmlns:widgets="clr-namespace:IsTargetSleeping.UI.Widgets"
             Width="340" Background="{DynamicResource PanelTint}" Foreground="{DynamicResource Fg}"
             FontFamily="{StaticResource Sans}" FontSize="12"
             TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <DataTemplate x:Key="PetChoiceTemplate" DataType="{x:Type ui:PetChoice}">
      <RadioButton GroupName="PetSpecies" IsChecked="{Binding IsSelected, Mode=OneWay}" Checked="OnPetChoiceChecked"
                   AutomationProperties.Name="{Binding Title}" Margin="3" Focusable="True">
        <RadioButton.Template>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="tile" CornerRadius="8" Padding="6,7" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStroke}" Background="Transparent">
              <Grid>
                <StackPanel>
                  <Image Source="{Binding Preview}" Height="60" Width="64" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="NearestNeighbor" />
                  <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Sans}" FontSize="11.5"
                             Foreground="{DynamicResource Fg}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock x:Name="chosen" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11"
                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="tile" Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter TargetName="chosen" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tile" Property="Background" Value="{DynamicResource ButtonHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="tile" Property="BorderThickness" Value="2" />
                <Setter TargetName="tile" Property="Padding" Value="5,6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </RadioButton.Template>
      </RadioButton>
    </DataTemplate>
    <!-- Un ajuste con interruptor (Notificaciones). -->
    <DataTemplate x:Key="SwitchRowTemplate" DataType="{x:Type ui:SwitchRow}">
      <StackPanel>
        <Rectangle Style="{StaticResource Divider}" Margin="0,9" Visibility="{Binding ShowDivider, Converter={StaticResource Visible}}" />
        <DockPanel>
          <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding IsOn}" Command="{Binding Toggle}" AutomationProperties.Name="{Binding Title}" Margin="10,0,0,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="12" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <!-- Profundidad del vidrio: una sombra negra que se asienta hacia el borde inferior. -->
    <Border Height="220" VerticalAlignment="Bottom" Background="{DynamicResource Sheen}" IsHitTestVisible="False" Visibility="{Binding FlatFooter, Converter={StaticResource Visible}}" />
    <StackPanel x:Name="MainContent">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasOverlayFolder}" Value="True">
              <Setter Property="Effect">
                <Setter.Value><BlurEffect Radius="{DynamicResource FolderBackdropBlur}" /></Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>

        <!-- MARK: cabecera (se arrastra para mover el panel; doble clic: vuelve junto a la bandeja) -->
        <Border x:Name="HeaderBar" Background="Transparent" Padding="14,11" MouseLeftButtonDown="OnHeaderMouseDown"
                MouseMove="OnHeaderMouseMove" MouseLeftButtonUp="OnHeaderMouseUp">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:LogoView Width="22" Height="22" Color="{Binding LogoBrush}" VerticalAlignment="Center"
                         Visibility="{Binding ShowingBrand, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding HeaderGlyph}" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource Accent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowingSecondary, Converter={StaticResource Visible}}" />
            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding HeaderTitle}" FontSize="14.5" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource Mono}" FontSize="10.5"
                           Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- Paginador de Home y de sus páginas de widgets: siempre visible en la cabecera -->
            <Border Grid.Column="2" CornerRadius="12" Padding="2" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource ButtonHover}"
                    Visibility="{Binding ShowHomePager, Converter={StaticResource Visible}}">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Plain}" Command="{Binding PrevHomePage}" AutomationProperties.Name="{Binding PrevPageLabel}" ToolTip="{Binding PrevPageLabel}">
                  <Border Width="22" Height="22" CornerRadius="11" Background="Transparent">
                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Button>
                <ItemsControl ItemsSource="{Binding HomeDots}" Focusable="False" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource Plain}" Command="{Binding Pick}" AutomationProperties.Name="{Binding Title}" Margin="2,0">
                        <Border Height="5" CornerRadius="2.5">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Width" Value="5" />
                              <Setter Property="Background" Value="{DynamicResource Muted}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="Width" Value="14" />
                                  <Setter Property="Background" Value="{DynamicResource Fg}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource Plain}" Command="{Binding NextHomePage}" AutomationProperties.Name="{Binding NextPageLabel}" ToolTip="{Binding NextPageLabel}">
                  <Border Width="22" Height="22" CornerRadius="11" Background="Transparent">
                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Button>
              </StackPanel>
            </Border>
            <Border Grid.Column="3" CornerRadius="10" Padding="8,3,9,3" VerticalAlignment="Center" Margin="0,0,6,0"
                    Background="{Binding PillBackground}" Visibility="{Binding ShowingBrand, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{Binding PillForeground}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PillText}" Margin="5,0,0,0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding PillForeground}" />
                </StackPanel>
            </Border>
            <!-- Al lado: la otra vista (Actividad o Ajustes). En la esquina: Ajustes, o la X para volver. -->
            <Button Grid.Column="4" Style="{StaticResource Plain}" Command="{Binding SideCommand}" AutomationProperties.Name="{Binding SideHelp}" ToolTip="{Binding SideHelp}"
                    VerticalAlignment="Center" Margin="0,0,2,0">
                <Border Width="26" Height="24" CornerRadius="6" Background="Transparent">
                    <TextBlock Text="{Binding SideGlyph}" FontFamily="{StaticResource Icons}" FontSize="13"
                               Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Button>
            <Button Grid.Column="5" Style="{StaticResource Plain}" Command="{Binding CornerCommand}" AutomationProperties.Name="{Binding CornerHelp}" ToolTip="{Binding CornerHelp}"
                    VerticalAlignment="Center">
                <Border Width="26" Height="24" CornerRadius="6" Background="{Binding CornerBackground}">
                    <TextBlock Text="{Binding CornerGlyph}" FontFamily="{StaticResource Icons}" FontSize="13"
                               Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Button>
        </Grid>
        </Border>
        <Rectangle x:Name="HeaderDivider" Style="{StaticResource Divider}" />

        <ScrollViewer x:Name="BodyScroll" MaxHeight="{Binding BodyMaxHeight}" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>
        <Grid>

        <!-- MARK: Home del notch: los widgets elegidos, en su orden -->
        <StackPanel x:Name="HomePanel" Margin="8" Visibility="{Binding ShowingHome, Converter={StaticResource Visible}}">
          <Grid>
            <ItemsControl x:Name="HomeItems" ItemsSource="{Binding HomeWidgets}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" AllowDrop="True"
                          DragOver="OnWidgetRowDragOver" Drop="OnWidgetHomeDrop" RenderTransformOrigin="0.5,0.5">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><ui:GridPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </Grid>
          <Border Style="{StaticResource CardBox}" Margin="0,10,0,0" Visibility="{Binding CustomizingWidgets, Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="{Binding WidgetShelfIntro}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,2" />
              <ItemsControl ItemsSource="{Binding WidgetRows}" Focusable="False" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding WidgetsEmpty}" Style="{StaticResource Hint}" Margin="6,10"
                     Visibility="{Binding NoHomeWidgets, Converter={StaticResource Visible}}" />
        </StackPanel>

        <!-- MARK: Widgets: elegir y ordenar lo del Home y los favoritos del dock -->
        <StackPanel x:Name="WidgetsPanel" Margin="14" Visibility="{Binding ShowingWidgets, Converter={StaticResource Visible}}">
          <!-- Galería de widgets (como la de iOS): un widget cada vez, su vista previa viva en cada tamaño, el paginador y el botón de añadir -->
          <Grid x:Name="GalleryPanelHost" Margin="-14,0,-14,0">
            <Border x:Name="GalleryPanel" Style="{StaticResource CardBox}" Margin="14,0,14,10" Panel.ZIndex="1">
              <Border.Effect><DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="7" Color="Black" Opacity="{DynamicResource GalleryShadowOpacity}" /></Border.Effect>
              <StackPanel>
              <TextBlock Text="{Binding GalleryTitleLabel}" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="{Binding GalleryIntro}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,10" />
              <Grid x:Name="GalleryNavigation" Margin="0,0,0,10" Panel.ZIndex="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                <Button x:Name="GalleryPreviousButton" Grid.Column="0" Style="{StaticResource Plain}" Command="{Binding GalleryPrev}" AutomationProperties.Name="{Binding GalleryPrevHelp}" ToolTip="{Binding GalleryPrevHelp}" VerticalAlignment="Center">
                  <Border Width="30" Height="40" Background="Transparent"><TextBlock Text="&#xE76B;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                </Button>
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="GalleryWidgetTitle" Text="{Binding GalleryTitle}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="GalleryWidgetTitleShift" /></TextBlock.RenderTransform>
                  </TextBlock>
                  <TextBlock x:Name="GalleryWidgetDescription" Text="{Binding GalleryDescription}" Style="{StaticResource Hint}" Height="18" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" ToolTip="{Binding GalleryDescription}" Margin="0,3,0,0" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="GalleryWidgetDescriptionShift" /></TextBlock.RenderTransform>
                  </TextBlock>
                </StackPanel>
                <Button x:Name="GalleryNextButton" Grid.Column="2" Style="{StaticResource Plain}" Command="{Binding GalleryNext}" AutomationProperties.Name="{Binding GalleryNextHelp}" ToolTip="{Binding GalleryNextHelp}" VerticalAlignment="Center">
                  <Border Width="30" Height="40" Background="Transparent"><TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                </Button>
              </Grid>
              <!-- Las vistas laterales son adelantos visuales; solo el centro recibe interacción y actualiza datos. -->
              <Viewbox x:Name="GalleryViewportViewbox" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" Margin="0,0,0,10" Panel.ZIndex="1">
                <Grid x:Name="GalleryViewportHost" Width="{Binding GalleryCarouselWidth}" Height="{Binding GalleryHeight}">
                <Border x:Name="GalleryCarousel" Width="{Binding GalleryCarouselWidth}" Height="{Binding GalleryHeight}" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" Background="Transparent">
                  <Canvas x:Name="GalleryCarouselCanvas" Width="{Binding GalleryCarouselWidth}" Height="{Binding GalleryHeight}" ClipToBounds="True">
                    <Border x:Name="GalleryPreviousFrame" Width="{Binding GalleryPreviousCard.Width}" Height="{Binding GalleryPreviousCard.Height}"
                            Canvas.Left="{Binding GalleryPreviousCard.Left}" Canvas.Top="{Binding GalleryPreviousCard.Top}"
                            RenderTransformOrigin="1,0.5" Background="{DynamicResource GallerySideTileFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="22" ClipToBounds="True"
                            Opacity="{DynamicResource GallerySideOpacity}" IsHitTestVisible="False" Focusable="False" IsEnabled="False"
                            KeyboardNavigation.TabNavigation="None">
                      <Border.Effect><DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Color="Black" Opacity="{DynamicResource GalleryCardShadowOpacity}" /></Border.Effect>
                      <Grid>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" IsHitTestVisible="False" Focusable="False">
                          <ContentControl Content="{Binding GalleryPreviousCard.Slot}" ContentTemplateSelector="{StaticResource WidgetSelector}" IsTabStop="False" Focusable="False" />
                        </Viewbox>
                        <Border BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="22" IsHitTestVisible="False" Opacity="{DynamicResource GallerySideRimOpacity}">
                          <Border.Effect><BlurEffect Radius="{DynamicResource GallerySideRimBlur}" /></Border.Effect>
                        </Border>
                      </Grid>
                    </Border>
                    <Border x:Name="GalleryNextFrame" Width="{Binding GalleryNextCard.Width}" Height="{Binding GalleryNextCard.Height}"
                            Canvas.Left="{Binding GalleryNextCard.Left}" Canvas.Top="{Binding GalleryNextCard.Top}"
                            RenderTransformOrigin="0,0.5" Background="{DynamicResource GallerySideTileFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="22" ClipToBounds="True"
                            Opacity="{DynamicResource GallerySideOpacity}" IsHitTestVisible="False" Focusable="False" IsEnabled="False"
                            KeyboardNavigation.TabNavigation="None">
                      <Border.Effect><DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Color="Black" Opacity="{DynamicResource GalleryCardShadowOpacity}" /></Border.Effect>
                      <Grid>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" IsHitTestVisible="False" Focusable="False">
                          <ContentControl Content="{Binding GalleryNextCard.Slot}" ContentTemplateSelector="{StaticResource WidgetSelector}" IsTabStop="False" Focusable="False" />
                        </Viewbox>
                        <Border BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="22" IsHitTestVisible="False" Opacity="{DynamicResource GallerySideRimOpacity}">
                          <Border.Effect><BlurEffect Radius="{DynamicResource GallerySideRimBlur}" /></Border.Effect>
                        </Border>
                      </Grid>
                    </Border>
                    <Border x:Name="GalleryPreviewFrame" Width="{Binding GalleryWidth}" Height="{Binding GalleryHeight}" Canvas.Left="{Binding GalleryCarouselCenterLeft}"
                            CornerRadius="22" ClipToBounds="True" Background="{DynamicResource GalleryTileFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
                      <Border.Effect><DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="5" Color="Black" Opacity="{DynamicResource GalleryCardShadowOpacity}" /></Border.Effect>
                      <Grid>
                        <ContentControl Content="{Binding GalleryPreview}" ContentTemplateSelector="{StaticResource WidgetSelector}"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" Focusable="False" />
                        <Border BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="22" IsHitTestVisible="False" Opacity="{DynamicResource GallerySideRimOpacity}">
                          <Border.Effect><BlurEffect Radius="{DynamicResource GallerySideRimBlur}" /></Border.Effect>
                        </Border>
                      </Grid>
                    </Border>
                  </Canvas>
                </Border>
                  <Viewport3D x:Name="GalleryMotionViewport" Width="{Binding GalleryCarouselWidth}" Height="{Binding GalleryHeight}" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="True" Visibility="Visible">
                    <Viewport3D.Camera><PerspectiveCamera Position="0,0,4.5" LookDirection="0,0,-4.5" UpDirection="0,1,0" FieldOfView="32" /></Viewport3D.Camera>
                  </Viewport3D>
                </Grid>
              </Viewbox>
              <ItemsControl ItemsSource="{Binding GalleryDots}" Focusable="False" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource Plain}" Command="{Binding Select}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}">
                      <Border Background="Transparent" Padding="4,6"><Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource Muted}" Opacity="0.5" /></Border>
                    </Button>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Selected}" Value="True">
                        <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Fg}" />
                        <Setter TargetName="dot" Property="Opacity" Value="1" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding GallerySizes}" Focusable="False" HorizontalAlignment="Center" Margin="0,6,0,10">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource Plain}" Command="{Binding Select}" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}" Margin="3,0">
                      <Border x:Name="chip" CornerRadius="9" Padding="12,5" Background="{DynamicResource Track}">
                        <TextBlock x:Name="label" Text="{Binding Label}" FontSize="12" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Secondary}" />
                      </Border>
                    </Button>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Selected}" Value="True">
                        <Setter TargetName="chip" Property="Background" Value="{DynamicResource Fg}" />
                        <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Bg}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- El botón de añadir, como el de iOS: una pastilla ancha del mismo negro acrílico que el widget, con el signo más en un círculo y el texto -->
              <Button x:Name="GalleryAddButton" Command="{Binding GalleryAdd}" IsEnabled="{Binding GalleryCanAdd}" AutomationProperties.Name="{Binding GalleryAddLabel}" Cursor="Hand" Focusable="True" HorizontalAlignment="Stretch">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="pill" Height="46" CornerRadius="23" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                      <StackPanel x:Name="GalleryAddButtonContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform><TranslateTransform x:Name="GalleryAddButtonShift" /></StackPanel.RenderTransform>
                        <Grid Width="22" Height="22" Margin="0,0,9,0">
                          <Ellipse x:Name="plusBackground" Fill="{DynamicResource Fg}" />
                          <Rectangle x:Name="plusHorizontal" Width="10" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Rectangle x:Name="plusVertical" Width="2" Height="10" RadiusX="1" RadiusY="1" Fill="{DynamicResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="addLabel" Text="{Binding GalleryAddLabel}" FontSize="15" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <DataTrigger Binding="{Binding GalleryAlreadyAdded}" Value="True"><Setter TargetName="plusVertical" Property="Visibility" Value="Collapsed" /></DataTrigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pill" Property="Background" Value="{DynamicResource Track}" /></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource Fg}" /></Trigger>
                      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                      <DataTrigger Binding="{Binding GalleryUsesNoteAccent}" Value="True">
                        <Setter TargetName="pill" Property="Background" Value="{DynamicResource NoteBand}" />
                        <Setter TargetName="plusBackground" Property="Fill" Value="{DynamicResource OnNote}" />
                        <Setter TargetName="plusHorizontal" Property="Fill" Value="{DynamicResource NoteBand}" />
                        <Setter TargetName="plusVertical" Property="Fill" Value="{DynamicResource NoteBand}" />
                        <Setter TargetName="addLabel" Property="Foreground" Value="{DynamicResource OnNote}" />
                      </DataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                          <Condition Binding="{Binding GalleryUsesNoteAccent}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="pill" Property="Background" Value="{DynamicResource NoteAccent}" />
                      </MultiDataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                          <Condition Binding="{Binding GalleryUsesNoteAccent}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource OnNote}" />
                      </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource WidgetFoldersCardBox}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8"
                          Visibility="{Binding CustomizingWidgets, Converter={StaticResource Visible}}">
                <Button Style="{StaticResource Plain}" Content="{Binding SaveWidgetsLabel}" Command="{Binding SaveCustomize}" AutomationProperties.Name="{Binding SaveWidgetsLabel}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Plain}" Content="{Binding CancelWidgetsLabel}" Command="{Binding CancelCustomize}" AutomationProperties.Name="{Binding CancelWidgetsLabel}" />
              </StackPanel>
              <TextBlock Text="{Binding WidgetsIntro}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding WidgetsCells}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" Margin="0,4,0,12" />
              <ContentControl Content="{Binding HomeFolders}" Focusable="False" />
              <TextBlock Text="{Binding WidgetsFull}" Style="{StaticResource Hint}" Margin="0,10,0,0"
                         Visibility="{Binding WidgetsAreFull, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBox}" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="{Binding PillTitle}" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="{Binding PillIntro}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,4" />
              <TextBlock Text="{Binding PillCount}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" Margin="0,0,0,12" />
              <ContentControl Content="{Binding PillFolders}" Focusable="False" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource WidgetFoldersCardBox}" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="{Binding PeekTitle}" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="{Binding PeekIntro}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,4" />
              <TextBlock Text="{Binding PeekWidgetCount}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" Margin="0,0,0,12" />
              <ContentControl Content="{Binding PeekFolders}" Focusable="False" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- MARK: bandeja de archivos: lo que se arrastra al notch espera aquí -->
        <StackPanel x:Name="TrayPanel" Margin="14" Visibility="{Binding ShowingTray, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource CardBox}">
            <Grid>
              <StackPanel>
                <!-- Sin nada: una zona para soltar -->
                <Grid Margin="0,2" Visibility="{Binding NoTrayFiles, Converter={StaticResource Visible}}">
                  <Rectangle StrokeDashArray="4 4" Stroke="{DynamicResource Line}" StrokeThickness="1.2" RadiusX="12" RadiusY="12" />
                  <StackPanel HorizontalAlignment="Center" Margin="22,26">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding TrayEmpty}" Style="{StaticResource Hint}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400" Margin="0,12,0,0" />
                    <Button Style="{StaticResource Bordered}" Command="{Binding PasteTray}" AutomationProperties.Name="{Binding PasteTrayLabel}" ToolTip="{Binding PasteTrayHelp}"
                            HorizontalAlignment="Center" Margin="0,14,0,0">
                      <TextBlock Text="{Binding PasteTrayLabel}" />
                    </Button>
                  </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding TrayRows}" Focusable="False" />
                <DockPanel Margin="0,12,0,0" Visibility="{Binding HasTrayFiles, Converter={StaticResource Visible}}">
                  <Border DockPanel.Dock="Right" CornerRadius="8" Background="{DynamicResource Track}" Padding="10,4" Cursor="Hand" ui:FileDrag.Path="{Binding TrayAllPaths}"
                          ToolTip="{Binding DragAllHelp}" Visibility="{Binding HasManyTrayFiles, Converter={StaticResource Visible}}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE76F;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" Margin="0,0,7,0" />
                      <TextBlock Text="{Binding DragAllLabel}" FontSize="11.5" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Bordered}" Command="{Binding ZipTray}" AutomationProperties.Name="{Binding ZipLabel}" ToolTip="{Binding ZipHelp}">
                      <TextBlock Text="{Binding ZipLabel}" />
                    </Button>
                    <Button Style="{StaticResource Bordered}" Command="{Binding PasteTray}" AutomationProperties.Name="{Binding PasteTrayLabel}" ToolTip="{Binding PasteTrayHelp}" Margin="8,0,0,0">
                      <TextBlock Text="{Binding PasteTrayLabel}" />
                    </Button>
                    <Button Style="{StaticResource Bordered}" Command="{Binding ClearTray}" AutomationProperties.Name="{Binding ClearTrayLabel}" ToolTip="{Binding ClearTrayHelp}" Margin="8,0,0,0">
                      <TextBlock Text="{Binding ClearTrayLabel}" />
                    </Button>
                    <Button Style="{StaticResource Bordered}" Command="{Binding RevealZip}" AutomationProperties.Name="{Binding RevealZipLabel}" Margin="8,0,0,0"
                            Visibility="{Binding HasTrayZip, Converter={StaticResource Visible}}">
                      <TextBlock Text="{Binding RevealZipLabel}" />
                    </Button>
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding TrayStatus}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding HasTrayStatus, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding TrayHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding HasTrayFiles, Converter={StaticResource Visible}}" />
              </StackPanel>
              <!-- Mientras se arrastra algo por encima del notch -->
              <Grid Visibility="{Binding TrayDragging, Converter={StaticResource Visible}}" IsHitTestVisible="False" Margin="-6">
                <Rectangle Fill="#D0101418" StrokeDashArray="4 3" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" RadiusX="12" RadiusY="12" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding TrayDropText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>

        <!-- MARK: editor rápido de un archivo de texto de la bandeja -->
        <StackPanel x:Name="EditorPanel" Margin="14" Visibility="{Binding ShowingEditor, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <Border CornerRadius="6" BorderThickness="1" Background="{DynamicResource Track}" Height="280">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                    <Style.Triggers>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Muted}" /></Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <ui:CodeEditor x:Name="EditorBox" Source="{Binding EditText, Mode=TwoWay}" FileName="{Binding EditTitle}" Foreground="{DynamicResource Fg}"
                               AutomationProperties.Name="{Binding EditTitle}" IsVisibleChanged="OnEditorVisibleChanged">
                  <ui:CodeEditor.InputBindings>
                    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveEdit}" />
                  </ui:CodeEditor.InputBindings>
                </ui:CodeEditor>
              </Border>
              <TextBlock Text="{Binding EditStatus}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource Bordered}" Command="{Binding SaveEdit}" AutomationProperties.Name="{Binding EditSaveLabel}" ToolTip="{Binding EditSaveHelp}">
                  <TextBlock Text="{Binding EditSaveLabel}" />
                </Button>
                <Button Style="{StaticResource Bordered}" Command="{Binding ReloadEdit}" AutomationProperties.Name="{Binding EditReloadLabel}" ToolTip="{Binding EditReloadHelp}" Margin="8,0,0,0">
                  <TextBlock Text="{Binding EditReloadLabel}" />
                </Button>
                <Button Style="{StaticResource Bordered}" Command="{Binding OverwriteEdit}" AutomationProperties.Name="{Binding EditOverwriteLabel}" ToolTip="{Binding EditOverwriteHelp}" Margin="8,0,0,0"
                        Visibility="{Binding EditConflict, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding EditOverwriteLabel}" />
                </Button>
                <Button Style="{StaticResource Bordered}" Command="{Binding CloseEdit}" AutomationProperties.Name="{Binding EditCloseLabel}" ToolTip="{Binding EditCloseHelp}" Margin="8,0,0,0">
                  <TextBlock Text="{Binding EditCloseLabel}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- MARK: historial del portapapeles (solo texto, solo en memoria) -->
        <StackPanel x:Name="ClipboardPanel" Margin="14" Visibility="{Binding ShowingClipboard, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource CardBox}" Padding="11,8">
            <StackPanel>
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="10" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" FontSize="8" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ClipState}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="25" Height="25" CornerRadius="8" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Secondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClipboardTitle}" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding ClipCountLabel}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                  </StackPanel>
                </Grid>
              </DockPanel>
              <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                  <TextBox Style="{StaticResource Field}" Text="{Binding ClipSearch, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Padding="27,5,32,5"
                           AutomationProperties.Name="{Binding ClipSearchLabel}" ToolTip="{Binding ClipSearchLabel}" />
                  <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="11.5" Foreground="{DynamicResource Muted}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" />
                  <TextBlock Text="{Binding ClipSearchHint}" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                             Margin="27,0,32,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ClipSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Button Style="{StaticResource Plain}" Command="{Binding ClearClipSearch}"
                          AutomationProperties.Name="{Binding ClipClearSearchLabel}" ToolTip="{Binding ClipClearSearchLabel}"
                          HorizontalAlignment="Right" Margin="0,0,3,0" Visibility="{Binding ClipHasSearch, Converter={StaticResource Visible}}">
                    <Border Width="25" Height="25" CornerRadius="6" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
                      <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10.5" Foreground="{DynamicResource Secondary}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Button>
                </Grid>
                <ItemsControl Grid.Column="1" Style="{StaticResource Segmented}" ItemsSource="{Binding ClipFilterSegments}" Margin="7,0,0,0"
                              AutomationProperties.Name="{Binding ClipFilterLabel}" />
              </Grid>
              <TextBlock Text="{Binding ClipEmpty}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,8,2,1"
                         Visibility="{Binding NoClipItems, Converter={StaticResource Visible}}" />
              <TextBlock Text="{Binding ClipNoMatches}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,8,2,1"
                         Visibility="{Binding ClipHasNoMatches, Converter={StaticResource Visible}}" />
              <ItemsControl ItemsSource="{Binding ClipRows}" Focusable="False" />
              <TextBlock Text="{Binding ClipNotice}" Foreground="{DynamicResource Secondary}" FontSize="11" TextWrapping="Wrap" Margin="2,6,2,0"
                         Visibility="{Binding ClipHasNotice, Converter={StaticResource Visible}}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource Bordered}" Command="{Binding PauseClip}" AutomationProperties.Name="{Binding ClipPauseLabel}" ToolTip="{Binding ClipPauseHelp}">
                  <TextBlock Text="{Binding ClipPauseLabel}" />
                </Button>
                <Button Style="{StaticResource Bordered}" Command="{Binding ClearClip}" AutomationProperties.Name="{Binding ClipClearLabel}" ToolTip="{Binding ClipClearHelp}" Margin="8,0,0,0"
                        Visibility="{Binding HasClipItems, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding ClipClearLabel}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- MARK: centro de agentes: peticiones, sesiones, historial de decisiones y reglas «Siempre» -->
        <StackPanel x:Name="AgentsPanel" Margin="14" Visibility="{Binding ShowingAgents, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding AgentsPageTitle}" Style="{StaticResource Eyebrow}" Margin="2,0,2,3" />
          <TextBlock Text="{Binding AgentsSummary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,0,2,8" />
          <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding AgentsTabs}" Margin="0,0,0,8" AutomationProperties.Name="{Binding AgentsPageTitle}" />

          <!-- Ahora -->
          <StackPanel Visibility="{Binding AgentsTabNow, Converter={StaticResource Visible}}">
            <Border CornerRadius="12" Padding="12,9" Margin="0,0,0,8" Background="{DynamicResource AccentSoft}" BorderThickness="1" BorderBrush="{DynamicResource Accent}" Visibility="{Binding HasAwayDigest, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="{Binding AwayDigestTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AwayDigestText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0" />
                <Button Style="{StaticResource Plain}" Command="{Binding DismissAwayDigest}" HorizontalAlignment="Left" Margin="0,6,0,0" AutomationProperties.Name="{Binding AwayDismissLabel}">
                  <TextBlock Text="{Binding AwayDismissLabel}" Style="{StaticResource Hint}" TextDecorations="Underline" />
                </Button>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding AgentAlertRows}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="12" Padding="12,9" Margin="0,0,0,8" Background="{DynamicResource Track}" BorderThickness="1" BorderBrush="{DynamicResource Line}">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            <Style.Triggers><DataTrigger Binding="{Binding Severe}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding NoPendingText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,2,2,8" Visibility="{Binding NoPending, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding PendingApprovals}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBox}" Padding="12,10" Margin="0,0,0,8">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AgentApprovalBody}" Focusable="False" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding SessionsTitle}" Style="{StaticResource Eyebrow}" Margin="2,6,2,4" Visibility="{Binding HasAgentSessions, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding AgentSessions}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="2,3">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Tinted}" Content="{Binding DataContext.ResumeInTerminalLabel, ElementName=AgentsPanel}" Command="{Binding DataContext.ResumeInTerminal, ElementName=AgentsPanel}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding DataContext.ResumeInTerminalLabel, ElementName=AgentsPanel}" Padding="10,3" Margin="10,0,0,0" FontSize="11"
                            Visibility="{Binding CanResumeInTerminal, Converter={StaticResource Visible}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Line}" Style="{StaticResource Hint}" MaxWidth="170" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding MetaLine}" Style="{StaticResource MonoSmall}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Visibility="{Binding HasMeta, Converter={StaticResource Visible}}" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Historial -->
          <StackPanel Visibility="{Binding AgentsTabHistory, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding HistoryEmptyText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,2,2,8" Visibility="{Binding NoDecisions, Converter={StaticResource Visible}}" />
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding HasDecisions, Converter={StaticResource Visible}}">
              <ItemsControl ItemsSource="{Binding DecisionRows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,9">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,2" Background="{DynamicResource Track}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding VerdictText}" FontSize="10.5" Foreground="{DynamicResource Secondary}" />
                        </Border>
                        <TextBlock Text="{Binding Who}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoSmall}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                      <TextBlock Text="{Binding RiskText}" FontSize="11" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Visibility="{Binding Risky, Converter={StaticResource Visible}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Style="{StaticResource Plain}" Command="{Binding ClearHistory}" HorizontalAlignment="Left" Margin="2,4,0,0" AutomationProperties.Name="{Binding ClearHistoryLabel}" Visibility="{Binding HasDecisions, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding ClearHistoryLabel}" Style="{StaticResource Hint}" TextDecorations="Underline" />
            </Button>
          </StackPanel>

          <!-- Reglas -->
          <StackPanel Visibility="{Binding AgentsTabRules, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding RulesIntro}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,0,2,8" />
            <TextBlock Text="{Binding RulesEmptyText}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,2,2,8" Visibility="{Binding NoRules, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding RuleRows}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBox}" Padding="12,9" Margin="0,0,0,7">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Command="{Binding Revoke}" Content="{Binding RevokeLabel}" AutomationProperties.Name="{Binding RevokeLabel}" Padding="12,5" Margin="10,0,0,0" VerticalAlignment="Center" />
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoSmall}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <!-- MARK: chat con la mascota (modelo local) -->
        <StackPanel x:Name="ChatPanel" Margin="14" Visibility="{Binding ShowingChat, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding ChatPageTitle}" Style="{StaticResource Eyebrow}" Margin="2,0,2,3" />
          <TextBlock Text="{Binding ChatPageDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,0,2,6" />
          <DockPanel Margin="2,0,2,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding BondLine}" Style="{StaticResource Hint}" />
            <TextBlock Text="{Binding MoodLine}" Style="{StaticResource Hint}" />
          </DockPanel>
          <Border Style="{StaticResource CardBox}" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="{Binding PetWeekTitle}" Style="{StaticResource Eyebrow}" Margin="0,0,0,3" />
              <TextBlock Text="{Binding PetWeekLine}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBox}" Padding="10">
            <StackPanel>
              <TextBlock Text="{Binding ChatEmptyText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,4,2,8" Visibility="{Binding ChatEmpty, Converter={StaticResource Visible}}" />
              <ScrollViewer x:Name="ChatScroll" MaxHeight="230" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding ChatLines}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="14" Padding="11,7" Margin="0,3" MaxWidth="320">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="Background" Value="{DynamicResource Track}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding FromMe}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Fg}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="{Binding ChatStatus}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,6,2,0" Visibility="{Binding HasChatStatus, Converter={StaticResource Visible}}" />
              <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Prominent}" Command="{Binding SendChat}" Content="{Binding ChatSendLabel}" AutomationProperties.Name="{Binding ChatSendLabel}" Padding="14,6" Margin="8,0,0,0" IsEnabled="{Binding ChatIdle}" />
                <Button DockPanel.Dock="Right" Command="{Binding ToggleListen}" AutomationProperties.Name="{Binding ChatMicLabel}" ToolTip="{Binding ChatMicLabel}"
                        Visibility="{Binding VoiceAvailable, Converter={StaticResource Visible}}" Padding="10,6" Margin="8,0,0,0">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Tinted}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ChatListening}" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource OnAccent}" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <TextBlock Text="&#xE720;" FontFamily="{StaticResource Icons}" FontSize="14" />
                </Button>
                <Grid>
                  <TextBox x:Name="ChatBox" Style="{StaticResource Field}" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ChatPlaceholder}">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SendChat}" /></TextBox.InputBindings>
                  </TextBox>
                  <TextBlock Text="{Binding ChatPlaceholder}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12" Foreground="{DynamicResource Muted}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ChatBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </DockPanel>
              <DockPanel Margin="0,10,0,0" Visibility="{Binding VoiceAvailable, Converter={StaticResource Visible}}">
                <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding ChatSpeakOn}" Command="{Binding ToggleChatSpeak}" AutomationProperties.Name="{Binding ChatSpeakLabel}" Margin="10,0,0,0" />
                <TextBlock Text="{Binding ChatSpeakLabel}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding StopChat}" AutomationProperties.Name="{Binding ChatStopLabel}" Visibility="{Binding ChatBusy, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding ChatStopLabel}" Style="{StaticResource Hint}" TextDecorations="Underline" />
                </Button>
                <Button Style="{StaticResource Plain}" Command="{Binding ClearChat}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding ChatClearLabel}">
                  <TextBlock Text="{Binding ChatClearLabel}" Style="{StaticResource Hint}" TextDecorations="Underline" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding ResetBond}" Margin="12,0,0,0" AutomationProperties.Name="{Binding ResetBondLabel}">
                  <TextBlock Text="{Binding ResetBondLabel}" Style="{StaticResource Hint}" TextDecorations="Underline" />
                </Button>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- MARK: vista previa privada; el interruptor inicia o detiene la captura -->
        <StackPanel x:Name="CameraPanel" Margin="14" Visibility="{Binding ShowingCamera, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding CameraPageTitle}" Style="{StaticResource Eyebrow}" Margin="2,0,2,3" />
          <TextBlock Text="{Binding CameraPageDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,0,2,8" />
          <Border Style="{StaticResource CardBox}" Padding="8">
            <StackPanel>
              <DockPanel Margin="2,1,2,8">
                <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding Camera.PreviewEnabled, Mode=OneWay}" Command="{Binding ToggleCameraPreview}"
                                AutomationProperties.Name="{Binding CameraPreviewToggleLabel}" ToolTip="{Binding CameraPreviewToggleLabel}" Margin="8,0,0,0" />
                <Border DockPanel.Dock="Right" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="10" Padding="8,4">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource Muted}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Camera.IsInUse}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource On}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Camera.StatusText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Left" Text="{Binding CameraPreviewLabel}" Style="{StaticResource Label}" VerticalAlignment="Center" />
              </DockPanel>
              <Border x:Name="CameraPreviewFrame" Background="{DynamicResource PromptWell}" BorderBrush="{DynamicResource PromptRim}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <Grid Height="180">
                    <Image Source="{Binding Camera.Frame}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="{Binding CameraPageTitle}">
                    <Image.RenderTransform><ScaleTransform ScaleX="-1" /></Image.RenderTransform>
                  </Image>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18"
                              Visibility="{Binding Camera.HasNoFrame, Converter={StaticResource Visible}}">
                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource Secondary}"
                               HorizontalAlignment="Center" Margin="0,0,0,9" />
                    <TextBlock Text="{Binding Camera.EmptyText}" Style="{StaticResource Hint}" TextAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border x:Name="CameraAppsCard" Style="{StaticResource CardBox}" Padding="10" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding CameraAppsTitle}" Style="{StaticResource Label}" />
                  <TextBlock Text="{Binding CameraAppsDetail}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,6" />
                  <TextBlock Text="{Binding Camera.ActiveApplicationsText}" Style="{StaticResource Hint}" TextWrapping="Wrap"
                             Visibility="{Binding Camera.NoActiveApplications, Converter={StaticResource Visible}}" />
                  <ItemsControl ItemsSource="{Binding Camera.ActiveApplications}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1"
                                CornerRadius="8" Padding="8" Margin="0,4,0,0" AutomationProperties.Name="{Binding Name}">
                          <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Bordered}" Content="{Binding PermissionActionLabel}"
                                    Command="{Binding OpenPermissions}" AutomationProperties.Name="{Binding PermissionActionLabel}"
                                    ToolTip="{Binding PermissionHelp}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Button Style="{StaticResource Bordered}" Content="{Binding CameraPrivacyLabel}" Command="{Binding OpenCameraPrivacy}"
                      AutomationProperties.Name="{Binding CameraPrivacyLabel}" ToolTip="{Binding CameraPrivacyHelp}" HorizontalAlignment="Left" Margin="0,8,0,0"
                      Visibility="{Binding Camera.NeedsPrivacyHelp, Converter={StaticResource Visible}}" />
              <TextBlock Text="{Binding Camera.ErrorText}" Foreground="{DynamicResource Warm}" TextWrapping="Wrap" Margin="2,7,2,0"
                         Visibility="{Binding Camera.HasError, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- MARK: panel principal -->
        <StackPanel x:Name="MainPanel" Margin="14" Visibility="{Binding ShowingMain, Converter={StaticResource Visible}}">

            <!-- Botón grande -->
            <Border Style="{StaticResource CardBox}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Plain}" Command="{Binding TogglePower}" AutomationProperties.Name="{Binding HeroHelp}" IsEnabled="{Binding CanToggle}"
                            ToolTip="{Binding HeroHelp}" Width="72" Height="72">
                        <Grid Width="72" Height="72">
                            <Ellipse x:Name="Halo" Fill="{Binding HeroFill}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="HaloScale" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="56" Height="56" Stroke="{Binding HeroTint}" StrokeThickness="2" />
                            <Path Data="{Binding HeroIcon}" Stroke="{Binding HeroTint}" StrokeThickness="2.4" Width="20" Height="20"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeroTitle}" FontSize="17.5" FontWeight="SemiBold" Foreground="{Binding HeroTitleBrush}" />
                        <TextBlock Text="{Binding HeroDetail}" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource Secondary}"
                                   TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Modo juego -->
            <Border Style="{StaticResource CardBox}" Margin="0,10,0,0" Padding="11,10"
                    Visibility="{Binding ShowGameBanner, Converter={StaticResource Visible}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="16"
                               Foreground="{DynamicResource Secondary}" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{Binding GameBannerTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding GameBannerDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource Bordered}" Content="{Binding PowerAnywayLabel}" Command="{Binding PowerAnyway}"
                                    Visibility="{Binding ShowPowerAnyway, Converter={StaticResource Visible}}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Plain}" Command="{Binding NotAGame}" VerticalAlignment="Center"
                                    Visibility="{Binding ShowNotAGame, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding NotAGameLabel}" FontSize="11.5" Foreground="{DynamicResource Muted}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Nueva versión -->
            <Border Margin="0,10,0,0" CornerRadius="10" Padding="10" Background="{DynamicResource AccentSoft}"
                    Visibility="{Binding ShowUpdate, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Prominent}" Content="{Binding UpdateLabel}" Command="{Binding InstallUpdate}"
                            IsEnabled="{Binding CanInstallUpdate}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding UpdateIdle, Converter={StaticResource Visible}}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateTitle}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UpdateDetail}" FontSize="11" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Style="{StaticResource Plain}" Foreground="{DynamicResource Secondary}" Content="{Binding UpdateNotesLabel}" Command="{Binding OpenUpdateNotes}" FontSize="11" />
                            <Button Style="{StaticResource Plain}" Foreground="{DynamicResource Secondary}" Content="{Binding UpdateCancelLabel}" Command="{Binding CancelUpdate}" FontSize="11" Margin="10,0,0,0"
                                    Visibility="{Binding CanCancelUpdate, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource Hint}" Foreground="{DynamicResource Warm}" Margin="0,4,0,0"
                                   Visibility="{Binding HasUpdateMessage, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Avisos -->
            <Border Margin="0,10,0,0" CornerRadius="10" Padding="10" Background="{DynamicResource WarmSoft}"
                    Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="13"
                               Foreground="{DynamicResource Warm}" Margin="0,1,8,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding DismissError}" AutomationProperties.Name="{Binding DismissLabel}" VerticalAlignment="Top" Margin="6,2,0,0">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" />
                    </Button>
                    <TextBox Text="{Binding ErrorText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource Fg}" FontSize="11.5" Padding="0" />
                </DockPanel>
            </Border>
            <Border Margin="0,10,0,0" CornerRadius="10" Padding="10" Background="{DynamicResource WarmSoft}"
                    Visibility="{Binding HasHotKeyError, Converter={StaticResource Visible}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="13"
                               Foreground="{DynamicResource Warm}" Margin="0,1,8,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding DismissHotKeyError}" AutomationProperties.Name="{Binding DismissLabel}" VerticalAlignment="Top" Margin="6,2,0,0">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" />
                    </Button>
                    <TextBlock Text="{Binding HotKeyErrorText}" TextWrapping="Wrap" FontSize="11.5" />
                </DockPanel>
            </Border>
            <Border Margin="0,10,0,0" CornerRadius="10" Padding="10" Background="{DynamicResource AccentSoft}"
                    Visibility="{Binding ShowLoginOffer, Converter={StaticResource Visible}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Bordered}" Content="{Binding NoLabel}" Command="{Binding DeclineLogin}" />
                        <Button Style="{StaticResource Prominent}" Content="{Binding YesLabel}" Command="{Binding AcceptLogin}" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding LoginOfferTitle}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LoginOfferDetail}" FontSize="11" Foreground="{DynamicResource Secondary}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Memoria -->
            <Border Style="{StaticResource CardBox}" Margin="0,10,0,0" Visibility="{Binding ShowMemory, Converter={StaticResource Visible}}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{Binding PressureBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PressureText}" Margin="6,0,0,0" FontSize="11" FontWeight="Medium" Foreground="{Binding PressureBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding MemoryTitle}" Style="{StaticResource Eyebrow}" />
                    </DockPanel>

                    <ui:MemoryBar Margin="0,8,0,0" Used="{Binding UsedFraction}" Model="{Binding ModelFraction}" />
                    <TextBlock Text="{Binding CommitPressureHint}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource Warm}" Visibility="{Binding HasCommitPressure, Converter={StaticResource Visible}}" />

                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding UsedLabel}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LegendModel}" Margin="4,0,0,0" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource MutedHalf}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding LegendOther}" Margin="4,0,0,0" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Liberar RAM (lo que hacía Mem Reduct) -->
                    <DockPanel Margin="0,10,0,0" Visibility="{Binding ShowCleanButton, Converter={StaticResource Visible}}">
                        <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource Bordered}" Command="{Binding CleanNow}" AutomationProperties.Name="{Binding CleanLabel}" ToolTip="{Binding CleanHelp}"
                                    Visibility="{Binding CleanIdle, Converter={StaticResource Visible}}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding CleanAndSleepLabel}" Command="{Binding CleanAndSleep}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA99;" FontFamily="{StaticResource Icons}" FontSize="11.5" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CleanLabel}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <ui:Spinner Width="12" Height="12" Visibility="{Binding IsCleaning, Converter={StaticResource Visible}}" />
                        </Grid>
                        <TextBlock Text="{Binding LastCleanText}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- GPU dedicada -->
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowGpu, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding GpuTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                        <ui:MemoryBar Margin="0,6,0,0" Used="{Binding GpuUsedFraction}" Model="{Binding GpuModelFraction}" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GpuUsedLabel}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GpuLegendModel}" Margin="4,0,0,0" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource MutedHalf}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBlock Text="{Binding GpuLegendOther}" Margin="4,0,0,0" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <Rectangle Style="{StaticResource Divider}" Margin="0,8" />

                    <DockPanel Visibility="{Binding HasLoaded, Converter={StaticResource Visible}}">
                        <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button Style="{StaticResource Bordered}" Command="{Binding FreeModel}" AutomationProperties.Name="{Binding FreeLabel}" IsEnabled="{Binding FreeEnabled}"
                                    ToolTip="{Binding FreeHelp}" Visibility="{Binding FreeIdle, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 5.5,0.5 L 10.5,6.5 H 0.5 Z M 0.5,8.5 H 10.5" Stroke="{DynamicResource Fg}" StrokeThickness="1.2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Width="11" Height="9" />
                                    <TextBlock Text="{Binding FreeLabel}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <ui:Spinner Width="12" Height="12" Visibility="{Binding FreeBusy, Converter={StaticResource Visible}}" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding LoadedName}" FontFamily="{StaticResource Mono}" FontSize="12" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding IdleLine}" Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Muted}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding WakeLine}" Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Muted}"
                                       TextTrimming="CharacterEllipsis" Visibility="{Binding HasWakeLine, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding MemoryNote}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                               Visibility="{Binding NoLoaded, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>

            <!-- Otros motores -->
            <ItemsControl ui:ContentView.BreakBefore="True" ItemsSource="{Binding EngineRows}" Focusable="False" Visibility="{Binding HasEngines, Converter={StaticResource Visible}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:EngineRow}">
                        <Border Style="{StaticResource CardBox}" Margin="0,10,0,0" Padding="12,10">
                            <DockPanel>
                                <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding IsOn}" Command="{Binding Toggle}" IsEnabled="{Binding CanToggle}" AutomationProperties.Name="{Binding Name}"
                                                Margin="10,0,0,0" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource Bordered}" Content="{Binding SleepLabel}" Command="{Binding Sleep}"
                                        VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding CanSleep, Converter={StaticResource Visible}}" />
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding Experimental, Converter={StaticResource Visible}}">
                                            <TextBlock Text="{Binding ExperimentalLabel}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource Muted}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding State}" Margin="14,3,0,0" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                               Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Margin="14,1,0,0" FontSize="11" Foreground="{DynamicResource Muted}"
                                               TextTrimming="CharacterEllipsis" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding Error}" Margin="14,3,0,0" FontSize="11" Foreground="{DynamicResource Warm}"
                                               TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Modelos instalados -->
            <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowModels, Converter={StaticResource Visible}}">
                <DockPanel Margin="2,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding ToggleAddModel}" AutomationProperties.Name="{Binding AddModelHelp}" IsEnabled="{Binding CanAddModel}"
                            ToolTip="{Binding AddModelHelp}" VerticalAlignment="Center">
                        <Border Width="22" Height="20" CornerRadius="5" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
                            <TextBlock Text="{Binding AddModelGlyph}" FontFamily="{StaticResource Icons}" FontSize="10.5"
                                       Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                    <TextBlock Text="{Binding ModelsTitle}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Descargar un modelo -->
                <Border Style="{StaticResource CardBox}" Margin="0,0,0,8" Padding="10" Visibility="{Binding AddingModel, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Prominent}" Content="{Binding PullLabel}" Margin="8,0,0,0"
                                    Command="{Binding PullModel}" CommandParameter="{Binding Text, ElementName=PullBox}" />
                            <Grid>
                                <TextBox x:Name="PullBox" Style="{StaticResource Field}" Text="{Binding PullModelName, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding PullModel}" CommandParameter="{Binding Text, ElementName=PullBox}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="{Binding PullPlaceholder}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Muted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PullBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding PullSuggestions}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:Segment}">
                                    <Button Style="{StaticResource Bordered}" Command="{Binding Pick}" Margin="0,0,6,0" Padding="8,2">
                                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Mono}" FontSize="11" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Descarga en curso -->
                <Border Style="{StaticResource CardBox}" Margin="0,0,0,8" Padding="11,10" Visibility="{Binding IsPulling, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Bordered}" Content="{Binding CancelLabel}" Command="{Binding CancelPull}"
                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding PullName}" FontFamily="{StaticResource Mono}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <DockPanel Margin="0,1,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PullPercent}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                                    <TextBlock Text="{Binding PullStatus}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                        <ui:MemoryBar Margin="0,8,0,0" Height="6" Used="{Binding PullFraction}" Model="{Binding PullFraction}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBox}" Visibility="{Binding ModelsEmpty, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding ModelsEmptyText}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                </Border>
                <Border Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius}" Opacity="{Binding ModelsOpacity}"
                        Visibility="{Binding HasModels, Converter={StaticResource Visible}}">
                    <ScrollViewer x:Name="ModelsScroll" MaxHeight="{Binding ModelsMaxHeight}" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="ModelsItems" ItemsSource="{Binding Models}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:ModelRow}">
                                    <StackPanel>
                                        <Rectangle Style="{StaticResource Divider}" Visibility="{Binding ShowDivider, Converter={StaticResource Visible}}" />
                                        <Grid x:Name="row" Background="Transparent" Margin="11,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource Line}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="9,0,4,0">
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="12"
                                                           FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource Chip}" Visibility="{Binding Vision, Converter={StaticResource Visible}}">
                                                        <TextBlock Text="{Binding VisionLabel}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource Muted}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}" Visibility="{Binding Tools, Converter={StaticResource Visible}}">
                                                        <TextBlock Text="{Binding ToolsLabel}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource Muted}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Spinner Width="14" Height="14" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                                                <Button x:Name="star" Style="{StaticResource Plain}" Command="{Binding ToggleMain}" ToolTip="{Binding MainHelp}"
                                                        AutomationProperties.Name="{Binding MainHelp}" VerticalAlignment="Center" Margin="4,0,6,0" Visibility="Collapsed">
                                                    <TextBlock x:Name="starIcon" Text="&#xE734;" FontFamily="{StaticResource Icons}" FontSize="12.5" Foreground="{DynamicResource Muted}" />
                                                </Button>
                                                <Border x:Name="inUse" CornerRadius="9" Padding="7,2,7,3" Background="{DynamicResource OnSoft}" VerticalAlignment="Center"
                                                        Visibility="{Binding IsLoaded, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="{Binding LoadedLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource On}" />
                                                </Border>
                                                <Button x:Name="load" Style="{StaticResource Tinted}" Content="{Binding LoadLabel}" Command="{Binding Load}"
                                                        ToolTip="{Binding LoadHelp}" Visibility="Collapsed" />
                                                <Button x:Name="trash" Style="{StaticResource Bordered}" Command="{Binding AskDelete}" AutomationProperties.Name="{Binding DeleteHelp}" ToolTip="{Binding DeleteHelp}"
                                                        Padding="6,3" Margin="6,0,0,0" Visibility="Collapsed">
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="11.5" Foreground="{DynamicResource Secondary}" />
                                                </Button>
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="{Binding ConfirmText}" FontSize="11" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource DangerButton}" Content="{Binding DeleteLabel}" Command="{Binding ConfirmDelete}" />
                                                    <Button Style="{StaticResource Bordered}" Content="{Binding CancelLabel}" Command="{Binding CancelDelete}" Margin="5,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                            <Setter TargetName="dot" Property="Fill" Value="{DynamicResource On}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMain}" Value="True">
                                            <Setter TargetName="star" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="starIcon" Property="Text" Value="&#xE735;" />
                                            <Setter TargetName="starIcon" Property="Foreground" Value="{DynamicResource Fg}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=row}" Value="True" />
                                                <Condition Binding="{Binding IsIdle}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="star" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsConfirming}" Value="True">
                                            <Setter TargetName="inUse" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="star" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=row}" Value="True" />
                                                <Condition Binding="{Binding CanLoad}" Value="True" />
                                                <Condition Binding="{Binding IsIdle}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="load" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=row}" Value="True" />
                                                <Condition Binding="{Binding CanDelete}" Value="True" />
                                                <Condition Binding="{Binding IsIdle}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="trash" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- MARK: actividad -->
        <StackPanel x:Name="ActivityPanel" Margin="14" Visibility="{Binding ShowingActivityPanel, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding ProcessesTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Fg}" Margin="2,0,2,10"
                       Visibility="{Binding ShowingProcesses, Converter={StaticResource Visible}}" />
            <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding ActivityTabs}" Margin="0,0,0,12" AutomationProperties.Name="{Binding TabsLabel}"
                          Visibility="{Binding ShowingActivity, Converter={StaticResource Visible}}" />
            <StackPanel Visibility="{Binding ShowingActivityMemory, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding WeekTitle}" Style="{StaticResource Eyebrow}" Margin="2,0,2,6" />
            <Border Style="{StaticResource CardBox}" Padding="8,11">
                <ItemsControl ItemsSource="{Binding WeekTiles}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:StatTile}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <DockPanel Margin="2,10,2,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ChartModel}" Margin="4,0,0,0" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource MutedHalf}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding ChartUsed}" Margin="4,0,0,0" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                </StackPanel>
                <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource Eyebrow}" />
            </DockPanel>
            <Border Style="{StaticResource CardBox}" Padding="10">
                <StackPanel>
                    <ui:Sparkline Samples="{Binding Samples}" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChartEnd}" Style="{StaticResource MonoSmall}" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ChartStart}" Style="{StaticResource MonoSmall}" />
                        <TextBlock Text="{Binding ChartTotal}" Style="{StaticResource MonoSmall}" HorizontalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding MemoryNowTitle}" Style="{StaticResource Eyebrow}" Margin="2,10,2,6" />
            <Border Style="{StaticResource CardBox}" Padding="11,9">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding MemoryRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:MemoryRow}">
                                <StackPanel Margin="0,4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource MonoSmall}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <ui:MemoryBar Margin="0,5,0,0" Height="5" Used="{Binding Fraction}" Model="0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MemoryNowHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasGpuRows, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding GpuAdaptersTitle}" Style="{StaticResource Eyebrow}" Margin="2,10,2,6" />
                <Border Style="{StaticResource CardBox}" Padding="11,9">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding GpuRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:GpuRow}">
                                    <StackPanel Margin="0,4" AutomationProperties.Name="{Binding Spoken}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource MonoSmall}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <ui:MemoryBar Margin="0,5,0,0" Height="5" Used="{Binding Fraction}" Model="{Binding ModelFraction}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoSmall}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding GpuAdaptersHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Visibility="{Binding HasCleanObservation, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding CleanObservationTitle}" Style="{StaticResource Eyebrow}" Margin="2,10,2,6" />
                <Border Style="{StaticResource CardBox}" Padding="11,9">
                    <TextBlock Text="{Binding CleanObservationText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowingActivityProcesses, Converter={StaticResource Visible}}">
            <!-- Los procesos, dentro del notch: lo que antes era una ventana aparte. -->
            <TextBlock Text="{Binding ProcessesIntro}" Style="{StaticResource Hint}" Margin="2,0,2,0" />
            <StackPanel x:Name="ProcsRoot" DataContext="{Binding Procs}">
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}"
                            AutomationProperties.Name="{Binding RefreshLabel}" ToolTip="{Binding RefreshLabel}" Margin="6,0,0,0" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12.5" Foreground="{DynamicResource Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding TogglePause}"
                            AutomationProperties.Name="{Binding PauseLabel}" ToolTip="{Binding PauseLabel}" Margin="6,0,0,0" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
                            <TextBlock Text="{Binding PauseGlyph}" FontFamily="{StaticResource Icons}" FontSize="12.5" Foreground="{DynamicResource Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                    <Grid>
                        <TextBox Style="{StaticResource Field}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" Padding="26,4,6,4"
                                 AutomationProperties.Name="{Binding SearchLabel}" ToolTip="{Binding SearchHint}" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="11.5" Foreground="{DynamicResource Muted}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="{Binding SearchHint}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="26,0,8,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding FilterSegments}" Margin="0,8,0,0" AutomationProperties.Name="{Binding FilterLabel}" />
                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding SortSegments}" Margin="0,6,0,0" AutomationProperties.Name="{Binding SortLabel}" />
                <DockPanel Margin="2,7,2,7">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding CycleMinimum}" AutomationProperties.Name="{Binding MinimumLabel}"
                            ToolTip="{Binding MinimumLabel}" Margin="10,0,0,0">
                        <TextBlock Text="{Binding MinimumLabel}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Secondary}" />
                    </Button>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource MonoSmall}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <Border Style="{StaticResource CardBox}" Padding="0">
                    <Border CornerRadius="11" ClipToBounds="True">
                        <Grid>
                            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" MinHeight="150" MaxHeight="230" Padding="2"
                                     Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding ListLabel}" TextElement.Foreground="{DynamicResource Fg}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="True" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="row" Background="Transparent" CornerRadius="7" Padding="6,5">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource Track}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:ProcessRow}">
                                        <Grid Margin="{Binding NameInset}" ToolTip="{Binding Executable}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource Plain}" Visibility="{Binding IsGroup, Converter={StaticResource Visible}}" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ToggleRow, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding DataContext.ToggleLabel, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    ToolTip="{Binding DataContext.ToggleLabel, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                                <TextBlock Text="{Binding Expansion}" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Secondary}"
                                                           HorizontalAlignment="Center" />
                                            </Button>
                                            <Image Grid.Column="1" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" Style="{StaticResource MonoSmall}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <ui:MemoryBar Margin="0,4,0,0" Height="3" Used="{Binding RamFraction}" Model="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="64">
                                                <TextBlock Text="{Binding RamText}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Fg}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding CpuText}" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Hint}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="16" IsHitTestVisible="False" Visibility="{Binding ShowEmpty, Converter={StaticResource Visible}}" />
                        </Grid>
                    </Border>
                </Border>

                <!-- Lo seleccionado y sus acciones; el resultado de la última se queda debajo. -->
                <Border Style="{StaticResource CardBox}" Padding="11,9" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Details}" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource DangerButton}" Content="{Binding ApplicationLabel}" Command="{Binding ActApplication}" IsEnabled="{Binding CanApplication}"
                                    Visibility="{Binding SelectedIsGroup, Converter={StaticResource Visible}}" ToolTip="{Binding ApplicationHelp}" AutomationProperties.Name="{Binding ApplicationLabel}" />
                            <Button Style="{StaticResource DangerButton}" Content="{Binding ProcessLabel}" Command="{Binding ActProcess}" IsEnabled="{Binding CanProcess}"
                                    Visibility="{Binding SelectedIsProcess, Converter={StaticResource Visible}}" ToolTip="{Binding ProcessHelp}" AutomationProperties.Name="{Binding ProcessLabel}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource DangerButton}" Content="{Binding TreeLabel}" Command="{Binding ActTree}" IsEnabled="{Binding CanProcess}"
                                    Visibility="{Binding SelectedIsProcess, Converter={StaticResource Visible}}" ToolTip="{Binding TreeHelp}" AutomationProperties.Name="{Binding TreeLabel}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasResult, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Border>

                <!-- La confirmación, aquí mismo: la lista exacta de lo que se va a cerrar. Hasta aceptarla no se finaliza nada. -->
                <Border Style="{StaticResource CardBox}" Padding="12" Margin="0,8,0,0" IsVisibleChanged="OnConfirmationVisible"
                        Visibility="{Binding HasConfirmation, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource DangerSoft}" VerticalAlignment="Top" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Confirmation.Glyph}" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Danger}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Confirmation.Title}" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Confirmation.Message}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Confirmation.Summary}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" Margin="2,10,2,5" />
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Confirmation.Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:ConfirmRow}">
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Memory}" Style="{StaticResource MonoSmall}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoSmall}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding Confirmation.Warning}" FontSize="11" Foreground="{DynamicResource Warm}" TextWrapping="Wrap" Margin="2,8,2,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Style="{StaticResource Bordered}" Content="{Binding CancelLabel}" Command="{Binding Cancel}" AutomationProperties.Name="{Binding CancelLabel}" Margin="0,0,6,0" MinWidth="88" />
                            <Button Style="{StaticResource DangerButton}" Content="{Binding ConfirmLabel}" Command="{Binding Confirm}" AutomationProperties.Name="{Binding ConfirmLabel}" MinWidth="88" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding RamExplanation}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,8,2,0" />
            </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowingActivityHistory, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding ClientsTitle}" Style="{StaticResource Eyebrow}" Margin="2,0,2,6" />
            <Border Style="{StaticResource CardBox}" Padding="11,9">
                <StackPanel>
                    <TextBlock Text="{Binding ClientsEmpty}" Style="{StaticResource Hint}" Visibility="{Binding NoClients, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding ClientRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:ClientRow}">
                                <StackPanel>
                                    <Rectangle Style="{StaticResource Divider}" Margin="0,7" Visibility="{Binding ShowDivider, Converter={StaticResource Visible}}" />
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Visibility="{Binding HasIcon, Converter={StaticResource Visible}}" />
                                            <Border CornerRadius="5" Background="{DynamicResource Track}" Visibility="{Binding NoIcon, Converter={StaticResource Visible}}">
                                                <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding HistoryTitle}" Style="{StaticResource Eyebrow}" Margin="2,10,2,6" />
            <Border Style="{StaticResource CardBox}" Padding="11,9">
                <StackPanel>
                    <TextBlock Text="{Binding HistoryEmpty}" Style="{StaticResource Hint}" Visibility="{Binding NoHistory, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding HistoryRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:HistoryRow}">
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="11.5" Width="16"
                                               Foreground="{Binding GlyphBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontSize="10.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </StackPanel>

        <!-- MARK: ajustes -->
        <StackPanel x:Name="SettingsPanel" Margin="14" Visibility="{Binding ShowingSettings, Converter={StaticResource Visible}}">
            <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="0" ItemsSource="{Binding SettingsNav}" Focusable="False" Margin="0,0,14,0" VerticalAlignment="Top"
                          KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="{Binding TabsLabel}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type ui:SettingsNavItem}">
                  <Button Command="{Binding Pick}" Style="{StaticResource Plain}" Margin="0,0,0,2"
                          AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
                    <Border x:Name="nav" CornerRadius="9" Padding="6,5">
                    <StackPanel Orientation="Horizontal">
                      <Border Width="24" Height="24" CornerRadius="7" Background="{Binding Tint}">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding Title}" Margin="9,0,6,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Fg}"
                                 Visibility="{Binding ShowLabel, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    </Border>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter TargetName="nav" Property="Background" Value="{DynamicResource CardFill}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- La barra de pestañas de la izquierda queda fija: solo se desplaza el contenido de la página elegida -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="{Binding SettingsBodyMax}">
            <StackPanel>
            <TextBlock Text="{Binding SettingsPageTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Fg}" Margin="2,0,2,10" />
            <StackPanel Visibility="{Binding ShowingSettingsOllama, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal" Margin="2,0,2,6">
                <TextBlock Text="Ollama" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding OllamaSectionDetail}" Style="{StaticResource MonoSmall}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <TextBlock Text="{Binding IdleTitle}" Style="{StaticResource Label}" />
                    <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding IdleSegments}" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding IdleHint}" Style="{StaticResource Hint}" Margin="0,7,0,0" />
                    <StackPanel Visibility="{Binding ShowMechanisms, Converter={StaticResource Visible}}">
                        <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                        <TextBlock Text="{Binding MechanismTitle}" Style="{StaticResource Label}" />
                        <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding MechanismSegments}" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding MechanismHint}" Style="{StaticResource Hint}" Margin="0,7,0,0" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                    <DockPanel>
                        <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding WatchdogOn}" Command="{Binding ToggleWatchdog}" AutomationProperties.Name="{Binding WatchdogTitle}" Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding WatchdogTitle}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding WatchdogDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding AutomaticTitle}" Style="{StaticResource Eyebrow}" Margin="2,10,2,6" />
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <DockPanel>
                        <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding GameModeOn}" Command="{Binding ToggleGameMode}" AutomationProperties.Name="{Binding GameModeTitle}" Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding GameModeTitle}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding GameModeDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Visibility="{Binding GameModeOn, Converter={StaticResource Visible}}">
                        <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                        <DockPanel>
                            <ui:BrandSwitch DockPanel.Dock="Right" IsOn="{Binding GameRestoreOn}" Command="{Binding ToggleGameRestore}" AutomationProperties.Name="{Binding GameRestoreTitle}" Margin="10,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding GameRestoreTitle}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding GameRestoreDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Bordered}" Content="{Binding AddGameLabel}" Command="{Binding AddGame}" />
                            <TextBlock Text="{Binding GamesTitle}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding GameRows}" Focusable="False" Margin="0,6,0,0"
                                      Visibility="{Binding HasGameRows, Converter={StaticResource Visible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:GameRow}">
                                    <DockPanel Margin="0,3" ToolTip="{Binding Path}">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding Remove}" AutomationProperties.Name="{Binding RemoveHelp}" ToolTip="{Binding RemoveHelp}"
                                                VerticalAlignment="Center" Margin="8,0,2,0">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" />
