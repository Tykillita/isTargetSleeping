                                    <DockPanel Margin="0,3" ToolTip="{Binding Path}">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Command="{Binding Remove}" ToolTip="{Binding RemoveHelp}"
                                                VerticalAlignment="Center" Margin="8,0,2,0">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" />
                                        </Button>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Secondary}" />
                                            <Border Style="{StaticResource Chip}" Visibility="{Binding HasTag, Converter={StaticResource Visible}}">
                                                <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource Muted}" />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
