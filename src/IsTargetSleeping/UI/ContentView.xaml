                                        Visibility="{Binding ShowRemoveAgent, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding RemoveAgentLabel}" FontSize="11" Foreground="{DynamicResource Muted}" />
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding AgentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AgentTitle}" Style="{StaticResource Label}" Margin="7,0,0,0" />
