                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:StatTile}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <DockPanel Margin="2,10,2,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ChartModel}" Margin="4,0,0,0" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource MutedHalf}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding ChartUsed}" Margin="4,0,0,0" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource Secondary}" />
                </StackPanel>
                <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource Eyebrow}" />
            </DockPanel>
            <Border Style="{StaticResource CardBox}" Padding="10">
                <StackPanel>
                    <ui:Sparkline Samples="{Binding Samples}" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChartEnd}" Style="{StaticResource MonoSmall}" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ChartStart}" Style="{StaticResource MonoSmall}" />
                        <TextBlock Text="{Binding ChartTotal}" Style="{StaticResource MonoSmall}" HorizontalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding MemoryNowTitle}" Style="{StaticResource Eyebrow}" Margin="2,10,2,6" />
            <Border Style="{StaticResource CardBox}" Padding="11,9">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding MemoryRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:MemoryRow}">
                                <StackPanel Margin="0,4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource MonoSmall}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <ui:MemoryBar Margin="0,5,0,0" Height="5" Used="{Binding Fraction}" Model="0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MemoryNowHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ProcessesTitle}" Style="{StaticResource Eyebrow}" Margin="2,10,2,6" />
            <Border Style="{StaticResource CardBox}" Padding="11,9">
                <StackPanel>
                    <TextBlock Text="{Binding ProcessesHint}" Style="{StaticResource Hint}" />
