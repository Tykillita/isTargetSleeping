<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- DXGI se llama por su tabla de métodos COM (punteros a función), sin interop generado. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>isTargetSleeping</AssemblyName>
    <RootNamespace>IsTargetSleeping</RootNamespace>
    <StartupObject>IsTargetSleeping.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('..\..\Assets\isTargetSleeping.ico')">..\..\Assets\isTargetSleeping.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</Version>
    <AgentVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\AGENT_VERSION').Trim())</AgentVersion>
    <Product>isTargetSleeping</Product>
    <Company>CodeSentry - Tykillita</Company>
    <Authors>Ruben Pino (Tykillita), CodeSentry</Authors>
    <Copyright>Copyright (c) 2026 CodeSentry - Tykillita (Ruben Pino)</Copyright>
    <Description>Watches your local models and puts them to sleep when they're idle.</Description>
    <!-- Publicación: un solo .exe que no necesita instalar .NET. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Assets\istargetsleeping-master.png" LogicalName="IsTargetSleeping.BrandLogo.png" />
    <!-- El editor de texto del widget Código (colorea el texto por lenguaje). MIT: ver THIRD-PARTY-NOTICES.md. -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AgentVersion" Value="$(AgentVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Flags\*.png" />
    <Resource Include="Resources\WidgetLogos\*.png" />
    <Resource Include="Resources\FolderLogos\*.png" />
    <Resource Include="Resources\music-demo-cover.jpg" />
    <EmbeddedResource Include="Resources\music-new-orleans-jazz.wav" LogicalName="IsTargetSleeping.Resources.music-new-orleans-jazz.wav" WithCulture="false" />
    <EmbeddedResource Include="Resources\Strings.en.json" LogicalName="IsTargetSleeping.Strings.en.json" WithCulture="false" />
    <EmbeddedResource Include="Resources\FileIcons.json.gz" LogicalName="IsTargetSleeping.FileIcons.json.gz" WithCulture="false" />
    <!-- El agente de memoria (src/IsTargetSleeping.Agent), publicado antes por build.ps1. -->
    <EmbeddedResource Include="$(AgentExe)" LogicalName="IsTargetSleeping.MemoryAgent.exe" WithCulture="false"
                      Condition="'$(AgentExe)' != '' and Exists('$(AgentExe)')" />
  </ItemGroup>
  <!-- Regla: toda build publicada lleva el agente de memoria dentro; sin él «Liberar RAM» falla en silencio. Si falta, la publicación se detiene. -->
  <Target Name="RequireMemoryAgent" BeforeTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <Error Condition="'$(AgentExe)' == '' or !Exists('$(AgentExe)')" Text="Falta el agente de memoria (AgentExe): toda build publicada debe incluirlo. Usa ./build.ps1 o package.ps1." />
  </Target>

</Project>
